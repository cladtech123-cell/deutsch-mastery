  "grammar": [
    {
      "topic_id": "g-perfekt-aux",
      "rule": "Harakat (A → B), holat o'zgarishi va \"sein, bleiben, passieren\" fe'llari Perfektni \"sein\" bilan yasaydi. Qolgan ko'pchilik fe'llar — \"haben\" bilan.",
      "when": "Qayerga borganingiz, qachon uyg'onganingiz, nima sodir bo'lganini aytganda.",
      "structure": "Subyekt + bin/bist/ist/sind/seid + ... + Partizip II.  Masalan: Wir sind nach Samarkand gefahren.",
      "examples": [
        {
          "de": "Ich bin letzte Woche nach Berlin geflogen.",
          "uz": "O'tgan hafta Berlinga uchib bordim."
        },
        {
          "de": "Bist du heute zu Fuß gekommen?",
          "uz": "Bugun piyoda keldingmi?"
        },
        {
          "de": "Das Baby ist um acht Uhr eingeschlafen.",
          "uz": "Chaqaloq soat sakkizda uxlab qoldi."
        },
        {
          "de": "Gestern ist ein Unfall passiert.",
          "uz": "Kecha avariya sodir bo'ldi."
        },
        {
          "de": "Wir sind am Wochenende zu Hause geblieben.",
          "uz": "Dam olish kunlari uyda qoldik."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich habe nach Taschkent geflogen.",
          "right": "Ich bin nach Taschkent geflogen.",
          "why": "\"fliegen\" — joydan joyga harakat, shuning uchun \"sein\"."
        },
        {
          "wrong": "Was hat passiert?",
          "right": "Was ist passiert?",
          "why": "\"passieren\" doim \"sein\" bilan ishlatiladi."
        },
        {
          "wrong": "Ich habe zu Hause geblieben.",
          "right": "Ich bin zu Hause geblieben.",
          "why": "\"bleiben\" harakatni bildirmasa ham — \"sein\" bilan. Buni yodlab olish kerak."
        }
      ],
      "check": [
        "a2-m13-l2-e01",
        "a2-m13-l2-e02",
        "a2-m13-l2-e04",
        "a2-m13-l2-e09"
      ]
    }
  ],
