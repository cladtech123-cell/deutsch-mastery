  "grammar": [
    {
      "topic_id": "g-place-prepositions",
      "rule": "in, an, auf, über, unter, neben, vor, hinter, zwischen — \"Wo?\" (qayerda?) savoliga javob berganda Dativ bilan ishlatiladi: dem / der / dem / den(+n).",
      "when": "Uyda, ko'chada narsalar va odamlar qayerda ekanini aytganda.",
      "structure": "Ega + steht/liegt/hängt/ist + predlog + Dativ.  Masalan: Der Schlüssel liegt auf dem Regal.",
      "examples": [
        {
          "de": "Der Schlüssel liegt auf dem Regal.",
          "uz": "Kalit javon ustida yotibdi."
        },
        {
          "de": "Die Mülltonnen stehen im Hof hinter dem Haus.",
          "uz": "Chiqindi qutilari uy orqasidagi hovlida turibdi."
        },
        {
          "de": "Das Bild hängt an der Wand über dem Sofa.",
          "uz": "Rasm divan ustidagi devorda osilgan."
        },
        {
          "de": "Die Steckdose ist neben der Tür.",
          "uz": "Rozetka eshik yonida."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Der Schlüssel liegt auf der Tisch.",
          "right": "Der Schlüssel liegt auf dem Tisch.",
          "why": "\"Wo?\" — Dativ: der Tisch → dem Tisch."
        },
        {
          "wrong": "Das Fahrrad steht in dem Keller.",
          "right": "Das Fahrrad steht im Keller.",
          "why": "in + dem odatda qisqartiriladi: im."
        },
        {
          "wrong": "Das Bild hängt an die Wand.",
          "right": "Das Bild hängt an der Wand.",
          "why": "Rasm qayerda osilgan? (Wo?) — Dativ: an der Wand."
        }
      ],
