  "situation": {
    "title": "Telefonda qabul vaqtini kelishish",
    "context_uz": "Siz Bürgeramtga (shahar idorasiga) telefon qilib, qabul vaqtini olmoqchisiz. Siz faqat ertalab bo'shsiz.",
    "lines": [
      {
        "speaker": "Bürgeramt",
        "de": "Wann haben Sie Zeit?",
        "uz": "Qachon vaqtingiz bor?"
      },
      {
        "speaker": "Siz",
        "de": "Am Vormittag, bitte. Am Nachmittag arbeite ich.",
        "uz": "Tushgacha, iltimos. Tushdan keyin ishlayman."
      },
      {
        "speaker": "Bürgeramt",
        "de": "Am Freitag um zehn vor neun?",
        "uz": "Juma kuni to'qqizga o'n daqiqa qolganda?"
      },
      {
        "speaker": "Siz",
        "de": "Wie bitte? Um acht Uhr fünfzig?",
        "uz": "Nima dedingiz? Soat sakkiz ellikdami?"
      },
      {
        "speaker": "Bürgeramt",
        "de": "Genau. Bitte seien Sie pünktlich!",
        "uz": "Xuddi shunday. Iltimos, o'z vaqtida keling!"
      }
    ],
    "task_uz": "Dialogni o'qing, keyin boshqa kun va vaqt bilan takrorlang. Vaqtni tushunmasangiz, rasmiy shaklda qayta so'rab tekshiring (Um acht Uhr fünfzig?)."
  },
