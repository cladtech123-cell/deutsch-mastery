  "grammar": [
    {
      "topic_id": "g-time-prepositions",
      "rule": "Hafta kunlari va kunning qismlari bilan \"am\" (an + dem) ishlatiladi: am Montag, am Abend, am Wochenende. Istisno: in der Nacht.",
      "when": "Biror ish qaysi kunda yoki kunning qaysi qismida bo'lishini aytganda.",
      "structure": "am + kun / kun qismi:  Am Montag arbeite ich.  |  in der Nacht",
      "examples": [
        {
          "de": "Am Montag arbeite ich im Büro.",
          "uz": "Dushanba kuni ofisda ishlayman."
        },
        {
          "de": "Am Abend lese ich ein Buch.",
          "uz": "Kechqurun kitob o'qiyman."
        },
        {
          "de": "Am Wochenende habe ich Zeit.",
          "uz": "Dam olish kunlari vaqtim bor."
        },
        {
          "de": "In der Nacht schlafe ich.",
          "uz": "Tunda uxlayman."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "in Montag",
          "right": "am Montag",
          "why": "Rus tilidagi \"в\" ga qarab in qo'yilmaydi: kunlar bilan doim am."
        },
        {
          "wrong": "am Nacht",
          "right": "in der Nacht",
          "why": "Nacht — istisno: in der Nacht."
        },
        {
          "wrong": "Am Montag ich arbeite.",
          "right": "Am Montag arbeite ich.",
          "why": "Gap vaqt bilan boshlansa, fe'l ikkinchi o'rinda, ega undan keyin."
        }
      ],
      "check": [
        "a1-m06-l1-e02",
        "a1-m06-l1-e03",
        "a1-m06-l1-e06",
        "a1-m06-l1-e07",
        "a1-m06-l1-e09"
      ]
    }
  ],
