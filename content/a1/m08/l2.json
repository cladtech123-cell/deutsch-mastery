  "grammar": [
    {
      "topic_id": "g-negation",
      "rule": "kein/keine — otni inkor qiladi (\"ein/eine\" o'rniga yoki artiklsiz ot oldida). nicht — fe'l, sifat, aniq artiklli ot yoki butun gapni inkor qiladi.",
      "when": "Biror narsa yo'qligini (Ich habe keine Tasche) yoki biror belgi to'g'ri emasligini (Die Hose ist nicht teuer) aytganda.",
      "structure": "ein/eine/— + ot → kein/keine + ot: Das ist kein Rock.\nist + nicht + sifat: Die Jacke ist nicht teuer.\nfe'l ... + nicht (oxirida): Die Hose passt nicht.",
      "examples": [
        {
          "de": "Das ist kein Kleid, das ist ein Rock.",
          "uz": "Bu ko'ylak emas, bu yubka."
        },
        {
          "de": "Ich habe keine Tasche.",
          "uz": "Mening sumkam yo'q."
        },
        {
          "de": "Der Pullover ist nicht teuer.",
          "uz": "Sviter qimmat emas."
        },
        {
          "de": "Die Hose passt nicht.",
          "uz": "Shim to'g'ri kelmaydi."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich habe nicht Tasche.",
          "right": "Ich habe keine Tasche.",
          "why": "Artiklsiz yoki ein/eine bilan keladigan ot \"kein\" bilan inkor qilinadi."
        },
        {
          "wrong": "Die Jacke ist kein teuer.",
          "right": "Die Jacke ist nicht teuer.",
          "why": "Sifat (teuer) \"nicht\" bilan inkor qilinadi, \"kein\" faqat ot oldida keladi."
        },
        {
          "wrong": "Das ist nicht ein Hemd.",
          "right": "Das ist kein Hemd.",
          "why": "\"nicht ein\" deyilmaydi — uning o'rniga bitta so'z: kein."
        }
      ],
      "check": [
        "a1-m08-l2-e03",
        "a1-m08-l2-e04",
        "a1-m08-l2-e05",
        "a1-m08-l2-e06"
      ]
    }
  ],
  "listening": {
    "title": "Kiyim do'konida",
    "lines": [
      {
        "speaker": "Nilufar",
        "de": "Schau mal, das Kleid! Wie findest du es?",
        "uz": "Qara, mana bu ko'ylak! Senga qanday ko'rinyapti?"
      },
      {
        "speaker": "Clara",
        "de": "Das Kleid ist schön, aber es ist nicht billig. 89 Euro!",
        "uz": "Ko'ylak chiroyli, lekin arzon emas. 89 evro!"
      },
      {
        "speaker": "Nilufar",
        "de": "Und der Rock hier? Er kostet nur 25 Euro.",
        "uz": "Bu yubka-chi? U atigi 25 evro."
      },
      {
        "speaker": "Clara",
        "de": "Der Rock ist toll. Ich möchte den Rock anprobieren.",
        "uz": "Yubka zo'r. Uni kiyib ko'rmoqchiman."
      },
      {
        "speaker": "Clara",
        "de": "Hm, der Rock passt nicht. Er ist zu klein.",
        "uz": "Hm, yubka to'g'ri kelmayapti. U juda kichik."
      },
      {
        "speaker": "Nilufar",
        "de": "Schade! Hier ist der Rock in Größe 40.",
        "uz": "Attang! Mana, 40-o'lchamdagisi."
      }
    ],
    "questions": [
      "a1-m08-l2-e08",
      "a1-m08-l2-e09"
    ]
  },
  "situation": {
    "title": "Safarga tayyorgarlik",
    "context_uz": "Siz Germaniyaga o'qishga ketyapsiz. Onangiz (nemis tilini mashq qilish uchun nemischa gapiryapti) kiyimlaringizni tekshiryapti.",
    "lines": [
      {
        "speaker": "Mama",
        "de": "Hast du eine Jacke für Berlin?",
        "uz": "Berlin uchun kurtkang bormi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, ich habe eine Jacke. Aber ich habe keinen Pullover.",
        "uz": "Ha, kurtkam bor. Lekin sviterim yo'q."
      },
      {
        "speaker": "Mama",
        "de": "Und Schuhe?",
        "uz": "Poyabzal-chi?"
      },
      {
        "speaker": "Siz",
        "de": "Meine Schuhe sind alt. Sie passen nicht gut.",
        "uz": "Poyabzalim eski. Ular yaxshi to'g'ri kelmaydi."
      },
      {
        "speaker": "Mama",
        "de": "Dann kaufen wir heute Schuhe und einen Pullover.",
        "uz": "Unda bugun poyabzal va sviter sotib olamiz."
      },
      {
        "speaker": "Siz",
        "de": "Super, danke!",
        "uz": "Zo'r, rahmat!"
      }
    ],
    "task_uz": "Kiyimlaringizni tekshiring va 3 ta gap ayting: nima bor (Ich habe ...), nima yo'q (Ich habe keinen/keine/kein ...) va nima mos emas (... passt nicht / ... ist nicht ...)."
  },
