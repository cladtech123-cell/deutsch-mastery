  "situation": {
    "title": "Boshliqqa qo'ng'iroq",
    "context_uz": "Siz shifokordan qaytdingiz va boshlig'ingiz Herr Braunga qo'ng'iroq qilib, shifokor nima deganini aytyapsiz.",
    "lines": [
      {
        "speaker": "Herr Braun",
        "de": "Braun. Hallo?",
        "uz": "Braun. Allo?"
      },
      {
        "speaker": "Siz",
        "de": "Guten Morgen, Herr Braun, hier ist Nodir. Ich war beim Arzt. Ich habe eine Grippe.",
        "uz": "Xayrli tong, Braun janoblari, bu Nodir. Shifokorda bo'ldim. Menda gripp."
      },
      {
        "speaker": "Herr Braun",
        "de": "Oh, das tut mir leid. Wie lange sind Sie krank?",
        "uz": "Voy, afsus. Qancha vaqt kasal bo'lasiz?"
      },
      {
        "speaker": "Siz",
        "de": "Der Arzt hat mich bis Freitag krankgeschrieben. Ich soll im Bett bleiben.",
        "uz": "Shifokor menga jumagacha kasallik varaqasi berdi. To'shakda yotishim kerak."
      },
      {
        "speaker": "Herr Braun",
        "de": "Gut. Schicken Sie mir bitte die Krankschreibung. Gute Besserung!",
        "uz": "Yaxshi. Kasallik varaqasini menga yuboring. Tezroq tuzaling!"
      },
      {
        "speaker": "Siz",
        "de": "Danke, mache ich.",
        "uz": "Rahmat, yuboraman."
      }
    ],
    "task_uz": "Boshliq yoki o'qituvchingizga qo'ng'iroqni o'ynang: kasalligingiz, shifokor nima dedi (Ich soll ..., Ich darf nicht ...) va qachongacha kasallik varaqangiz bor."
  },
