      {
        "speaker": "Siz",
        "de": "Ich bin Fahrer. Jetzt arbeite ich als Taxifahrer.",
        "uz": "Men haydovchiman. Hozir taksi haydovchisi bo'lib ishlayman."
      },
      {
        "speaker": "Frau Schulz",
        "de": "Und wo arbeiten Sie?",
        "uz": "Qayerda ishlaysiz?"
      },
      {
        "speaker": "Siz",
        "de": "In Köln, bei City-Taxi.",
        "uz": "Kyolnda, City-Taxi firmasida."
      },
      {
        "speaker": "Frau Schulz",
        "de": "Sehr gut. Wir suchen Fahrer!",
        "uz": "Juda yaxshi. Bizga haydovchilar kerak!"
      }
    ],
    "task_uz": "Frau Schulzning savollariga o'z kasbingiz (yoki orzu qilgan kasbingiz) bilan javob bering: Ich bin ... / Ich arbeite als ... / Ich arbeite in ..."
  },
