  "rule": "in, an, auf, unter, über, vor, hinter, neben, zwischen predloglari ikki kelishik bilan keladi: Wo? (qayerda — joy) → Dativ, Wohin? (qayerga — harakat) → Akkusativ.",
  "when": "Uy, xona, shahar haqida, narsalar qayerda turgani yoki qayerga qo'yilgani haqida gapirganda.",
  "structure": "Wo? + liegen/stehen/hängen/sein + predlog + Dativ | Wohin? + legen/stellen/hängen/gehen + predlog + Akkusativ",
  "explanation": [
    {
      "type": "table",
      "headers": [
        "Predlog",
        "Ma'nosi",
        "Wo? + Dativ",
        "Wohin? + Akkusativ"
      ],
      "rows": [
        [
          "in",
          "ichida / ichiga",
          "Ich bin im Zimmer.",
          "Ich gehe ins Zimmer."
        ],
        [
          "auf",
          "ustida (yotiq sirt)",
          "Das Buch liegt auf dem Tisch.",
          "Ich lege das Buch auf den Tisch."
        ],
        [
          "an",
          "yonida, devorda (tik sirt)",
          "Das Bild hängt an der Wand.",
          "Ich hänge das Bild an die Wand."
        ],
        [
          "unter",
          "tagida",
          "Die Katze ist unter dem Bett.",
          "Die Katze läuft unter das Bett."
        ],
        [
          "neben",
          "yonida",
          "Der Stuhl steht neben dem Schrank.",
          "Ich stelle den Stuhl neben den Schrank."
        ],
        [
          "vor / hinter",
          "oldida / orqasida",
          "Das Auto steht vor dem Haus.",
          "Ich fahre das Auto hinter das Haus."
        ],
        [
          "über / zwischen",
          "tepasida / orasida",
          "Die Lampe hängt über dem Tisch.",
          "Ich stelle die Vase zwischen die Bücher."
        ]
      ]
    },
    {
      "type": "table",
      "headers": [
        "Wo? (holat)",
        "Wohin? (harakat)"
      ],
      "rows": [
        [
          "liegen — yotmoq",
          "legen — yotqizib qo'ymoq"
        ],
        [
          "stehen — turmoq",
          "stellen — tik qo'ymoq"
        ],
        [
          "hängen — osilib turmoq",
          "hängen — osmoq"
        ],
        [
          "sein, wohnen, arbeiten",
          "gehen, fahren, kommen"
        ]
      ]
    },
    {
      "type": "p",
      "text": "Odam va muassasaga: zu + Dativ (zum Arzt, zur Bank). Shahar va mamlakatga: nach (nach Berlin), uyga: nach Hause, uyda: zu Hause."
    },
    {
      "type": "tip",
      "text": "Qisqartmalar: in dem = im, in das = ins, an dem = am, an das = ans."
    }
  ],
  "examples": [
    {
      "de": "Das Handy liegt auf dem Tisch.",
      "uz": "Telefon stol ustida yotibdi."
    },
    {
      "de": "Ich lege das Handy auf den Tisch.",
      "uz": "Telefonni stol ustiga qo'yaman."
    },
    {
