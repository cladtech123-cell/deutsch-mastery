  "grammar": [
    {
      "topic_id": "g-articles",
      "rule": "Har bir nemis otining jinsi bor: der (erkak), die (ayol), das (o'rta). Ko'plikda doim die. Noaniq artikl: ein (der va das otlar uchun), eine (die otlar uchun).",
      "when": "ein/eine — birinchi marta yoki \"bitta, qandaydir\" ma'nosida; der/die/das — ma'lum, avval aytilgan yoki yagona narsa haqida.",
      "structure": "Das ist + ein/eine + ot.  →  Der/Die/Das + ot + fe'l ...",
      "examples": [
        {
          "de": "Das ist ein Kind. Das Kind heißt Ali.",
          "uz": "Bu bola. Bolaning ismi Ali."
        },
        {
          "de": "Das ist eine Frau. Die Frau ist Lehrerin.",
          "uz": "Bu ayol. Ayol o'qituvchi."
        },
        {
          "de": "Der Vater kommt aus Fergana.",
          "uz": "Ota Farg'onadan."
        },
        {
          "de": "Die Eltern wohnen in Samarkand.",
          "uz": "Ota-ona Samarqandda yashaydi."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Das ist eine Kind.",
          "right": "Das ist ein Kind.",
          "why": "Kind — o'rta jins (das), shuning uchun ein, eine emas."
        },
        {
          "wrong": "Die Mädchen heißt Lola.",
          "right": "Das Mädchen heißt Lola.",
          "why": "Mädchen — grammatik jihatdan o'rta jins: das Mädchen."
        },
        {
          "wrong": "Vater wohnt in Taschkent.",
          "right": "Der Vater wohnt in Taschkent.",
          "why": "O'zbek tilida artikl yo'q, nemis tilida esa ot oldida odatda artikl turadi."
        },
        {
          "wrong": "ein Eltern",
          "right": "die Eltern",
          "why": "Eltern faqat ko'plikda ishlatiladi; ko'plikda noaniq artikl bo'lmaydi."
        }
      ],
      "check": [
        "a1-m04-l1-e07",
        "a1-m04-l1-e08",
        "a1-m04-l1-e09"
      ]
    }
  ],
  "listening": {
    "title": "Oilaviy surat",
    "lines": [
      {
        "speaker": "Lola",
        "de": "Schau mal, das ist die Familie Karimov.",
        "uz": "Qara, bu Karimovlar oilasi."
      },
      {
        "speaker": "Ben",
        "de": "Wer ist der Mann?",
        "uz": "Anavi erkak kim?"
      },
      {
        "speaker": "Lola",
        "de": "Das ist der Vater, er heißt Bahodir. Und das ist die Mutter, Gulnora.",
        "uz": "Bu ota, uning ismi Bahodir. Bu esa ona, Gulnora."
      },
      {
        "speaker": "Ben",
        "de": "Und das Kind?",
        "uz": "Bola-chi?"
      },
      {
        "speaker": "Lola",
        "de": "Das ist ein Baby. Das ist Ali, der Sohn.",
        "uz": "Bu chaqaloq. Bu Ali, ularning o'g'li."
      },
      {
        "speaker": "Ben",
        "de": "Und die Frau hier?",
        "uz": "Mana bu ayol-chi?"
      },
      {
        "speaker": "Lola",
        "de": "Das ist die Oma. Sie ist sehr nett.",
        "uz": "Bu buvi. U juda mehribon."
      }
    ],
    "questions": [
      "a1-m04-l1-e05",
      "a1-m04-l1-e06"
    ]
  },
  "situation": {
    "title": "Bolalar bog'chasida",
    "context_uz": "Siz farzandingizni bog'chadan olib ketyapsiz. Tarbiyachi siz bilan kelgan odamlarni tanimayapti.",
    "lines": [
      {
        "speaker": "Erzieherin",
        "de": "Guten Tag! Wer ist das?",
        "uz": "Assalomu alaykum! Bu kim?"
      },
      {
        "speaker": "Siz",
        "de": "Das ist die Oma von Ali. Sie heißt Saodat.",
        "uz": "Bu Alining buvisi. Uning ismi Saodat."
      },
      {
        "speaker": "Erzieherin",
        "de": "Und der Mann?",
        "uz": "Erkak-chi?"
      },
      {
        "speaker": "Siz",
        "de": "Das ist der Opa. Er wohnt auch hier in Köln.",
        "uz": "Bu bobosi. U ham shu yerda, Kyolnda yashaydi."
      },
      {
        "speaker": "Erzieherin",
        "de": "Danke! Tschüs, Ali!",
        "uz": "Rahmat! Xayr, Ali!"
      }
    ],
    "task_uz": "Dialogni o'qing, keyin o'z oilangizdagi ikki kishini xuddi shu tarzda tanishtiring: Das ist der/die ... Er/Sie heißt ..."
  },
