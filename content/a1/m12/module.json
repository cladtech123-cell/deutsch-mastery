  "writing_task": {
    "id": "w-a1-m12",
    "title": "O'qituvchiga xabar: kasalman",
    "task_uz": "Nemis tili o'qituvchingizga email yozing: bugun darsga kela olmaysiz, chunki kasalsiz (qayeringiz og'riyapti, isitma bormi); bugun nima qilasiz (shifokor, dorixona); qachon yana kelasiz; uy vazifasini so'rang.",
    "required_words": [
      "krank",
      "leider"
    ],
    "min_words": 40,
    "max_words": 90,
    "criteria": [
      "Rasmiy murojaat (Liebe Frau ... / Lieber Herr ...) va xayrlashish",
      "Kasallik: kamida 2 ta shikoyat (Mein ... tut weh / Ich habe ...)",
      "Modal fe'l to'g'ri: Ich kann heute nicht ... kommen (infinitiv oxirida)",
      "Vaqt ifodasi bilan gapda fe'l 2-o'rinda (Am Donnerstag komme ich ...)",
      "Kamida bitta savol (Was sind die Hausaufgaben?)",
      "Imlo: otlar katta harf bilan"
    ],
    "sample_answer": "Liebe Frau Schneider, leider kann ich heute nicht zum Deutschkurs kommen. Ich bin krank. Ich habe Fieber und mein Hals tut weh. Um elf Uhr habe ich einen Termin beim Arzt. Dann gehe ich in die Apotheke. Am Donnerstag komme ich wieder. Was sind die Hausaufgaben für Donnerstag? Viele Grüße, Malika Usmonova"
  }
