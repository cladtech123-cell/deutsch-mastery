  "grammar": [
    {
      "topic_id": "g-alphabet",
      "rule": "ä, ö, ü — alohida unlilar; ular so'z ma'nosini va ko'plik shaklini o'zgartiradi (Buch → Bücher). ß uzun unli yoki ei/au dan keyin yoziladi, qisqa unlidan keyin esa ss: Straße, heißen — lekin Wasser.",
      "when": "So'zni eshitib yozganda, talaffuz qilganda va o'xshash so'zlarni (schon/schön) farqlaganda.",
      "structure": "uzun unli / ei / au + ß: Straße, heißen  |  qisqa unli + ss: Wasser  |  sp-, st- (so'z boshida) = \"shp\", \"sht\"",
      "examples": [
        {
          "de": "Die Straße ist schön.",
          "uz": "Ko'cha chiroyli."
        },
        {
          "de": "Das Mädchen spielt heute.",
          "uz": "Qiz bugun o'ynayapti."
        },
        {
          "de": "Ich spreche nicht schnell.",
          "uz": "Men tez gapirmayman."
        },
        {
          "de": "Das Buch ist neu, die Bücher sind alt.",
          "uz": "Kitob yangi, kitoblar esa eski."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Strase",
          "right": "Straße",
          "why": "Uzun \"a\" dan keyin jarangsiz \"s\" — ß bilan yoziladi. Bitta s unlilar orasida jarangli \"z\" kabi o'qiladi."
        },
        {
          "wrong": "sprechen → [s-prexen]",
          "right": "sprechen → [shprexen]",
          "why": "So'z boshida sp va st — \"shp\" va \"sht\" deb o'qiladi."
        },
        {
          "wrong": "Ei → [ey]",
          "right": "Ei → [ay]",
          "why": "ei birikmasi doim \"ay\" deb o'qiladi: Ei, nein, heißen."
        },
        {
          "wrong": "Das ist schon. (chiroyli ma'nosida)",
          "right": "Das ist schön.",
          "why": "Umlautni tashlab ketish ma'noni o'zgartiradi: schon — allaqachon, schön — chiroyli."
        }
      ],
      "check": [
        "a1-m01-l3-e01",
        "a1-m01-l3-e05",
        "a1-m01-l3-e06"
      ]
    }
  ],
  "listening": {
    "title": "Talaffuz darsi",
    "lines": [
      {
        "speaker": "Frau Schmidt",
        "de": "Guten Morgen! Heute sprechen wir: ä, ö, ü.",
        "uz": "Xayrli tong! Bugun talaffuz qilamiz: ä, ö, ü."
      },
      {
        "speaker": "Aziz",
        "de": "Wie bitte? Langsam, bitte!",
        "uz": "Nima dedingiz? Sekinroq, iltimos!"
      },
      {
        "speaker": "Frau Schmidt",
        "de": "Ä wie Mädchen, Ö wie schön, Ü wie Tür.",
        "uz": "Ä — Mädchen dagi kabi, Ö — schön dagi kabi, Ü — Tür dagi kabi."
      },
      {
        "speaker": "Aziz",
        "de": "Und ß?",
        "uz": "ß-chi?"
      },
      {
        "speaker": "Frau Schmidt",
        "de": "ß wie Straße. Schreiben Sie: S – T – R – A – ß – E.",
        "uz": "ß — Straße dagi kabi. Yozing: S – T – R – A – ß – E."
      },
      {
        "speaker": "Aziz",
        "de": "Danke! Das ist schön.",
        "uz": "Rahmat! Bu ajoyib."
      }
    ],
    "questions": [
      "a1-m01-l3-e02",
      "a1-m01-l3-e03"
    ]
  },
  "situation": {
    "title": "Taksida manzil aytish",
    "context_uz": "Siz Berlinda taksiga o'tirdingiz. Haydovchiga ko'cha nomini aytishingiz kerak. \"Wohin?\" — \"Qayerga?\" degani.",
    "lines": [
      {
        "speaker": "Taxifahrer",
        "de": "Guten Abend! Wohin?",
        "uz": "Xayrli kech! Qayerga?"
      },
      {
        "speaker": "Siz",
        "de": "Guten Abend! Schillerstraße, bitte.",
        "uz": "Xayrli kech! Shillershtrasse, iltimos."
      },
      {
        "speaker": "Taxifahrer",
        "de": "Wie bitte? Schillerstraße?",
        "uz": "Nima dedingiz? Shillershtrasse?"
      },
      {
        "speaker": "Siz",
        "de": "Ja. S – C – H – I – L – L – E – R – Straße.",
        "uz": "Ha. S – C – H – I – L – L – E – R – Straße."
      },
      {
        "speaker": "Taxifahrer",
        "de": "Gut, danke!",
        "uz": "Yaxshi, rahmat!"
      }
    ],
    "task_uz": "Dialogni ovoz chiqarib o'qing: \"sch\" — \"sh\", \"st\" — \"sht\", \"ß\" — jarangsiz \"s\". Keyin boshqa ko'cha nomi bilan takrorlang (masalan, Goethestraße yoki Mozartstraße) va uni harflab ayting."
  },
