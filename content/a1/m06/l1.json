  "situation": {
    "title": "Uchrashuv kunini tanlash",
    "context_uz": "Do'stingiz Paul siz bilan bu hafta uchrashmoqchi. Siz haftalik rejangizni ko'rib javob berasiz.",
    "lines": [
      {
        "speaker": "Paul",
        "de": "Hast du am Dienstag Zeit?",
        "uz": "Seshanba kuni vaqting bormi?"
      },
      {
        "speaker": "Siz",
        "de": "Am Dienstag habe ich Kurs. Aber am Donnerstag habe ich Zeit.",
        "uz": "Seshanba kuni kursim bor. Lekin payshanba kuni vaqtim bor."
      },
      {
        "speaker": "Paul",
        "de": "Am Morgen oder am Abend?",
        "uz": "Ertalabmi yoki kechqurun?"
      },
      {
        "speaker": "Siz",
        "de": "Am Abend. Am Morgen arbeite ich.",
        "uz": "Kechqurun. Ertalab ishlayman."
      },
      {
        "speaker": "Paul",
        "de": "Super, dann am Donnerstagabend!",
        "uz": "Zo'r, unda payshanba kuni kechqurun!"
      }
    ],
    "task_uz": "O'z haftalik rejangizni ayting va Paul bilan uchrashuv kunini kelishing. Har bir gapda am + kun yoki am + kun qismini ishlating."
  },
