  "grammar": [
    {
      "topic_id": "g-pronouns",
      "rule": "Nemis tilida shaxs olmoshlari: ich, du, er, sie, es, wir, ihr, sie, Sie. Uchinchi shaxs birlikda jinsga qarab er (erkak), sie (ayol), es (o'rta jins) tanlanadi.",
      "when": "Odam haqida gapirganda ismni takrorlamaslik uchun va murojaat qilganda: do'stga du, notanish kattaga Sie.",
      "structure": "Jasur → er  |  Malika → sie  |  Jasur und Malika → sie  |  Herr Braun (murojaat) → Sie",
      "examples": [
        {
          "de": "Das ist Jasur. Er kommt aus Buchara.",
          "uz": "Bu Jasur. U Buxorodan."
        },
        {
          "de": "Das ist Malika. Sie wohnt in Berlin.",
          "uz": "Bu Malika. U Berlinda yashaydi."
        },
        {
          "de": "Herr Braun, woher kommen Sie?",
          "uz": "Braun janoblari, Siz qayerdansiz?"
        },
        {
          "de": "Jasur und Malika? Sie sind aus Usbekistan.",
          "uz": "Jasur va Malikami? Ular O'zbekistondan."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Malika? Er kommt aus Namangan.",
          "right": "Malika? Sie kommt aus Namangan.",
          "why": "O'zbek tilidagi \"u\" ikkala jins uchun bitta, nemis tilida ayol uchun sie, erkak uchun er."
        },
        {
          "wrong": "Herr Braun, woher kommst du?",
          "right": "Herr Braun, woher kommen Sie?",
          "why": "Notanish kattalarga Sie bilan murojaat qilinadi."
        }
      ],
      "check": [
        "a1-m02-l1-e03",
        "a1-m02-l1-e04"
      ]
    },
    {
      "topic_id": "g-sein-haben",
      "rule": "\"sein\" — noto'g'ri fe'l: har bir shaxs uchun shakli alohida, uni yod olish kerak (bin, bist, ist, sind, seid, sind).",
      "when": "Kimligingiz, qayerdanligingiz va holatingizni aytganda: Ich bin Aziz. Ich bin aus Usbekistan.",
      "structure": "olmosh + sein shakli + ism / aus + joy:  Wir sind aus Taschkent.",
      "examples": [
        {
          "de": "Ich bin Malika.",
          "uz": "Men Malikaman."
        },
        {
          "de": "Du bist aus Samarkand.",
          "uz": "Sen Samarqanddansan."
        },
        {
          "de": "Wir sind aus Usbekistan.",
          "uz": "Biz O'zbekistondanmiz."
        },
        {
          "de": "Ihr seid in Berlin.",
          "uz": "Sizlar Berlindasizlar."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich aus Usbekistan.",
          "right": "Ich bin aus Usbekistan.",
          "why": "O'zbek tilida \"-man\" qo'shimchasi yetarli, nemis tilida esa fe'l (bin) albatta kerak."
        },
        {
          "wrong": "Wir seid aus Taschkent.",
          "right": "Wir sind aus Taschkent.",
          "why": "wir bilan sind; seid — faqat ihr uchun."
        },
        {
          "wrong": "Ich komme von Usbekistan.",
          "right": "Ich komme aus Usbekistan.",
          "why": "Mamlakat yoki shahardan ekanini aytganda aus ishlatiladi, von emas."
        }
      ],
      "check": [
        "a1-m02-l1-e01",
        "a1-m02-l1-e02",
        "a1-m02-l1-e09",
        "a1-m02-l1-e10"
      ]
    }
  ],
  "listening": {
