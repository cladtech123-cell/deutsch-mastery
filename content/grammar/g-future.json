    {
      "type": "p",
      "text": "Eng oddiy usul: Morgen fahre ich nach Samarkand. \"werden\" bilan gap rasmiyroq yoki reja/bashoratni ta'kidlaydi: Es wird morgen regnen."
    },
    {
      "type": "tip",
      "text": "werden yolg'iz \"bo'lmoq\" ma'nosida: Ich werde Arzt — shifokor bo'laman. Inglizcha \"I will\" ga o'xshash \"Ich will\" esa \"xohlayman\" degani!"
    }
  ],
  "examples": [
    {
      "de": "Nächste Woche beginne ich einen neuen Kurs.",
      "uz": "Kelasi hafta yangi kursni boshlayman."
    },
    {
      "de": "Ich werde im Sommer meine Familie besuchen.",
      "uz": "Yozda oilamni ko'rgani boraman."
    },
    {
      "de": "Es wird morgen regnen.",
      "uz": "Ertaga yomg'ir yog'adi."
    },
    {
      "de": "In zwei Jahren will ich in Deutschland studieren.",
      "uz": "Ikki yildan keyin Germaniyada o'qimoqchiman."
    },
    {
      "de": "Was machst du am Wochenende?",
      "uz": "Dam olish kunlari nima qilasan?"
    },
    {
      "de": "Bald werde ich besser Deutsch sprechen.",
      "uz": "Tez orada nemischani yaxshiroq gapiraman."
    }
  ],
