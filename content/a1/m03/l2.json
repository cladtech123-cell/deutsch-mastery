  "grammar": [
    {
      "topic_id": "g-questions",
      "rule": "Telefon raqami, manzil, ism kabi ma'lumot \"Wie ist ...?\" savoli bilan so'raladi. W-so'z + fe'l + ega tartibi saqlanadi.",
      "when": "Telefon raqami, email yoki manzilni so'raganda; tushunmaganda qayta so'raganda.",
      "structure": "Wie + ist + Ihre/deine + Telefonnummer?  →  Meine Nummer ist ...",
      "examples": [
        {
          "de": "Wie ist Ihre Telefonnummer? — 0176 23 45 89.",
          "uz": "Telefon raqamingiz qanday? — 0176 23 45 89."
        },
        {
          "de": "Wie ist die Vorwahl von Berlin? — Null, drei, null.",
          "uz": "Berlinning kodi qanday? — Nol, uch, nol."
        },
        {
          "de": "Wie ist deine Handynummer? — Null, eins, fünf, eins ...",
          "uz": "Mobil raqaming qanday? — Nol, bir, besh, bir ..."
        },
        {
          "de": "Ist die Nummer richtig? — Ja, richtig.",
          "uz": "Raqam to'g'rimi? — Ha, to'g'ri."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Wie viel ist Ihre Telefonnummer?",
          "right": "Wie ist Ihre Telefonnummer?",
          "why": "O'zbekcha \"raqamingiz necha?\" ga qarab \"wie viel\" qo'yilmaydi: wie viel — miqdor uchun."
        },
        {
          "wrong": "Wie Ihre Telefonnummer ist?",
          "right": "Wie ist Ihre Telefonnummer?",
          "why": "Savolda fe'l (ist) ikkinchi o'rinda turadi, oxirida emas."
        }
      ],
      "check": [
        "a1-m03-l2-e04",
        "a1-m03-l2-e06"
      ]
    }
  ],
  "listening": {
    "title": "Telefon raqamini almashish",
    "lines": [
      {
        "speaker": "Paul",
        "de": "Wie ist deine Handynummer, Aziz?",
        "uz": "Mobil raqaming qanday, Aziz?"
      },
      {
        "speaker": "Aziz",
        "de": "Null, eins, sieben, sechs — dreiundzwanzig, fünfundvierzig, neunundachtzig.",
        "uz": "Nol, bir, yetti, olti — yigirma uch, qirq besh, sakson to'qqiz."
      },
      {
        "speaker": "Paul",
        "de": "Wie bitte? Noch einmal, bitte!",
        "uz": "Nima? Yana bir marta, iltimos!"
      },
      {
        "speaker": "Aziz",
        "de": "0176 – 23 – 45 – 89.",
        "uz": "0176 – 23 – 45 – 89."
      },
      {
        "speaker": "Paul",
        "de": "0176 23 45 89. Richtig?",
        "uz": "0176 23 45 89. To'g'rimi?"
      },
      {
        "speaker": "Aziz",
        "de": "Ja, richtig! Ruf mich an!",
        "uz": "Ha, to'g'ri! Menga qo'ng'iroq qil!"
      }
    ],
    "questions": [
      "a1-m03-l2-e02",
      "a1-m03-l2-e03"
    ]
  },
  "situation": {
    "title": "Raqamni yozib olish",
    "context_uz": "Siz kvartira bo'yicha e'lon ko'rdingiz va uy egasiga telefon qildingiz. U sizning raqamingizni so'rayapti.",
    "lines": [
      {
        "speaker": "Vermieter",
        "de": "Wie ist Ihre Telefonnummer?",
        "uz": "Telefon raqamingiz qanday?"
      },
      {
        "speaker": "Siz",
        "de": "Null, eins, fünf, eins — zweiunddreißig, siebzehn, null, sechs.",
        "uz": "Nol, bir, besh, bir — o'ttiz ikki, o'n yetti, nol, olti."
      },
      {
        "speaker": "Vermieter",
        "de": "Langsam, bitte! Null, eins, fünf, eins ...",
        "uz": "Sekinroq, iltimos! Nol, bir, besh, bir ..."
      },
      {
        "speaker": "Siz",
        "de": "... drei, zwo, eins, sieben, null, sechs.",
        "uz": "... uch, ikki, bir, yetti, nol, olti."
      },
      {
        "speaker": "Vermieter",
        "de": "Danke! Ich rufe heute an.",
        "uz": "Rahmat! Bugun qo'ng'iroq qilaman."
      }
    ],
    "task_uz": "O'z telefon raqamingizni (yoki o'ylab topilgan raqamni) ikki usulda ayting: raqamma-raqam va juft-juft. Sherigingiz yozib olsin va \"Richtig?\" deb tekshirsin."
  },
