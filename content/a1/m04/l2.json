  "situation": {
    "title": "Yangi qo'shni bilan suhbat",
    "context_uz": "Qo'shningiz Frau Weber sizdan oilangiz haqida so'rayapti.",
    "lines": [
      {
        "speaker": "Frau Weber",
        "de": "Haben Sie Kinder?",
        "uz": "Farzandlaringiz bormi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, ich habe zwei Kinder: einen Sohn und eine Tochter.",
        "uz": "Ha, ikkita farzandim bor: bitta o'g'il va bitta qiz."
      },
      {
        "speaker": "Frau Weber",
        "de": "Wie alt sind die Kinder?",
        "uz": "Bolalar necha yoshda?"
      },
      {
        "speaker": "Siz",
        "de": "Der Sohn ist sieben und die Tochter ist vier. Sie sind sehr lustig.",
        "uz": "O'g'lim yetti yoshda, qizim to'rt yoshda. Ular juda quvnoq."
      },
      {
        "speaker": "Frau Weber",
        "de": "Wie schön!",
        "uz": "Qanday yaxshi!"
      }
    ],
    "task_uz": "Frau Weberning savollariga o'z oilangiz haqida javob bering (farzandlar yoki aka-uka, opa-singillar). Sondan keyin ko'plik shaklini ishlatishni unutmang."
  },
