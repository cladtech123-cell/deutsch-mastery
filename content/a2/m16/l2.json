      },
      {
        "speaker": "Sekretärin",
        "de": "Frau Klein ist gerade in einer Besprechung. Kann ich etwas ausrichten?",
        "uz": "Klein xonim hozir yig'ilishda. Biror narsa yetkazaymi?"
      },
      {
        "speaker": "Herr Olimov",
        "de": "Ja, bitte. Kann sie mich heute noch zurückrufen? Es ist dringend.",
        "uz": "Ha, iltimos. U bugun menga qayta qo'ng'iroq qila oladimi? Bu shoshilinch."
      },
      {
        "speaker": "Sekretärin",
        "de": "Natürlich. Wie ist Ihr Name? Können Sie ihn bitte buchstabieren?",
        "uz": "Albatta. Ismingiz nima? Harflab ayta olasizmi?"
      },
      {
        "speaker": "Herr Olimov",
        "de": "O-L-I-M-O-V. Meine Nummer ist 0157 2234 891.",
        "uz": "O-L-I-M-O-V. Raqamim 0157 2234 891."
      },
      {
        "speaker": "Sekretärin",
        "de": "Danke, ich richte es aus.",
        "uz": "Rahmat, yetkazaman."
      }
