      "headers": [
        "Fe'l turi",
        "Qoida",
        "Misol"
      ],
      "rows": [
        [
          "muntazam",
          "ge- + o'zak + -t",
          "machen → gemacht, kaufen → gekauft, arbeiten → gearbeitet"
        ],
        [
          "nomuntazam",
          "ge- + o'zak (ko'pincha o'zgaradi) + -en",
          "sehen → gesehen, schreiben → geschrieben, trinken → getrunken"
        ],
        [
          "ajraladigan",
          "prefiks + ge + ...",
          "einkaufen → eingekauft, aufstehen → aufgestanden, anrufen → angerufen"
