  "situation": {
    "title": "Gamburgga safar oldidan",
    "context_uz": "Siz kelasi hafta Gamburgdagi do'stingiz Jonasning oldiga borasiz. U telefonda ob-havo haqida maslahat beryapti.",
    "lines": [
      {
        "speaker": "Jonas",
        "de": "Kommst du nächste Woche nach Hamburg?",
        "uz": "Kelasi hafta Gamburgga kelasanmi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja! Wie ist das Wetter in Hamburg?",
        "uz": "Ha! Gamburgda ob-havo qanday?"
      },
      {
        "speaker": "Jonas",
        "de": "Es ist kalt und es regnet oft. Nur 8 Grad.",
        "uz": "Sovuq va tez-tez yomg'ir yog'adi. Atigi 8 daraja."
      },
      {
        "speaker": "Siz",
        "de": "Oh! In Taschkent ist es jetzt warm. 25 Grad!",
        "uz": "Voy! Toshkentda hozir iliq. 25 daraja!"
      },
      {
        "speaker": "Jonas",
        "de": "Dann nimm eine Jacke und einen Pullover mit! Und vergiss den Regenschirm nicht!",
        "uz": "Unda kurtka va sviter olib kel! Soyabonni ham unutma!"
      },
      {
        "speaker": "Siz",
        "de": "Danke für den Tipp!",
        "uz": "Maslahat uchun rahmat!"
      }
    ],
    "task_uz": "Do'stingiz sizning shahringizga kelyapti. Hozirgi ob-havoni tasvirlang (harorat, yomg'ir/quyosh) va unga \"du\"-buyruq bilan 2–3 ta maslahat bering."
  },
