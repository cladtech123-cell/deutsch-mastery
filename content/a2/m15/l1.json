  "grammar": [
    {
      "topic_id": "g-verb-position",
      "rule": "Darak gapda tuslangan fe'l doim 2-o'rinda. 1-o'rinda subyekt emas, vaqt yoki joy (Montags, Im Büro, Dann) tursa, subyekt fe'ldan KEYIN keladi (inversiya).",
      "when": "Ish kuningizni tasvirlaganda: qachon va qayerda nima qilishingizni aytganda.",
      "structure": "Vaqt/joy (1) + fe'l (2) + subyekt (3) + boshqa qismlar.  Masalan: Montags habe ich eine Besprechung.",
      "examples": [
        {
          "de": "Im Büro beantworte ich E-Mails.",
          "uz": "Ofisda elektron xatlarga javob beraman."
        },
        {
          "de": "Montags haben wir eine Besprechung.",
          "uz": "Dushanbalari yig'ilishimiz bo'ladi."
        },
        {
          "de": "Dann berate ich Kunden.",
          "uz": "Keyin mijozlarga maslahat beraman."
        },
        {
          "de": "In meiner Firma arbeiten 40 Leute.",
          "uz": "Firmamda 40 kishi ishlaydi."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Montags ich habe eine Besprechung.",
          "right": "Montags habe ich eine Besprechung.",
          "why": "1-o'rin \"Montags\" bilan band — fe'l \"habe\" darhol 2-o'rinda, keyin \"ich\"."
        },
        {
          "wrong": "Im Büro ich beantworte E-Mails.",
          "right": "Im Büro beantworte ich E-Mails.",
          "why": "\"Im Büro\" — bitta bo'lak (1-o'rin). Fe'l uni darhol kuzatadi."
        }
      ],
      "check": [
        "a2-m15-l1-e02",
        "a2-m15-l1-e03"
      ]
    },
    {
      "topic_id": "g-articles",
      "rule": "Kasb haqida gapirganda \"sein\" yoki \"als\" dan keyin artikl ishlatilmaydi: Ich bin Koch. Ich arbeite als Köchin.",
      "when": "O'zingizni yoki boshqalarni kasbi bilan tanishtirganda.",
      "structure": "Ich bin + kasb (artiklsiz).  Ich arbeite als + kasb (artiklsiz).",
      "examples": [
        {
          "de": "Ich bin Krankenpfleger.",
          "uz": "Men hamshiraman (erkak)."
        },
        {
          "de": "Meine Schwester arbeitet als Verkäuferin.",
          "uz": "Opam sotuvchi bo'lib ishlaydi."
        },
        {
          "de": "Er ist Elektriker von Beruf.",
          "uz": "U kasbi bo'yicha elektrik."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich arbeite als ein Koch.",
          "right": "Ich arbeite als Koch.",
          "why": "\"als\" + kasb — artiklsiz."
        },
        {
          "wrong": "Sie ist Lehrer.",
          "right": "Sie ist Lehrerin.",
          "why": "Ayol kishi haqida kasb nomiga \"-in\" qo'shiladi."
        }
      ],
      "check": [
        "a2-m15-l1-e04"
      ]
    }
