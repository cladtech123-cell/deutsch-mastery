  "situation": {
    "title": "Yangi mahalla",
    "context_uz": "Siz Germaniyadagi yangi shaharga ko'chib keldingiz. Qo'shningiz Herr Braun bilan gaplashib, atrofda nima borligini so'rayapsiz.",
    "lines": [
      {
        "speaker": "Siz",
        "de": "Entschuldigung, ich bin neu hier. Gibt es hier einen Supermarkt?",
        "uz": "Kechirasiz, men bu yerda yangiman. Bu yerda supermarket bormi?"
      },
      {
        "speaker": "Herr Braun",
        "de": "Ja, in der Bahnhofstraße.",
        "uz": "Ha, Bahnhofstraße ko'chasida."
      },
      {
        "speaker": "Siz",
        "de": "Und gibt es hier eine Bibliothek?",
        "uz": "Kutubxona ham bormi?"
      },
      {
        "speaker": "Herr Braun",
        "de": "Ja, die Bibliothek ist im Zentrum, neben dem Rathaus. Dort kann man auch Zeitungen lesen.",
        "uz": "Ha, kutubxona markazda, hokimiyat yonida. U yerda gazeta ham o'qish mumkin."
      },
      {
        "speaker": "Siz",
        "de": "Toll! Und wo ist die Haltestelle?",
        "uz": "Zo'r! Bekat qayerda?"
      },
      {
        "speaker": "Herr Braun",
        "de": "Die Haltestelle ist hier links.",
        "uz": "Bekat shu yerda, chapda."
      },
      {
        "speaker": "Siz",
        "de": "Danke schön!",
        "uz": "Katta rahmat!"
      }
    ],
    "task_uz": "Qo'shningizga 3 ta savol bering: \"Gibt es hier ...?\", \"Wo ist ...?\", \"Wo kann man hier ...?\". U joyni \"neben dem / im / links\" bilan aytib bersin."
  },
