  "situation": {
    "title": "Til almashinuvi (Tandem)",
    "context_uz": "Siz nemis talabasi Laura bilan til almashinuvi (Tandem) uchun birinchi marta uchrashdingiz. U sizning qiziqishlaringizni so'rayapti.",
    "lines": [
      {
        "speaker": "Laura",
        "de": "Was sind deine Hobbys?",
        "uz": "Sening hobbilaring qanday?"
      },
      {
        "speaker": "Siz",
        "de": "Ich fotografiere gern. Und ich schwimme viel.",
        "uz": "Suratga olishni yaxshi ko'raman. Ko'p suzaman ham."
      },
      {
        "speaker": "Laura",
        "de": "Toll! Ich schwimme auch gern. Liest du auch gern?",
        "uz": "Zo'r! Men ham suzishni yaxshi ko'raman. Kitob o'qishni ham yoqtirasanmi?"
      },
      {
        "speaker": "Siz",
        "de": "Nicht so gern. Ich sehe lieber Filme.",
        "uz": "Unchalik emas. Film ko'rishni ko'proq yoqtiraman."
      },
      {
        "speaker": "Laura",
        "de": "Ich mag Filme auch. Am Freitag gibt es einen Film im Kino.",
        "uz": "Men ham filmlarni yoqtiraman. Juma kuni kinoda bitta film bor."
      },
      {
        "speaker": "Siz",
        "de": "Super, ich komme gern mit!",
        "uz": "Zo'r, men ham bajonidil boraman!"
      }
    ],
    "task_uz": "Sherigingizga 3 ta hobbingizni ayting (gern / nicht gern / lieber bilan) va unga 2 ta savol bering: \"Was machst du in deiner Freizeit?\", \"Spielst du gern ...?\""
  },
