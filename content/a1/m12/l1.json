  "situation": {
    "title": "Ishga qo'ng'iroq",
    "context_uz": "Ertalab o'zingizni yomon his qilyapsiz. Ishxonangizdagi rahbar Berger xonimga qo'ng'iroq qilib, kasal ekaningizni aytasiz.",
    "lines": [
      {
        "speaker": "Siz",
        "de": "Guten Morgen, Frau Berger. Hier ist Aziz Karimov.",
        "uz": "Xayrli tong, Berger xonim. Men Aziz Karimov."
      },
      {
        "speaker": "Frau Berger",
        "de": "Guten Morgen, Herr Karimov. Was ist los?",
        "uz": "Xayrli tong, Karimov janoblari. Nima bo'ldi?"
      },
      {
        "speaker": "Siz",
        "de": "Ich bin krank. Ich habe Fieber und mein Rücken tut weh.",
        "uz": "Kasalman. Isitmam bor va belim og'riyapti."
      },
      {
        "speaker": "Frau Berger",
        "de": "Oh, das tut mir leid! Gehen Sie zum Arzt.",
        "uz": "Voy, achinarli! Shifokorga boring."
      },
      {
        "speaker": "Siz",
        "de": "Ja, ich habe um zehn Uhr einen Termin.",
        "uz": "Ha, soat o'nda qabulga yozilganman."
      },
      {
        "speaker": "Frau Berger",
        "de": "Gute Besserung!",
        "uz": "Tezroq tuzaling!"
      }
    ],
    "task_uz": "Ishxona yoki kursga qo'ng'iroq qilib, kasal ekaningizni ayting: o'zingizni tanishtiring, ikkita shikoyat ayting (Mein ... tut weh / Ich habe ...) va shifokorga borishingizni ayting."
  },
