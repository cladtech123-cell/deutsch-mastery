  "grammar": [
    {
      "topic_id": "g-modal-verbs",
      "rule": "\"dürfen\" — ruxsat (mumkin); inkor bilan — taqiq (mumkin emas). \"sollen\" — boshqa odamning (shifokor, boshliq) ko'rsatmasi yoki maslahati; savolda \"Soll ich ...?\" — maslahat so'rash. Ikkalasida ham Infinitiv gap oxirida.",
      "when": "Shifokor ko'rsatmalarini tushunish va boshqalarga yetkazish, ruxsat so'rash.",
      "structure": "Subyekt + darf/soll + ... + Infinitiv.  Der Arzt sagt, ich soll + ... + Infinitiv.",
      "examples": [
        {
          "de": "Sie dürfen drei Tage nicht arbeiten.",
          "uz": "Uch kun ishlashingiz mumkin emas."
        },
        {
          "de": "Darf ich wieder Sport machen?",
          "uz": "Yana sport bilan shug'ullansam bo'ladimi?"
        },
        {
          "de": "Die Ärztin sagt, ich soll viel Wasser trinken.",
          "uz": "Shifokor ko'p suv ichishim kerakligini aytyapti."
        },
        {
          "de": "Soll ich morgen wiederkommen?",
          "uz": "Ertaga yana kelaymi?"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Mein Vater darft nicht rauchen.",
          "right": "Mein Vater darf nicht rauchen.",
          "why": "Modal fe'llarda \"er\" shaklida -t yo'q: er darf, er soll."
        },
        {
          "wrong": "Sie dürfen nicht Kaffee trinken.",
          "right": "Sie dürfen keinen Kaffee trinken.",
          "why": "Artiklsiz otni inkor qilish uchun \"kein\" ishlatiladi."
        },
        {
          "wrong": "Der Arzt sagt, ich soll trinken viel Wasser.",
          "right": "Der Arzt sagt, ich soll viel Wasser trinken.",
          "why": "Infinitiv (trinken) gap oxirida."
        }
      ],
      "check": [
        "a2-m18-l2-e02",
        "a2-m18-l2-e03",
        "a2-m18-l2-e04",
        "a2-m18-l2-e05"
      ]
    }
  ],
  "listening": {
    "title": "Ko'rikdan keyin",
    "lines": [
      {
        "speaker": "Dr. Hartmann",
        "de": "So, ich habe Sie untersucht. Sie haben eine Grippe.",
        "uz": "Xo'sh, sizni tekshirdim. Sizda gripp."
      },
      {
        "speaker": "Frau Ismoilova",
        "de": "Oh nein. Darf ich morgen arbeiten?",
        "uz": "Voy. Ertaga ishlasam bo'ladimi?"
      },
      {
        "speaker": "Dr. Hartmann",
        "de": "Nein, Sie dürfen diese Woche nicht arbeiten. Ich schreibe Sie bis Freitag krank.",
        "uz": "Yo'q, bu hafta ishlashingiz mumkin emas. Sizga jumagacha kasallik varaqasi beraman."
      },
      {
        "speaker": "Frau Ismoilova",
        "de": "Was soll ich machen?",
        "uz": "Nima qilishim kerak?"
      },
      {
        "speaker": "Dr. Hartmann",
        "de": "Sie sollen viel schlafen und viel trinken. Hier ist ein Rezept für Fiebertabletten.",
        "uz": "Ko'p uxlashingiz va ko'p suyuqlik ichishingiz kerak. Mana isitma tabletkalari uchun retsept."
      },
      {
        "speaker": "Frau Ismoilova",
        "de": "Soll ich nächste Woche wiederkommen?",
        "uz": "Kelasi hafta yana kelaymi?"
      },
      {
        "speaker": "Dr. Hartmann",
        "de": "Nur wenn es nicht besser wird.",
        "uz": "Faqat yaxshilanmasa."
      }
    ],
    "questions": [
      "a2-m18-l2-e06"
    ]
