  "grammar": [
    {
      "topic_id": "g-praesens",
      "rule": "Muntazam fe'llarda o'zak o'zgarmaydi, faqat oxiriga shaxsga mos qo'shimcha qo'shiladi: -e, -st, -t, -en, -t, -en.",
      "when": "Har kungi harakatlar haqida gapirganda: qayerda yashaysiz, nima yozasiz, nima yuborasiz.",
      "structure": "o'zak + qo'shimcha:  ich wohn-e | du wohn-st | er/sie wohn-t | wir wohn-en | ihr wohn-t | sie/Sie wohn-en",
      "examples": [
        {
          "de": "Ich wohne in der Goethestraße 12.",
          "uz": "Men Gyote ko'chasi 12-uyda yashayman."
        },
        {
          "de": "Du schreibst die Adresse.",
          "uz": "Sen manzilni yozasan."
        },
        {
          "de": "Sie schickt eine E-Mail.",
          "uz": "U (ayol) email yuboradi."
        },
        {
          "de": "Wir wohnen in der zweiten Etage.",
          "uz": "Biz ikkinchi qavatda yashaymiz."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Er wohnen in Köln.",
          "right": "Er wohnt in Köln.",
          "why": "er/sie/es bilan -t: er wohnt. -en — faqat wir, sie (ular), Sie bilan."
        },
        {
          "wrong": "Du schreibt eine E-Mail.",
          "right": "Du schreibst eine E-Mail.",
          "why": "du bilan qo'shimcha -st."
        },
        {
          "wrong": "Ich wohnen in Leipzig.",
          "right": "Ich wohne in Leipzig.",
          "why": "ich bilan qo'shimcha -e. Infinitiv (wohnen) tuslanmagan shakl."
        }
      ],
      "check": [
        "a1-m03-l3-e04",
        "a1-m03-l3-e05",
        "a1-m03-l3-e06"
      ]
    }
  ],
  "listening": {
    "title": "Til maktabidan qo'ng'iroq",
    "lines": [
      {
        "speaker": "Frau Lang",
        "de": "Guten Tag, Frau Saidova! Wie ist Ihre Adresse?",
        "uz": "Assalomu alaykum, Saidova xonim! Manzilingiz qanday?"
      },
      {
        "speaker": "Nodira",
        "de": "Goethestraße zwölf, null-vier-eins-null-neun Leipzig.",
        "uz": "Gyote ko'chasi 12, 04109 Leyptsig."
      },
      {
        "speaker": "Frau Lang",
        "de": "Danke. Und Ihre E-Mail-Adresse?",
        "uz": "Rahmat. Email manzilingiz-chi?"
      },
      {
        "speaker": "Nodira",
        "de": "nodira Punkt saidova ät web Punkt de.",
        "uz": "nodira nuqta saidova ät web nuqta de."
      },
      {
        "speaker": "Frau Lang",
        "de": "Gut. Wir schicken die Informationen per E-Mail.",
        "uz": "Yaxshi. Ma'lumotni email orqali yuboramiz."
      }
    ],
    "questions": [
      "a1-m03-l3-e02",
      "a1-m03-l3-e03"
    ]
  },
  "situation": {
    "title": "Ro'yxatdan o'tish idorasida",
    "context_uz": "Siz Germaniyada yangi kvartiraga ko'chdingiz va shahar idorasida (Bürgeramt) ro'yxatdan o'tyapsiz.",
    "lines": [
      {
        "speaker": "Beamtin",
        "de": "Füllen Sie bitte das Formular aus. Wie ist Ihre Adresse?",
        "uz": "Iltimos, anketani to'ldiring. Manzilingiz qanday?"
      },
      {
        "speaker": "Siz",
        "de": "Schillerstraße 5, 53111 Bonn.",
        "uz": "Shiller ko'chasi 5, 53111 Bonn."
      },
      {
        "speaker": "Beamtin",
        "de": "In welcher Etage wohnen Sie?",
        "uz": "Nechanchi qavatda yashaysiz?"
      },
      {
        "speaker": "Siz",
        "de": "In der dritten Etage.",
        "uz": "Uchinchi qavatda."
      },
      {
        "speaker": "Beamtin",
        "de": "Und Ihre E-Mail-Adresse?",
        "uz": "Email manzilingiz-chi?"
      },
      {
        "speaker": "Siz",
        "de": "shahzoda Punkt t ät gmx Punkt de.",
        "uz": "shahzoda nuqta t ät gmx nuqta de."
      },
      {
        "speaker": "Beamtin",
        "de": "Danke. Ihre Unterschrift, bitte — hier.",
        "uz": "Rahmat. Imzoingiz, iltimos — mana bu yerga."
      }
    ],
    "task_uz": "Xodimning savollariga o'z manzilingiz (yoki o'ylab topilgan nemis manzili) va email'ingiz bilan javob bering. Email'ni nemischa harflab va belgilarni (ät, Punkt) to'g'ri aytib bering."
  },
