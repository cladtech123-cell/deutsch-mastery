  "grammar": [
    {
      "topic_id": "g-modal-verbs",
      "rule": "\"müssen\" — zarurat, majburiyat (kerak, shart). Modal fe'l 2-o'rinda tuslanadi, asosiy fe'l Infinitivda gap oxirida. \"ich\" va \"er/sie/es\" shakllari bir xil: muss.",
      "when": "Nima qilish kerakligini aytganda: shifokorga borish, dori ichish, uyda qolish.",
      "structure": "Subyekt + muss/müssen + ... + Infinitiv.  Masalan: Ich muss heute zum Arzt gehen.",
      "examples": [
        {
          "de": "Ich muss heute zum Arzt gehen.",
          "uz": "Bugun shifokorga borishim kerak."
        },
        {
          "de": "Sie müssen viel Tee trinken.",
          "uz": "Siz ko'p choy ichishingiz kerak."
        },
        {
          "de": "Mein Sohn hat Fieber, er muss im Bett bleiben.",
          "uz": "O'g'limning isitmasi bor, u to'shakda yotishi kerak."
        },
        {
          "de": "Musst du morgen arbeiten?",
          "uz": "Ertaga ishlashing kerakmi?"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich muss gehen zum Arzt.",
          "right": "Ich muss zum Arzt gehen.",
          "why": "Modal fe'l bilan Infinitiv (gehen) oxirida turadi."
        },
        {
          "wrong": "Er musst im Bett bleiben.",
          "right": "Er muss im Bett bleiben.",
          "why": "\"er\" bilan \"muss\" — oxiriga -t qo'shilmaydi."
        },
        {
          "wrong": "Ich bin schwindlig.",
          "right": "Mir ist schwindlig.",
          "why": "Bu holat Dativ bilan aytiladi: Mir ist schwindlig / übel."
        }
      ],
      "check": [
        "a2-m18-l1-e02",
        "a2-m18-l1-e03",
        "a2-m18-l1-e04",
        "a2-m18-l1-e08"
      ]
    }
  ],
