  "grammar": [
    {
      "topic_id": "g-time-prepositions",
      "rule": "Vaqtni ifodalashda: \"um\" — aniq soat, \"gegen\" — taxminiy vaqt, \"ab\" — boshlanish nuqtasi, \"bis\" — tugash nuqtasi, \"von ... bis\" — vaqt oralig'i.",
      "when": "Poyezd jadvali, ish vaqti, bron muddati, uchrashuv vaqtini aytganda.",
      "structure": "Subyekt + fe'l + um/gegen/ab/bis + vaqt.  Masalan: Der Zug fährt um 9 Uhr ab.",
      "examples": [
        {
          "de": "Der Zug fährt um 7.45 Uhr von Gleis 2 ab.",
          "uz": "Poyezd soat 7:45 da 2-yo'ldan jo'naydi."
        },
        {
          "de": "Wir kommen gegen Mittag in Wien an.",
          "uz": "Venaga tushga yaqin yetib kelamiz."
        },
        {
          "de": "Ab Juni gibt es eine neue Verbindung.",
          "uz": "Iyundan boshlab yangi qatnov bor."
        },
        {
          "de": "Das Ticket ist bis Sonntag gültig.",
          "uz": "Chipta yakshanbagacha amal qiladi."
        },
        {
          "de": "Die Rezeption ist von 6 bis 23 Uhr geöffnet.",
          "uz": "Qabulxona soat 6 dan 23 gacha ochiq."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Der Zug fährt an 9 Uhr ab.",
          "right": "Der Zug fährt um 9 Uhr ab.",
          "why": "Soat bilan doim \"um\". \"am\" — kun bilan (am Montag)."
        },
        {
          "wrong": "Ich arbeite von 8 zu 17 Uhr.",
          "right": "Ich arbeite von 8 bis 17 Uhr.",
          "why": "Oraliq: \"von ... bis\". \"zu\" bu ma'noda ishlatilmaydi."
        },
        {
          "wrong": "Der Zug abfährt um 9 Uhr.",
          "right": "Der Zug fährt um 9 Uhr ab.",
          "why": "\"abfahren\" ajraladigan fe'l: \"fährt\" 2-o'rinda, \"ab\" oxirida."
        }
      ],
      "check": [
        "a2-m14-l2-e02",
        "a2-m14-l2-e03",
        "a2-m14-l2-e04"
      ]
    }
  ],
  "listening": {
