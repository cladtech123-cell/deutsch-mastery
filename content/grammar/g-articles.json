  "rule": "Har bir nemis oti grammatik jinsga ega: erkak (der), ayol (die) yoki o'rta (das). Noaniq artikl: ein (erkak, o'rta), eine (ayol).",
  "when": "Aniq artikl — ma'lum, avval aytilgan narsa uchun. Noaniq artikl — birinchi marta tilga olingan, \"bir\" ma'nosidagi narsa uchun.",
  "structure": "artikl + Ot (katta harf bilan): der Tisch, eine Lampe",
  "explanation": [
    {
      "type": "table",
      "headers": [
        "Jins",
        "Aniq",
        "Noaniq",
        "Misol"
      ],
      "rows": [
        [
          "erkak",
          "der",
          "ein",
          "der Mann, ein Tisch"
        ],
        [
          "ayol",
          "die",
          "eine",
          "die Frau, eine Lampe"
        ],
        [
          "o'rta",
          "das",
          "ein",
          "das Kind, ein Buch"
        ],
        [
          "ko'plik",
          "die",
          "—",
          "die Bücher, Bücher"
        ]
      ]
    },
    {
      "type": "p",
      "text": "O'zbek tilida grammatik jins va artikl yo'q, shuning uchun har bir otni artikli bilan birga yodlang: \"der Tisch\", faqat \"Tisch\" emas. Jins ko'pincha mantiqqa bog'liq emas: das Mädchen (qiz) — o'rta jins."
    },
    {
      "type": "table",
      "headers": [
        "Belgi",
        "Jins",
        "Misol"
      ],
      "rows": [
        [
          "-ung, -heit, -keit, -ion",
          "die",
          "die Wohnung, die Zeitung, die Information"
        ],
        [
          "-chen, -lein",
          "das",
          "das Mädchen, das Brötchen"
        ],
        [
          "hafta kunlari, oylar, fasllar",
          "der",
          "der Montag, der Mai, der Sommer"
        ]
      ]
    },
    {
      "type": "tip",
      "text": "Birinchi marta: Das ist ein Tisch. Keyin: Der Tisch ist neu."
    }
  ],
  "examples": [
    {
      "de": "Das ist ein Tisch. Der Tisch ist neu.",
      "uz": "Bu stol. Stol yangi."
    },
    {
      "de": "Hier ist eine Tasche. Die Tasche ist schwarz.",
      "uz": "Mana sumka. Sumka qora."
    },
    {
      "de": "Das Kind spielt im Garten.",
      "uz": "Bola bog'da o'ynayapti."
    },
    {
      "de": "Ich habe ein Handy.",
      "uz": "Mening telefonim bor."
    },
    {
      "de": "Die Zeitung liegt dort.",
      "uz": "Gazeta u yerda yotibdi."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Das ist Tisch.",
      "right": "Das ist ein Tisch.",
      "why": "O'zbek tilida artikl yo'q, shuning uchun u tushib qoladi. Nemis tilida birlikdagi ot oldida odatda artikl bo'ladi."
    },
    {
      "wrong": "ein Lampe",
      "right": "eine Lampe",
      "why": "die Lampe — ayol jinsi, noaniq artikl \"eine\"."
    },
    {
      "wrong": "die Mädchen (birlik)",
      "right": "das Mädchen",
      "why": "-chen bilan tugagan otlar doim das."
    }
  ],
