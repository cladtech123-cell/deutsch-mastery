  "grammar": [
    {
      "topic_id": "g-questions",
      "rule": "W-savolda W-so'z birinchi, fe'l ikkinchi, ega uchinchi o'rinda turadi. Fe'l egaga mos tuslanadi.",
      "when": "Aniq ma'lumot so'raganda: kim, nima, qayerda, qayerdan, qanday.",
      "structure": "W-so'z + fe'l + ega + ...?  →  Wo wohnst du?",
      "examples": [
        {
          "de": "Wer ist das? — Das ist Timur.",
          "uz": "Bu kim? — Bu Timur."
        },
        {
          "de": "Was lernst du? — Ich lerne Deutsch.",
          "uz": "Nima o'rganyapsan? — Nemis tilini o'rganyapman."
        },
        {
          "de": "Wo wohnt ihr? — Wir wohnen in Köln.",
          "uz": "Sizlar qayerda yashaysizlar? — Biz Kyolnda yashaymiz."
        },
        {
          "de": "Wie heißen Sie? — Ich heiße Sevara Alimova.",
          "uz": "Ismingiz nima? — Mening ismim Sevara Alimova."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Wo du wohnst?",
          "right": "Wo wohnst du?",
          "why": "O'zbek tilida fe'l gap oxirida, nemis tilida esa W-so'zdan keyin darhol fe'l keladi."
        },
        {
          "wrong": "Wer kommst du?",
          "right": "Woher kommst du?",
          "why": "wer — kim. Qayerdan — woher."
        },
        {
          "wrong": "Was heißt du?",
          "right": "Wie heißt du?",
          "why": "Ism so'ralganda \"Wie\" (qanday) ishlatiladi, \"Was\" emas."
        }
      ],
      "check": [
        "a1-m02-l3-e01",
        "a1-m02-l3-e02",
        "a1-m02-l3-e03",
        "a1-m02-l3-e04",
        "a1-m02-l3-e08"
      ]
    }
  ],
  "listening": {
    "title": "Kursga yangi talaba",
    "lines": [
      {
        "speaker": "Frau Koch",
        "de": "Guten Morgen! Wer ist neu hier?",
        "uz": "Xayrli tong! Bu yerda kim yangi?"
      },
      {
        "speaker": "Timur",
        "de": "Ich! Ich heiße Timur.",
        "uz": "Men! Mening ismim Timur."
      },
      {
        "speaker": "Frau Koch",
        "de": "Freut mich, Timur! Woher kommen Sie?",
        "uz": "Tanishganimdan xursandman, Timur! Qayerdansiz?"
      },
      {
        "speaker": "Timur",
        "de": "Aus Usbekistan. Ich bin Student.",
        "uz": "O'zbekistondan. Men talabaman."
      },
      {
        "speaker": "Frau Koch",
        "de": "Und was lernen Sie hier?",
        "uz": "Bu yerda nima o'rganyapsiz?"
      },
      {
        "speaker": "Timur",
        "de": "Ich lerne Deutsch. Jetzt wohne ich in Dresden.",
        "uz": "Nemis tilini o'rganyapman. Hozir Drezdenda yashayman."
      }
    ],
    "questions": [
      "a1-m02-l3-e05",
      "a1-m02-l3-e06"
    ]
  },
  "situation": {
    "title": "Til maktabida anketa",
    "context_uz": "Siz til maktabiga yozilyapsiz. Kotib anketani siz bilan birga to'ldiryapti.",
    "lines": [
      {
        "speaker": "Sekretär",
        "de": "Wie ist Ihr Vorname?",
        "uz": "Ismingiz nima?"
      },
      {
        "speaker": "Siz",
        "de": "Shahzoda.",
        "uz": "Shahzoda."
      },
      {
        "speaker": "Sekretär",
        "de": "Und Ihr Nachname?",
        "uz": "Familiyangiz-chi?"
      },
      {
        "speaker": "Siz",
        "de": "Tursunova. T – U – R – S – U – N – O – V – A.",
        "uz": "Tursunova. T – U – R – S – U – N – O – V – A."
      },
      {
        "speaker": "Sekretär",
        "de": "Woher kommen Sie? Und wo wohnen Sie jetzt?",
        "uz": "Qayerdansiz? Hozir qayerda yashaysiz?"
      },
      {
        "speaker": "Siz",
        "de": "Ich komme aus Usbekistan. Jetzt wohne ich in Bonn.",
        "uz": "O'zbekistondanman. Hozir Bonnda yashayman."
      },
      {
        "speaker": "Sekretär",
        "de": "Sind Sie verheiratet?",
        "uz": "Turmush qurganmisiz?"
      },
      {
        "speaker": "Siz",
        "de": "Nein, ich bin ledig.",
        "uz": "Yo'q, turmush qurmaganman."
      }
    ],
    "task_uz": "Kotibning savollariga o'z ma'lumotlaringiz bilan javob bering. Keyin sherigingizga xuddi shu savollarni \"du\" bilan bering: Wie heißt du? Woher kommst du? Wo wohnst du? Bist du verheiratet?"
  },
