  "situation": {
    "title": "Kafega taklif",
    "context_uz": "Do'stingiz Sophie sizga telefon qilib, kechqurun kafega taklif qilyapti. Lekin bugun kechqurun sizda nemis tili kursi bor.",
    "lines": [
      {
        "speaker": "Sophie",
        "de": "Hallo! Wollen wir heute Abend ins Café gehen?",
        "uz": "Salom! Bugun kechqurun kafega boramizmi?"
      },
      {
        "speaker": "Siz",
        "de": "Heute Abend? Leider kann ich nicht. Ich habe einen Deutschkurs.",
        "uz": "Bugun kechqurunmi? Afsuski, kela olmayman. Nemis tili kursim bor."
      },
      {
        "speaker": "Sophie",
        "de": "Schade! Hast du morgen Zeit?",
        "uz": "Attang! Ertaga vaqting bormi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, morgen habe ich Zeit. Wann treffen wir uns?",
        "uz": "Ha, ertaga vaqtim bor. Qachon uchrashamiz?"
      },
      {
        "speaker": "Sophie",
        "de": "Um 17 Uhr im Café Mozart?",
        "uz": "Soat 17 da \"Mozart\" kafesida?"
      },
      {
        "speaker": "Siz",
        "de": "Gute Idee! Bis morgen!",
        "uz": "Yaxshi fikr! Ertagacha!"
      }
    ],
    "task_uz": "Sherigingizni biror joyga taklif qiling (piknik, kino, sayr). Sherigingiz avval sababini aytib rad etsin va boshqa kunni taklif qilsin. Keyin vaqt va joyni kelishing: \"Wann treffen wir uns?\", \"Wo treffen wir uns?\""
  },
