  "writing_task": {
    "id": "w-a1-m08",
    "title": "Xarid rejasi",
    "task_uz": "Ertaga do'konga borasiz. Qisqa matn yozing: 1) supermarketda nima va qancha olasiz (miqdor bilan); 2) kiyim do'konida nima qidirasiz (o'lcham, rang); 3) nima sizga kerak emas (kein/nicht bilan).",
    "required_words": [
      "suche",
      "brauche"
    ],
    "min_words": 35,
    "max_words": 80,
    "criteria": [
      "Kamida 3 ta mahsulot miqdor bilan (ein Kilo, eine Flasche, 200 Gramm)",
      "Kiyim: o'lcham yoki rang ko'rsatilgan",
      "kein/keine/keinen bilan kamida bitta inkor",
      "nicht bilan kamida bitta inkor",
      "Akkusativ to'g'ri: einen/eine/ein",
      "Narx haqida savol (Was kostet ...?)"
    ],
    "sample_answer": "Morgen gehe ich einkaufen. Im Supermarkt kaufe ich ein Kilo Äpfel, zwei Flaschen Wasser und 200 Gramm Käse. Ich brauche keine Milch. Dann suche ich eine Jacke in Größe M. Ich habe 50 Euro. Was kostet eine Jacke? Ich brauche keinen Pullover, ich habe zwei Pullover."
  }
