  "grammar": [
    {
      "topic_id": "g-plural",
      "rule": "Ko'plik shakli otning oxiriga -e, -er, -(e)n, -s qo'shish yoki o'zgarishsiz (ba'zan umlaut bilan) yasaladi. Ko'plikda artikl doim die, fe'l ham ko'plikda (sind).",
      "when": "Bir nechta odam yoki narsa haqida gapirganda, ayniqsa sonlardan keyin (zwei, drei ...).",
      "structure": "die + ko'plik shakli + sind ...  |  son + ko'plik: zwei Brüder",
      "examples": [
        {
          "de": "Ich habe zwei Brüder und eine Schwester.",
          "uz": "Mening ikkita akam va bitta opam bor."
        },
        {
          "de": "Die Kinder sind klein.",
          "uz": "Bolalar kichik."
        },
        {
          "de": "Meine Tanten sind jung und lustig.",
          "uz": "Xolalarim yosh va quvnoq."
        },
        {
          "de": "Das sind drei Fotos.",
          "uz": "Bular uchta surat."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich habe zwei Bruder.",
          "right": "Ich habe zwei Brüder.",
          "why": "O'zbekchada \"ikkita aka\" deyiladi (birlik), nemis tilida sondan keyin ko'plik shakli kerak."
        },
        {
          "wrong": "Die Kinder ist klein.",
          "right": "Die Kinder sind klein.",
          "why": "Ega ko'plikda — fe'l ham ko'plikda: sind."
        },
        {
          "wrong": "der Kinder",
          "right": "die Kinder",
          "why": "Ko'plikda har doim die, otning birlikdagi jinsidan qat'i nazar."
        }
      ],
      "check": [
        "a1-m04-l2-e01",
        "a1-m04-l2-e02",
        "a1-m04-l2-e03",
        "a1-m04-l2-e07",
        "a1-m04-l2-e08"
      ]
    }
  ],
  "listening": {
    "title": "Surat haqida suhbat",
    "lines": [
      {
        "speaker": "Paul",
        "de": "Hast du Geschwister, Dilnoza?",
        "uz": "Aka-uka, opa-singillaring bormi, Dilnoza?"
      },
      {
        "speaker": "Dilnoza",
        "de": "Ja, ich habe zwei Brüder und eine Schwester.",
        "uz": "Ha, ikkita akam va bitta singlim bor."
      },
      {
        "speaker": "Paul",
        "de": "Und wer sind die Leute hier auf dem Foto?",
        "uz": "Suratdagi bu odamlar kim?"
      },
      {
        "speaker": "Dilnoza",
        "de": "Das sind meine Cousins. Sie sind sehr lustig.",
        "uz": "Bular amakivachchalarim. Ular juda quvnoq."
      },
      {
        "speaker": "Paul",
        "de": "Und die Frau? Sie ist sehr jung!",
        "uz": "Ayol-chi? U juda yosh!"
      },
      {
        "speaker": "Dilnoza",
        "de": "Das ist meine Tante. Sie ist nett.",
        "uz": "Bu xolam. U juda yoqimli."
      }
    ],
    "questions": [
      "a1-m04-l2-e05",
