  "writing_task": {
    "id": "w-a1-m07",
    "title": "Do'stga xabar: ovqat va restoran",
    "task_uz": "Nemis do'stingizga qisqa xabar yozing: 1) qaysi ovqat va ichimliklarni yaxshi ko'rasiz; 2) nimani yoqtirmaysiz; 3) uni restoranga taklif qiling va u yerda nima buyurtma qilmoqchi ekaningizni yozing.",
    "required_words": [
      "gern",
      "möchte"
    ],
    "min_words": 30,
    "max_words": 70,
    "criteria": [
      "Kamida 3 ta ovqat yoki ichimlik nomi bor",
      "\"gern\" yoki \"mögen\" bilan yoqtirish bildirilgan",
      "\"nicht gern\" bilan yoqtirmaslik bildirilgan",
      "\"möchte\" bilan buyurtma: Ich möchte einen/eine/ein ...",
      "Akkusativ to'g'ri (der → einen)",
      "Fe'l 2-o'rinda; salomlashish va xayrlashish bor"
    ],
    "sample_answer": "Hallo Jonas, ich esse gern Reis und Fleisch. Ich trinke auch gern Tee mit Milch. Fisch esse ich nicht gern. Am Samstag gehen wir zusammen ins Restaurant, ja? Ich möchte dort einen Salat und eine Suppe essen. Und du? Bis Samstag! Viele Grüße, Aziz"
  }
