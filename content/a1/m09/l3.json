  "grammar": [
    {
      "topic_id": "g-place-prepositions",
      "rule": "auf, unter, neben, hinter, an, in — \"Wo?\" (qayerda?) savoliga javob beradi. Ulardan keyin artikl o'zgaradi: der/das → dem, die → der. in + dem = im.",
      "when": "Narsa yoki odam qayerda ekanini aytganda: uyda, xonada, shaharda.",
      "structure": "Ot + liegt/steht/hängt/ist + predlog + dem/der + ot:\nDas Buch liegt auf dem Tisch. Die Lampe hängt an der Wand. Der Schrank ist im Zimmer.",
      "examples": [
        {
          "de": "Das Handy liegt auf dem Tisch.",
          "uz": "Telefon stol ustida yotibdi."
        },
        {
          "de": "Die Schuhe stehen unter dem Bett.",
          "uz": "Poyabzal karavot ostida turibdi."
        },
        {
          "de": "Das Bild hängt an der Wand.",
          "uz": "Rasm devorda osilib turibdi."
        },
        {
          "de": "Der Kühlschrank ist in der Küche.",
          "uz": "Muzlatgich oshxonada."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Das Buch liegt auf der Tisch.",
          "right": "Das Buch liegt auf dem Tisch.",
          "why": "der Tisch → \"Wo?\" savolida dem: auf dem Tisch."
        },
        {
          "wrong": "Ich bin in dem Zimmer.",
          "right": "Ich bin im Zimmer.",
          "why": "in + dem odatda qisqartiriladi: im."
        },
        {
          "wrong": "Das Bild liegt an der Wand.",
          "right": "Das Bild hängt an der Wand.",
          "why": "Devordagi narsa osilib turadi — hängen. liegen — gorizontal yotish."
        }
      ],
      "check": [
        "a1-m09-l3-e02",
        "a1-m09-l3-e03",
        "a1-m09-l3-e04",
        "a1-m09-l3-e05",
        "a1-m09-l3-e06"
      ]
    }
  ],
  "listening": {
    "title": "Telefon qayerda?",
    "lines": [
      {
        "speaker": "Kamol",
        "de": "Mama, wo ist mein Handy?",
        "uz": "Oyi, telefonim qayerda?"
      },
      {
        "speaker": "Mama",
        "de": "Liegt es auf dem Tisch in der Küche?",
        "uz": "Oshxonadagi stol ustida yotmaganmi?"
      },
      {
        "speaker": "Kamol",
        "de": "Nein, auf dem Tisch liegt es nicht.",
        "uz": "Yo'q, stol ustida yo'q."
      },
      {
        "speaker": "Mama",
        "de": "Vielleicht im Wohnzimmer, neben dem Sofa?",
        "uz": "Balki mehmonxonada, divan yonidadir?"
      },
      {
        "speaker": "Kamol",
        "de": "Nein ... Ah, hier! Es liegt unter dem Sofa!",
        "uz": "Yo'q... A, mana! Divan ostida yotibdi!"
      },
      {
        "speaker": "Mama",
        "de": "Und deine Jacke hängt nicht im Flur. Sie liegt auf dem Boden!",
        "uz": "Kurtkang esa dahlizda osilmagan. U polda yotibdi!"
      },
      {
        "speaker": "Kamol",
        "de": "Entschuldigung, Mama!",
        "uz": "Kechirasiz, oyi!"
      }
    ],
    "questions": [
      "a1-m09-l3-e08",
      "a1-m09-l3-e09"
    ]
  },
  "situation": {
    "title": "Yangi kvartiraga ko'chish",
    "context_uz": "Siz yangi kvartiraga ko'chyapsiz. Yuk tashuvchi (Möbelpacker) har bir mebelni qayerga qo'yishni so'rayapti.",
    "lines": [
      {
        "speaker": "Möbelpacker",
        "de": "Wo steht das Sofa?",
        "uz": "Divan qayerda turadi?"
      },
      {
        "speaker": "Siz",
        "de": "Das Sofa steht im Wohnzimmer, links neben dem Fenster.",
        "uz": "Divan mehmonxonada, chapda, deraza yonida turadi."
      },
      {
        "speaker": "Möbelpacker",
        "de": "Und der Schrank?",
        "uz": "Shkaf-chi?"
      },
      {
        "speaker": "Siz",
        "de": "Der Schrank steht im Schlafzimmer, rechts.",
        "uz": "Shkaf yotoqxonada, o'ngda turadi."
      },
      {
        "speaker": "Möbelpacker",
        "de": "Und die Lampe?",
        "uz": "Chiroq-chi?"
      },
      {
        "speaker": "Siz",
        "de": "Die Lampe hängt im Flur.",
        "uz": "Chiroq dahlizda osilib turadi."
      },
      {
        "speaker": "Möbelpacker",
        "de": "Und der Teppich?",
        "uz": "Gilam-chi?"
      },
      {
        "speaker": "Siz",
        "de": "Der Teppich liegt im Wohnzimmer, unter dem Tisch.",
        "uz": "Gilam mehmonxonada, stol ostida yotadi."
      }
    ],
    "task_uz": "Xonangiz rejasini chizing (yoki tasavvur qiling) va 5 ta gap ayting: har bir mebel qayerda turadi, yotadi yoki osilib turadi. auf, unter, neben, hinter, an, im / in der ishlating."
  },
