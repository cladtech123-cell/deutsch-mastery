  "listening": {
    "title": "Uy boshqaruvchisi uyni ko'rsatmoqda",
    "lines": [
      {
        "speaker": "Hausmeister",
        "de": "Willkommen! Ihre Wohnung ist im zweiten Stock. Der Aufzug ist neben der Treppe.",
        "uz": "Xush kelibsiz! Kvartirangiz uchinchi qavatda. Lift zinapoya yonida."
      },
      {
        "speaker": "Nigora",
        "de": "Und wo kann ich mein Fahrrad abstellen?",
        "uz": "Velosipedimni qayerga qo'ysam bo'ladi?"
      },
      {
        "speaker": "Hausmeister",
        "de": "Die Fahrräder stehen im Keller. Ihr Kellerraum ist ganz hinten, links.",
        "uz": "Velosipedlar yerto'lada turadi. Sizning yerto'la xonangiz eng orqada, chapda."
      },
      {
        "speaker": "Nigora",
        "de": "Und die Mülltonnen?",
        "uz": "Chiqindi qutilari-chi?"
      },
      {
        "speaker": "Hausmeister",
        "de": "Die sind im Hof, hinter dem Haus.",
        "uz": "Ular hovlida, uyning orqasida."
      },
      {
        "speaker": "Nigora",
        "de": "Danke! Und wo finde ich Sie, wenn es ein Problem gibt?",
        "uz": "Rahmat! Muammo bo'lsa sizni qayerdan topaman?"
      },
      {
        "speaker": "Hausmeister",
        "de": "Mein Büro ist im Erdgeschoss, neben dem Eingang.",
        "uz": "Xonam birinchi qavatda, kirish yonida."
      }
    ],
