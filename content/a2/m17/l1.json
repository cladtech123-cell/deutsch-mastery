        [
          "der (m)",
          "der / ein",
          "dem / einem",
          "Ich helfe dem Vermieter."
        ],
        [
          "die (f)",
          "die / eine",
          "der / einer",
          "Ich gebe der Vermieterin die Kaution."
        ],
        [
          "das (n)",
          "das / ein",
          "dem / einem",
          "Das Fahrrad gehört dem Kind."
        ],
        [
          "die (ko'plik)",
          "die / –",
          "den + -n",
          "Der Vermieter hilft den Mietern."
        ]
      ]
    },
    {
      "type": "table",
      "headers": [
        "ich",
        "du",
        "er / sie / es",
        "wir",
        "ihr",
        "sie / Sie"
