  "grammar": [
    {
      "topic_id": "g-imperative",
      "rule": "Rasmiy buyruq (Sie): fe'l (infinitiv shaklida) birinchi o'rinda, keyin Sie. Ajraladigan fe'lda old qo'shimcha gap oxiriga ketadi.",
      "when": "Yo'l ko'rsatganda, ko'rsatma yoki maslahat berganda (notanish odamga).",
      "structure": "Fe'l + Sie + ...: Gehen Sie geradeaus!\nAjraladigan fe'l: Biegen Sie an der Ampel links ab!",
      "examples": [
        {
          "de": "Gehen Sie geradeaus.",
          "uz": "To'g'riga yuring."
        },
        {
          "de": "Biegen Sie an der Ampel rechts ab.",
          "uz": "Svetoforda o'ngga buriling."
        },
        {
          "de": "Nehmen Sie die U-Bahn Linie 2.",
          "uz": "2-liniya metrosiga o'tiring."
        },
        {
          "de": "Überqueren Sie die Brücke.",
          "uz": "Ko'prikdan o'ting."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Sie gehen geradeaus!",
          "right": "Gehen Sie geradeaus!",
          "why": "Buyruqda fe'l birinchi o'rinda: Gehen Sie ..."
        },
        {
          "wrong": "Abbiegen Sie links!",
          "right": "Biegen Sie links ab!",
          "why": "Old qo'shimcha (ab) gap oxiriga ketadi."
        },
        {
          "wrong": "Geh Sie geradeaus!",
          "right": "Gehen Sie geradeaus!",
          "why": "Sie-buyruqda fe'l to'liq infinitiv shaklida: gehen."
        }
      ],
      "check": [
        "a1-m10-l3-e03",
        "a1-m10-l3-e04",
        "a1-m10-l3-e05",
        "a1-m10-l3-e10"
      ]
    }
  ],
  "listening": {
    "title": "Muzeyga yo'l",
    "lines": [
      {
        "speaker": "Rustam",
        "de": "Entschuldigung, wie komme ich zum Museum?",
        "uz": "Kechirasiz, muzeyga qanday borsam bo'ladi?"
      },
      {
        "speaker": "Frau Koch",
        "de": "Gehen Sie hier geradeaus bis zur Ampel.",
        "uz": "Shu yerdan svetoforgacha to'g'riga yuring."
      },
      {
        "speaker": "Frau Koch",
        "de": "An der Ampel biegen Sie links ab. Dann überqueren Sie die Brücke.",
        "uz": "Svetoforda chapga buriling. Keyin ko'prikdan o'ting."
      },
      {
        "speaker": "Rustam",
        "de": "Ist das weit?",
        "uz": "Uzoqmi?"
      },
      {
        "speaker": "Frau Koch",
        "de": "Nein, nur fünf Minuten zu Fuß. Das Museum ist gegenüber der Bibliothek.",
        "uz": "Yo'q, piyoda atigi besh daqiqa. Muzey kutubxonaning ro'parasida."
      },
      {
        "speaker": "Rustam",
        "de": "Vielen Dank!",
        "uz": "Katta rahmat!"
      }
    ],
    "questions": [
      "a1-m10-l3-e08",
      "a1-m10-l3-e09"
    ]
  },
  "situation": {
    "title": "Yo'l ko'rsating",
    "context_uz": "Siz Germaniyada yashaysiz. Ko'chada bir kishi sizdan vokzalga yo'l so'rayapti.",
    "lines": [
      {
        "speaker": "Mann",
        "de": "Entschuldigung, wie komme ich zum Bahnhof?",
        "uz": "Kechirasiz, vokzalga qanday borsam bo'ladi?"
      },
      {
        "speaker": "Siz",
        "de": "Gehen Sie zuerst geradeaus. An der Kreuzung biegen Sie rechts ab.",
        "uz": "Avval to'g'riga yuring. Chorrahada o'ngga buriling."
      },
      {
        "speaker": "Mann",
        "de": "Rechts, okay. Und dann?",
        "uz": "O'ngga, yaxshi. Keyin-chi?"
      },
      {
        "speaker": "Siz",
        "de": "Dann gehen Sie über die Brücke. Der Bahnhof ist links.",
        "uz": "Keyin ko'prikdan o'ting. Vokzal chap tomonda."
      },
      {
        "speaker": "Mann",
        "de": "Ist das weit?",
        "uz": "Uzoqmi?"
      },
      {
        "speaker": "Siz",
        "de": "Nein, es ist nah. Zehn Minuten zu Fuß.",
        "uz": "Yo'q, yaqin. Piyoda o'n daqiqa."
      },
      {
        "speaker": "Mann",
        "de": "Danke schön!",
        "uz": "Katta rahmat!"
      }
    ],
    "task_uz": "Uyingizdan eng yaqin bekat yoki do'kongacha bo'lgan yo'lni nemischa tushuntiring: kamida 3 ta buyruq (Gehen Sie ..., Biegen Sie ... ab, Überqueren Sie ...) va \"zuerst\", \"dann\" so'zlarini ishlating."
  },
