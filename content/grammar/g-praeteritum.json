    {
      "type": "p",
      "text": "dürfen → durfte, sollen → sollte. Modal fe'llarda umlaut yo'qoladi: können → konnte, müssen → musste. ich va er/sie/es shakllari bir xil."
    },
    {
      "type": "p",
      "text": "es gibt → es gab: Früher gab es hier einen Park."
    },
    {
      "type": "tip",
      "text": "hatte (edi) va hätte (bo'lardi), konnte (oldi edi) va könnte (olardi) — umlaut ma'noni o'zgartiradi!"
    }
  ],
  "examples": [
    {
      "de": "Gestern war ich krank.",
      "uz": "Kecha kasal edim."
    },
    {
      "de": "Wir hatten keine Zeit.",
      "uz": "Vaqtimiz yo'q edi."
    },
    {
      "de": "Am Samstag musste ich arbeiten.",
      "uz": "Shanba kuni ishlashim kerak edi."
    },
    {
      "de": "Früher wollte ich Pilot werden.",
      "uz": "Ilgari uchuvchi bo'lishni xohlardim."
    },
    {
      "de": "Wo warst du gestern Abend?",
      "uz": "Kecha kechqurun qayerda eding?"
    },
    {
      "de": "Ich konnte nicht schlafen.",
      "uz": "Uxlay olmadim."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Ich habe krank gewesen.",
      "right": "Ich war krank.",
      "why": "sein o'tgan zamonda odatda Präteritum: war."
    },
    {
      "wrong": "Er müsste gestern arbeiten.",
      "right": "Er musste gestern arbeiten.",
      "why": "müsste — Konjunktiv II (kerak bo'lardi). O'tgan zamon — musste."
    },
    {
      "wrong": "Wir hätten keine Zeit.",
      "right": "Wir hatten keine Zeit.",
      "why": "hätten — Konjunktiv II; o'tgan zamon — hatten."
    },
    {
      "wrong": "Ich warst müde.",
      "right": "Ich war müde.",
      "why": "ich bilan war (qo'shimchasiz)."
    }
  ],
