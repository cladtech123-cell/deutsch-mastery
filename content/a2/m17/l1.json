  "grammar": [
    {
      "topic_id": "g-dativ",
      "rule": "Dativ \"wem?\" (kimga?) savoliga javob beradi. Artikllar: der → dem, die → der, das → dem, ko'plik die → den (+n). Ba'zi fe'llar doim Dativ oladi: gefallen, gehören, helfen, danken, antworten.",
      "when": "Kimga nima yoqishi, nima kimga tegishli ekanini, kimga yordam berishni aytganda.",
      "structure": "Ega (Nom.) + gefällt/gehört + Dativ.  Masalan: Der Balkon gefällt meiner Frau.",
      "examples": [
        {
          "de": "Die Wohnung gefällt mir sehr.",
          "uz": "Kvartira menga juda yoqadi."
        },
        {
          "de": "Der Schlüssel gehört dem Vermieter.",
          "uz": "Kalit uy egasiga tegishli."
        },
        {
          "de": "Ich gebe der Vermieterin die Kaution.",
          "uz": "Garov pulini uy egasiga beraman."
        },
        {
          "de": "Der Hausmeister hilft den Mietern.",
          "uz": "Uy boshqaruvchisi ijarachilarga yordam beradi."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich gefalle die Wohnung.",
          "right": "Die Wohnung gefällt mir.",
          "why": "Nemis tilida yoqadigan narsa — ega, kimga yoqishi — Dativ (mir)."
        },
        {
          "wrong": "Das Fahrrad gehört der Vermieter.",
          "right": "Das Fahrrad gehört dem Vermieter.",
          "why": "\"der Vermieter\" erkak jinsi, Dativda \"dem\"."
        },
        {
          "wrong": "Die Küche gefällt ich nicht.",
          "right": "Die Küche gefällt mir nicht.",
          "why": "\"ich\" ning Dativ shakli — \"mir\"."
        }
      ],
      "check": [
        "a2-m17-l1-e02",
        "a2-m17-l1-e03",
        "a2-m17-l1-e04",
        "a2-m17-l1-e05",
        "a2-m17-l1-e10"
      ]
    }
  ],
  "listening": {
    "title": "Kvartirani ko'rish",
    "lines": [
      {
        "speaker": "Frau Brandt",
        "de": "Kommen Sie rein! Das ist die Wohnung: zwei Zimmer, Küche, Bad und ein kleiner Balkon.",
        "uz": "Kiring! Mana kvartira: ikki xona, oshxona, hammom va kichik balkon."
      },
      {
        "speaker": "Akmal",
        "de": "Sehr schön! Wie hoch ist die Miete?",
        "uz": "Juda chiroyli! Ijara haqi qancha?"
      },
      {
        "speaker": "Frau Brandt",
        "de": "Die Kaltmiete ist 650 Euro. Dazu kommen 150 Euro Nebenkosten.",
        "uz": "Sof ijara 650 yevro. Unga 150 yevro qo'shimcha xarajatlar qo'shiladi."
      },
      {
        "speaker": "Akmal",
        "de": "Also 800 Euro warm. Und die Kaution?",
        "uz": "Demak, jami 800 yevro. Garov puli-chi?"
      },
      {
        "speaker": "Frau Brandt",
        "de": "Drei Monatsmieten, also 1950 Euro.",
        "uz": "Uch oylik ijara, ya'ni 1950 yevro."
      },
      {
        "speaker": "Akmal",
        "de": "Gehört der Keller auch zur Wohnung?",
        "uz": "Yerto'la ham kvartiraga tegishlimi?"
      },
      {
        "speaker": "Frau Brandt",
        "de": "Ja, Sie haben einen Kellerraum. Gefällt Ihnen die Wohnung?",
        "uz": "Ha, sizda yerto'la xonasi bor. Kvartira sizga yoqdimi?"
      },
      {
        "speaker": "Akmal",
        "de": "Ja, sie gefällt mir sehr!",
        "uz": "Ha, menga juda yoqdi!"
      }
    ],
