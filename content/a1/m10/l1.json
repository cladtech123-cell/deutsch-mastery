          "park, bog'",
          "spazieren gehen"
        ],
        [
          "der Bahnhof",
          "vokzal",
          "Fahrkarten kaufen"
        ]
      ]
    },
    {
      "type": "p",
      "text": "\"können\" — qila olmoq, mumkin bo'lmoq. U ham möchten kabi modal fe'l: ikkinchi fe'l infinitivda gap oxiriga o'tadi. \"man kann\" — \"... mumkin\" (umumiy ma'noda)."
    },
    {
      "type": "table",
      "headers": [
        "Shaxs",
        "können"
      ],
