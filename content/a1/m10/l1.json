  "grammar": [
    {
      "topic_id": "g-modal-verbs",
      "rule": "können — qobiliyat (qila olaman), imkoniyat (mumkin) va muloyim iltimosni bildiradi. Ikkinchi fe'l infinitivda gap oxirida turadi.",
      "when": "Biror joyda nima qilish mumkinligini, nima qila olishingizni aytganda va yordam so'raganda.",
      "structure": "Ega + kann/kannst/können + ... + infinitiv (oxirida):\nIn der Bank kann man Geld wechseln.\nSavol: Können Sie mir helfen?",
      "examples": [
        {
          "de": "In der Apotheke kann man Medikamente kaufen.",
          "uz": "Dorixonada dori sotib olish mumkin."
        },
        {
          "de": "Ich kann gut Deutsch sprechen.",
          "uz": "Men nemischa yaxshi gapira olaman."
        },
        {
          "de": "Kannst du mir helfen?",
          "uz": "Menga yordam bera olasanmi?"
        },
        {
          "de": "Wo kann ich hier Fahrkarten kaufen?",
          "uz": "Bu yerda chiptani qayerdan olsam bo'ladi?"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Er kannt gut kochen.",
          "right": "Er kann gut kochen.",
          "why": "er/sie/es bilan \"kann\" — oxiriga -t qo'shilmaydi."
        },
        {
          "wrong": "Ich kann kaufen Brot.",
          "right": "Ich kann Brot kaufen.",
          "why": "Ikkinchi fe'l (kaufen) gap oxiriga o'tadi."
        },
        {
          "wrong": "Du kann hier parken.",
          "right": "Du kannst hier parken.",
          "why": "du bilan -st: kannst."
        }
      ],
      "check": [
        "a1-m10-l1-e04",
        "a1-m10-l1-e05",
        "a1-m10-l1-e06",
        "a1-m10-l1-e09"
      ]
    }
  ],
  "listening": {
    "title": "Turist savollari",
    "lines": [
      {
        "speaker": "Tourist",
        "de": "Entschuldigung, gibt es hier eine Apotheke?",
        "uz": "Kechirasiz, bu yerda dorixona bormi?"
      },
      {
        "speaker": "Frau Lang",
        "de": "Ja, die Apotheke ist am Marktplatz, neben der Bank.",
        "uz": "Ha, dorixona bozor maydonida, bankning yonida."
      },
      {
        "speaker": "Tourist",
        "de": "Und wo kann ich Briefmarken kaufen?",
        "uz": "Pochta markasini qayerdan sotib olsam bo'ladi?"
      },
      {
        "speaker": "Frau Lang",
        "de": "Briefmarken können Sie bei der Post kaufen. Die Post ist neben dem Bahnhof.",
        "uz": "Markani pochtadan olishingiz mumkin. Pochta vokzalning yonida."
      },
      {
        "speaker": "Tourist",
        "de": "Vielen Dank! Und gibt es hier auch ein Museum?",
        "uz": "Katta rahmat! Bu yerda muzey ham bormi?"
      },
      {
        "speaker": "Frau Lang",
        "de": "Ja, das Stadtmuseum. Dort kann man viel über die Stadt lernen.",
        "uz": "Ha, shahar muzeyi. U yerda shahar haqida ko'p narsa bilib olish mumkin."
      }
    ],
