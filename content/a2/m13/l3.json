  "grammar": [
    {
      "topic_id": "g-perfekt",
      "rule": "Nomuntazam (kuchli) fe'llar Partizip II ni \"ge- ... -en\" bilan yasaydi va ko'pincha unli o'zgaradi (treffen → getroffen). \"ver-\" bilan boshlansa \"ge-\" yo'q (verloren, vergessen). Aralash fe'llar: bringen → gebracht.",
      "when": "Hikoya, tajriba va kutilmagan voqealarni aytib berganda.",
      "structure": "Subyekt + haben/sein + ... + ge...en.  Masalan: Ich habe Anna getroffen.",
      "examples": [
        {
          "de": "Wir haben im Restaurant Plov gegessen.",
          "uz": "Biz restoranda palov yedik."
        },
        {
          "de": "Ich habe meinen Schlüssel verloren.",
          "uz": "Kalitimni yo'qotib qo'ydim."
        },
        {
          "de": "Hast du meine Nachricht vergessen?",
          "uz": "Xabarimni unutdingmi?"
        },
        {
          "de": "Mein Kollege hat Kuchen ins Büro gebracht.",
          "uz": "Hamkasbim ofisga pirog olib keldi."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich habe meinen Schlüssel geverloren.",
          "right": "Ich habe meinen Schlüssel verloren.",
          "why": "\"ver-\" bilan boshlanadigan fe'llarga \"ge-\" qo'shilmaydi."
        },
        {
          "wrong": "Ich habe Lena getrefft.",
          "right": "Ich habe Lena getroffen.",
          "why": "\"treffen\" nomuntazam fe'l: -en bilan tugaydi va e → o o'zgaradi."
        },
        {
          "wrong": "Er hat Blumen gebringt.",
          "right": "Er hat Blumen gebracht.",
          "why": "\"bringen\" — aralash fe'l: o'zak o'zgaradi (brach-), lekin oxiri -t."
        }
      ],
      "check": [
        "a2-m13-l3-e02",
        "a2-m13-l3-e03",
        "a2-m13-l3-e04",
        "a2-m13-l3-e08"
      ]
    },
    {
      "topic_id": "g-verb-position",
      "rule": "Hikoyadagi bog'lovchi ravishlar (zuerst, dann, danach, plötzlich, zum Schluss) 1-o'rinni egallaydi. Shundan keyin darhol tuslangan fe'l (habe/bin) keladi, keyin subyekt.",
      "when": "Voqealarni ketma-ket aytib berganda.",
      "structure": "Zuerst + habe/bin + ich + ... + Partizip II.",
      "examples": [
        {
          "de": "Zuerst habe ich gefrühstückt.",
          "uz": "Avval nonushta qildim."
        },
        {
          "de": "Dann bin ich zur Arbeit gefahren.",
          "uz": "Keyin ishga bordim."
        },
        {
          "de": "Plötzlich hat mein Handy geklingelt.",
          "uz": "Birdan telefonim jiringladi."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Zuerst ich habe gefrühstückt.",
          "right": "Zuerst habe ich gefrühstückt.",
          "why": "Fe'l doim 2-o'rinda: \"Zuerst\" 1-o'rin, \"habe\" 2-o'rin, keyin \"ich\"."
        },
        {
          "wrong": "Dann ich bin gefahren.",
          "right": "Dann bin ich gefahren.",
          "why": "O'zbek tilida \"Keyin men bordim\" deyiladi, nemis tilida esa fe'l subyektdan oldin keladi."
        }
      ],
      "check": [
        "a2-m13-l3-e05"
      ]
    }
