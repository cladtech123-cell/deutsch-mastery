  "situation": {
    "title": "Birga ovqat pishiramiz",
    "context_uz": "Siz nemis kursdoshingiz Sarah bilan bir kvartirada yashaysiz. Bugun kechqurun birga ovqat pishirmoqchisiz va xarid ro'yxatini tuzyapsiz.",
    "lines": [
