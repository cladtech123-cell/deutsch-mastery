  "review_vocabulary": [],
  "grammar": [
    {
      "topic_id": "g-sein-haben",
      "rule": "O'zingizni tanishtirish uchun \"Ich bin\" + ism ishlatiladi. \"bin\" — \"sein\" (bo'lmoq) fe'lining \"ich\" shakli.",
      "when": "Tanishganda, o'zingizni aytganda: \"Men ...man\".",
      "structure": "Ich + bin + ism.  Masalan: Ich bin Anna.",
      "examples": [
        {
          "de": "Ich bin Anna.",
          "uz": "Men Annaman."
        },
        {
          "de": "Hallo, ich bin Tom.",
          "uz": "Salom, men Tomman."
        },
        {
          "de": "Guten Tag, ich bin Frau Schmidt.",
          "uz": "Assalomu alaykum, men Shmidt xonimman."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich Anna.",
          "right": "Ich bin Anna.",
          "why": "O'zbek tilida \"Men Annaman\" deyiladi, lekin nemis tilida fe'l (bin) tushib qolmaydi."
        },
        {
          "wrong": "Ich ist Anna.",
          "right": "Ich bin Anna.",
          "why": "\"ist\" — u (er/sie) uchun. \"ich\" bilan faqat \"bin\"."
        }
      ],
      "check": [
        "a1-m01-l1-e03",
        "a1-m01-l1-e04"
      ]
    }
  ],
