  "writing_task": {
    "id": "w-a1-m09",
    "title": "Mening uyim",
    "task_uz": "Uyingiz yoki kvartirangizni tasvirlang: nechta xona va qanday xonalar bor, har bir xonada nima bor (es gibt), mebellar qayerda turadi (auf/neben/im ...), qaysi xona sizga eng yoqadi.",
    "required_words": [
      "gibt",
      "Zimmer"
    ],
    "min_words": 40,
    "max_words": 90,
    "criteria": [
      "Xonalar soni va nomlari bor",
      "Kamida 3 marta \"es gibt\" + Akkusativ (einen/eine/ein)",
      "Kamida 2 ta joy ifodasi (auf dem, neben der, im ...)",
      "Sifatlar: hell, dunkel, groß, klein, gemütlich",
      "Egalik so'zi: mein/meine/unser/unsere",
      "Fe'l 2-o'rinda (Im Zimmer gibt es ...)"
    ],
    "sample_answer": "Meine Wohnung ist in Taschkent. Sie hat drei Zimmer, eine Küche und ein Bad. Das Wohnzimmer ist groß und hell. Dort gibt es ein Sofa, einen Tisch und einen Teppich. Der Teppich liegt auf dem Boden. Mein Zimmer ist klein, aber gemütlich. Es gibt ein Bett, einen Schrank und ein Regal. Der Tisch steht neben dem Fenster. Wir haben keinen Garten, aber unser Balkon ist schön."
  }
