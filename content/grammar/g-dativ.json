      ],
      "rows": [
        [
          "aus",
          "-dan (ichidan, qayerdan)",
          "Ich komme aus der Türkei."
        ],
        [
          "bei",
          "yonida, -nikida, -da",
          "Ich wohne bei meiner Tante."
        ],
        [
          "mit",
          "bilan",
          "Ich fahre mit dem Bus."
        ],
        [
          "nach",
          "-ga (shahar, mamlakat); keyin",
          "nach Berlin, nach dem Essen"
        ],
        [
          "seit",
          "... dan beri",
          "seit einem Jahr"
        ],
        [
          "von",
          "-dan",
          "Das Geschenk ist von meinem Freund."
        ],
        [
          "zu",
          "-ga (odam, muassasa)",
          "Ich gehe zum Arzt."
        ]
      ]
    },
    {
      "type": "p",
      "text": "Qisqartmalar: zu dem = zum, zu der = zur, von dem = vom, bei dem = beim. Ko'plikdagi ot Dativda -n oladi: mit den Kindern."
    },
    {
      "type": "tip",
      "text": "O'zbekchadagi \"-ga\" ko'pincha Dativga to'g'ri keladi: \"bolaga beraman\" — Ich gebe dem Kind ... helfen ham Dativ: Ich helfe dir (senga yordam beraman)."
    }
  ],
  "examples": [
    {
      "de": "Ich fahre mit dem Bus zur Arbeit.",
      "uz": "Ishga avtobusda boraman."
    },
    {
      "de": "Ich gebe meiner Mutter eine Blume.",
      "uz": "Onamga gul beraman."
    },
    {
      "de": "Das Buch gehört dem Lehrer.",
      "uz": "Kitob o'qituvchiniki."
    },
    {
      "de": "Nach dem Unterricht gehe ich zum Arzt.",
      "uz": "Darsdan keyin shifokorga boraman."
    },
    {
      "de": "Ich wohne seit einem Jahr bei meinem Onkel.",
      "uz": "Bir yildan beri amakimnikida yashayman."
    },
    {
      "de": "Die Suppe schmeckt den Kindern.",
      "uz": "Sho'rva bolalarga yoqadi."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "mit der Bus",
      "right": "mit dem Bus",
      "why": "mit + Dativ; der Bus → dem Bus."
    },
    {
      "wrong": "Ich fahre zu Berlin.",
      "right": "Ich fahre nach Berlin.",
      "why": "Shahar va mamlakatga — nach, odam va muassasaga — zu."
    },
    {
      "wrong": "mit meinen Freunde",
      "right": "mit meinen Freunden",
      "why": "Ko'plik Dativda ot -n oladi."
    },
    {
      "wrong": "Ich helfe dich.",
      "right": "Ich helfe dir.",
      "why": "helfen Dativ talab qiladi."
    }
  ],
