    "id": "w-a1-m01",
    "title": "O'zingizni tanishtiring",
    "task_uz": "Nemis tili kursiga qisqa xat yozing: salomlashing, ismingiz va familiyangizni yozing, familiyangizni harflab bering va rasmiy xayrlashing.",
    "required_words": [
      "heiße"
    ],
    "min_words": 15,
    "max_words": 50,
    "criteria": [
      "Rasmiy salomlashish bor (Guten Tag / Guten Morgen).",
      "\"Ich heiße ...\" yoki \"Mein Name ist ...\" bilan ism yozilgan.",
      "Familiya harflab berilgan (K – A – R – I – M – O – V).",
      "Rasmiy xayrlashish bor (Auf Wiedersehen).",
      "Ismlar va otlar katta harf bilan yozilgan."
    ],
    "sample_answer": "Guten Tag! Ich heiße Aziz Karimov. Mein Vorname ist Aziz: A – Z – I – Z. Mein Nachname ist Karimov: K – A – R – I – M – O – V. Danke! Auf Wiedersehen!"
  }
