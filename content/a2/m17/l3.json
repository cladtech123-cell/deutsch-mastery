  "grammar": [
    {
      "topic_id": "g-dativ",
      "rule": "mit, aus, bei, nach, seit, von, zu — bu predloglardan keyin doim Dativ keladi. zu + dem = zum, zu + der = zur, bei + dem = beim, von + dem = vom.",
      "when": "Muammo bilan bog'liq narsalarni, kimning oldiga borishni, qachondan beri ekanini aytganda.",
      "structure": "Predlog + dem / der / dem / den(+n).  Masalan: Ich habe ein Problem mit der Heizung.",
      "examples": [
        {
          "de": "Ich habe ein Problem mit der Heizung.",
          "uz": "Isitish bilan muammom bor."
        },
        {
          "de": "Seit einer Woche tropft der Wasserhahn.",
          "uz": "Bir haftadan beri jo'mrak tomchilayapti."
        },
        {
          "de": "Ich gehe morgen zum Hausmeister.",
          "uz": "Ertaga uy boshqaruvchisi oldiga boraman."
        },
        {
          "de": "Der Lärm kommt aus der Wohnung über uns.",
          "uz": "Shovqin tepamizdagi kvartiradan kelyapti."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich habe ein Problem mit die Heizung.",
          "right": "Ich habe ein Problem mit der Heizung.",
          "why": "\"mit\" doim Dativ: die Heizung → der Heizung."
        },
        {
          "wrong": "Ich gehe zu der Hausmeister.",
          "right": "Ich gehe zum Hausmeister.",
          "why": "der Hausmeister → Dativ dem; zu + dem = zum."
        },
        {
          "wrong": "seit eine Woche",
          "right": "seit einer Woche",
          "why": "\"seit\" + Dativ: eine → einer."
        }
      ],
      "check": [
        "a2-m17-l3-e02",
        "a2-m17-l3-e03",
        "a2-m17-l3-e04"
      ]
    }
  ],
