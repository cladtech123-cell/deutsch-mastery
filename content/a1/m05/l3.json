  "grammar": [
    {
      "topic_id": "g-verb-position",
      "rule": "Darak gapda tuslangan fe'l doim ikkinchi o'rinda turadi. Gap vaqt so'zi (heute, morgen, dann ...) bilan boshlansa, ega fe'ldan keyin keladi (inversiya).",
      "when": "Har qanday darak gapda; ayniqsa kun tartibi, rejalar va ketma-ket harakatlar haqida gapirganda.",
      "structure": "1-o'rin (ega / vaqt / joy) + FE'L + ega (agar 1-o'rinda bo'lmasa) + qolgan qism",
      "examples": [
        {
          "de": "Ich arbeite heute im Büro.",
          "uz": "Men bugun ofisda ishlayman."
        },
        {
          "de": "Heute arbeite ich im Büro.",
          "uz": "Bugun men ofisda ishlayman."
        },
        {
          "de": "Zuerst schreibe ich E-Mails, dann telefoniere ich.",
          "uz": "Avval email yozaman, keyin qo'ng'iroq qilaman."
        },
        {
          "de": "Morgen fährt meine Kollegin nach Hamburg.",
          "uz": "Ertaga hamkasbim Gamburgga ketadi."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Heute ich arbeite im Büro.",
          "right": "Heute arbeite ich im Büro.",
          "why": "Vaqt so'zi birinchi o'rinda bo'lsa, fe'l ikkinchi, ega uchinchi o'ringa o'tadi."
        },
        {
          "wrong": "Ich im Büro arbeite.",
          "right": "Ich arbeite im Büro.",
          "why": "O'zbekchadagidek fe'lni oxiriga qo'yib bo'lmaydi — u ikkinchi o'rinda."
        },
        {
