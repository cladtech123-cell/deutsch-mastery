      },
      {
        "speaker": "Kasse",
        "de": "Es gibt eine Verbindung um 9.12 Uhr. Sie steigen in Nürnberg um.",
        "uz": "Soat 9:12 da reys bor. Nyurnbergda boshqa poyezdga o'tasiz."
      },
      {
        "speaker": "Frau Usmonova",
        "de": "Und wann komme ich in München an?",
        "uz": "Myunxenga qachon yetib boraman?"
      },
      {
        "speaker": "Kasse",
        "de": "Um 13.40 Uhr. Der Zug fährt von Gleis 7 ab.",
        "uz": "Soat 13:40 da. Poyezd 7-yo'ldan jo'naydi."
      },
      {
        "speaker": "Frau Usmonova",
        "de": "Gut. Eine Fahrkarte hin und zurück, bitte.",
        "uz": "Yaxshi. Bitta borish-qaytish chiptasi, iltimos."
      }
    ],
