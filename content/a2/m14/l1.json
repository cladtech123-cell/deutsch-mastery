  "grammar": [
    {
      "topic_id": "g-polite-requests",
      "rule": "Xohish va iltimosni muloyim aytish uchun \"Ich hätte gern + Akkusativ\" yoki \"Ich möchte + ... + Infinitiv (oxirida)\" ishlatiladi. Savol: \"Haben Sie ...?\", \"Gibt es ...?\".",
      "when": "Mehmonxona, restoran, kassa, ofis — notanish odamlar bilan rasmiy vaziyatlarda.",
      "structure": "Ich hätte gern + ein/einen/eine + ot.  Ich möchte + ot + Infinitiv.  Gibt es + Akkusativ?",
      "examples": [
        {
          "de": "Ich hätte gern ein Doppelzimmer mit Balkon.",
          "uz": "Menga balkonli ikki kishilik xona kerak edi."
        },
        {
          "de": "Ich möchte zwei Nächte bleiben.",
          "uz": "Ikki kecha qolmoqchiman."
        },
        {
          "de": "Gibt es einen Parkplatz am Hotel?",
          "uz": "Mehmonxona yonida avtoturargoh bormi?"
        },
        {
          "de": "Haben Sie noch ein Einzelzimmer frei?",
          "uz": "Yana bo'sh bir kishilik xonangiz bormi?"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich will ein Zimmer.",
          "right": "Ich hätte gern ein Zimmer.",
          "why": "\"Ich will\" buyruqdek, qo'pol eshitiladi. Rasmiy vaziyatda \"Ich hätte gern\" yoki \"Ich möchte\"."
        },
        {
          "wrong": "Ich möchte buchen ein Zimmer.",
          "right": "Ich möchte ein Zimmer buchen.",
          "why": "Modal fe'l bilan ikkinchi fe'l (Infinitiv) gap oxiriga o'tadi."
        },
        {
          "wrong": "Ich hätte gern einen Doppelzimmer.",
          "right": "Ich hätte gern ein Doppelzimmer.",
          "why": "\"Zimmer\" — das, Akkusativda o'zgarmaydi: ein Doppelzimmer."
        }
      ],
      "check": [
        "a2-m14-l1-e03",
        "a2-m14-l1-e04",
        "a2-m14-l1-e05"
      ]
    }
  ],
  "listening": {
    "title": "Telefon orqali bron",
    "lines": [
      {
        "speaker": "Hotel",
        "de": "Hotel Lindenhof, guten Tag! Was kann ich für Sie tun?",
        "uz": "Lindenhof mehmonxonasi, assalomu alaykum! Sizga qanday yordam bera olaman?"
      },
      {
        "speaker": "Herr Rahimov",
        "de": "Guten Tag! Ich möchte ein Doppelzimmer für drei Nächte reservieren.",
        "uz": "Assalomu alaykum! Uch kechaga ikki kishilik xona band qilmoqchiman."
      },
      {
        "speaker": "Hotel",
        "de": "Gern. Ab wann?",
        "uz": "Mamnuniyat bilan. Qachondan boshlab?"
      },
      {
        "speaker": "Herr Rahimov",
        "de": "Ab Freitag. Was kostet eine Übernachtung?",
        "uz": "Jumadan. Bir kecha qancha turadi?"
      },
      {
        "speaker": "Hotel",
        "de": "95 Euro pro Nacht. Das Frühstück ist inklusive.",
        "uz": "Bir kechaga 95 yevro. Nonushta narxga kiritilgan."
      },
      {
        "speaker": "Herr Rahimov",
        "de": "Sehr gut. Gibt es auch WLAN?",
        "uz": "Juda yaxshi. Wi-Fi ham bormi?"
      },
      {
        "speaker": "Hotel",
        "de": "Ja, natürlich, kostenlos.",
        "uz": "Ha, albatta, bepul."
      }
    ],
