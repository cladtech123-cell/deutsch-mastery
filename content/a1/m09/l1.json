  "grammar": [
    {
      "topic_id": "g-possessive",
      "rule": "Egalik so'zi otning jinsiga moslashadi: der/das oldida — mein, dein, sein, ihr, unser, euer, Ihr; die va ko'plik oldida -e qo'shiladi: meine, seine, unsere, eure.",
      "when": "Kimning uyi, xonasi yoki narsasi ekanini aytganda.",
      "structure": "mein/unser + der/das ot: unser Balkon, mein Zimmer\nmeine/unsere + die ot yoki ko'plik: unsere Wohnung, meine Zimmer",
      "examples": [
        {
          "de": "Das ist unsere Wohnung.",
          "uz": "Bu bizning kvartiramiz."
        },
        {
          "de": "Sein Zimmer ist klein.",
          "uz": "Uning (o'g'il bolaning) xonasi kichik."
        },
        {
          "de": "Ist das Ihr Garten, Frau Weber?",
          "uz": "Bu Sizning bog'ingizmi, Veber xonim?"
        },
        {
          "de": "Eure Küche ist sehr gemütlich!",
          "uz": "Sizlarning oshxonangiz juda shinam!"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Unser Wohnung ist groß.",
          "right": "Unsere Wohnung ist groß.",
          "why": "Wohnung — die, shuning uchun -e qo'shiladi: unsere."
        },
        {
          "wrong": "Anna zeigt sein Zimmer.",
          "right": "Anna zeigt ihr Zimmer.",
          "why": "Anna — ayol, shuning uchun \"ihr\" (uning). \"sein\" — egasi erkak bo'lganda."
        },
        {
          "wrong": "Euere Küche ist schön.",
          "right": "Eure Küche ist schön.",
          "why": "euer + -e → eure (o'rtadagi e tushib qoladi)."
        }
      ],
      "check": [
        "a1-m09-l1-e04",
        "a1-m09-l1-e05",
        "a1-m09-l1-e06",
        "a1-m09-l1-e10"
      ]
    }
  ],
  "listening": {
    "title": "Yangi kvartira",
    "lines": [
      {
        "speaker": "Zarina",
        "de": "Hallo Ali! Wie ist deine neue Wohnung?",
        "uz": "Salom Ali! Yangi kvartirang qanday?"
      },
      {
        "speaker": "Ali",
        "de": "Sie ist super! Sie hat zwei Zimmer, eine Küche und ein Bad.",
        "uz": "Zo'r! Ikki xona, oshxona va hammom bor."
      },
      {
        "speaker": "Zarina",
        "de": "Ist die Wohnung hell?",
        "uz": "Kvartira yorug'mi?"
      },
      {
        "speaker": "Ali",
        "de": "Ja, das Wohnzimmer ist sehr hell. Aber das Schlafzimmer ist ein bisschen dunkel.",
        "uz": "Ha, mehmonxona juda yorug'. Lekin yotoqxona biroz qorong'i."
      },
      {
        "speaker": "Zarina",
        "de": "Und hat die Wohnung einen Balkon?",
        "uz": "Kvartiraning balkoni bormi?"
      },
      {
        "speaker": "Ali",
        "de": "Ja, und der Balkon ist groß!",
        "uz": "Ha, balkoni ham katta!"
      },
      {
        "speaker": "Zarina",
        "de": "Und die Miete?",
        "uz": "Ijara haqi-chi?"
      },
      {
        "speaker": "Ali",
        "de": "Die Miete ist 650 Euro. Das ist günstig für München.",
        "uz": "Ijara 650 evro. Myunxen uchun bu arzon."
      }
    ],
    "questions": [
      "a1-m09-l1-e07",
      "a1-m09-l1-e08"
    ]
  },
  "situation": {
    "title": "Uyimga xush kelibsiz",
    "context_uz": "Nemis kursdoshingiz Julia birinchi marta uyingizga keldi. Siz unga kvartirani ko'rsatyapsiz.",
    "lines": [
      {
        "speaker": "Julia",
        "de": "Wow, deine Wohnung ist schön! Wie viele Zimmer hat sie?",
        "uz": "Voy, kvartirang chiroyli ekan! Nechta xonasi bor?"
      },
      {
        "speaker": "Siz",
        "de": "Drei Zimmer. Das ist mein Zimmer, und das ist das Zimmer von Timur.",
        "uz": "Uchta xona. Bu mening xonam, bu esa Timurning xonasi."
      },
      {
        "speaker": "Julia",
        "de": "Und die Küche?",
        "uz": "Oshxona-chi?"
      },
      {
        "speaker": "Siz",
        "de": "Hier. Unsere Küche ist klein, aber gemütlich.",
        "uz": "Mana. Oshxonamiz kichik, lekin shinam."
      },
      {
        "speaker": "Julia",
        "de": "Habt ihr auch einen Balkon?",
        "uz": "Balkoningiz ham bormi?"
      },
      {
        "speaker": "Siz",
        "de": "Nein, wir haben keinen Balkon. Aber wir haben einen Garten!",
        "uz": "Yo'q, balkonimiz yo'q. Lekin bog'imiz bor!"
      }
    ],
    "task_uz": "Do'stingizga o'z uyingizni (yoki orzuingizdagi uyni) tasvirlab bering: nechta xona, qanday xonalar, ular qanday (hell, dunkel, groß, klein, gemütlich). Kamida 2 marta \"mein/meine\" yoki \"unser/unsere\" ishlating."
  },
