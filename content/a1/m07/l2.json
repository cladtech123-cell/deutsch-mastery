  "grammar": [
    {
      "topic_id": "g-akkusativ",
      "rule": "Fe'l harakati qaratilgan ot (\"nimani?\") Akkusativda turadi. Faqat erkak jinsida artikl o'zgaradi: der → den, ein → einen. die, das va ko'plik o'zgarmaydi.",
      "when": "brauchen, nehmen, kochen, kaufen, essen, trinken, mögen, haben fe'llaridan keyingi to'ldiruvchida.",
      "structure": "Ega + fe'l + den/einen + erkak jinsli ot: Ich brauche einen Fisch.\nEga + fe'l + die/eine, das/ein: Ich nehme eine Banane. Wir kochen ein Hähnchen.",
      "examples": [
        {
          "de": "Ich brauche einen Fisch.",
          "uz": "Menga bitta baliq kerak."
        },
        {
          "de": "Wir kochen ein Hähnchen.",
          "uz": "Biz tovuq pishiramiz."
        },
        {
          "de": "Nimmst du den Kuchen?",
          "uz": "Pirogni olasanmi?"
        },
        {
          "de": "Sie kauft eine Banane und einen Apfel.",
          "uz": "U bitta banan va bitta olma sotib oladi."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich brauche ein Fisch.",
          "right": "Ich brauche einen Fisch.",
          "why": "Fisch — der (erkak jinsi). Akkusativda \"ein\" → \"einen\"."
        },
        {
          "wrong": "Ich nehme einen Banane.",
          "right": "Ich nehme eine Banane.",
          "why": "Banane — die (ayol jinsi). Ayol jinsida Akkusativ o'zgarmaydi: eine."
        },
        {
          "wrong": "Der Kuchen nehme ich.",
          "right": "Ich nehme den Kuchen.",
          "why": "Olinadigan narsa Akkusativda turadi: den Kuchen. \"der\" faqat ega bo'lganda ishlatiladi."
        }
      ],
      "check": [
        "a1-m07-l2-e03",
        "a1-m07-l2-e04",
        "a1-m07-l2-e05",
        "a1-m07-l2-e09",
        "a1-m07-l2-e11"
      ]
    }
  ],
