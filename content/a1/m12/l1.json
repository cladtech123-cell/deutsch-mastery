        "de": "Hast du Fieber?",
        "uz": "Isitmang bormi?"
      },
      {
        "speaker": "Timur",
        "de": "Ja, ich glaube, 38,5 Grad.",
        "uz": "Ha, menimcha, 38,5 daraja."
      },
      {
        "speaker": "Mutter",
        "de": "Und dein Bauch?",
        "uz": "Qorning-chi?"
      },
      {
        "speaker": "Timur",
        "de": "Nein, mein Bauch tut nicht weh.",
        "uz": "Yo'q, qornim og'rimayapti."
      },
      {
        "speaker": "Mutter",
        "de": "Dann bleibst du heute zu Hause.",
        "uz": "Unda bugun uyda qolasan."
      }
    ],
