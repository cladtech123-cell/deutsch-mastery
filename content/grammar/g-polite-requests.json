          "Würden Sie bitte das Fenster schließen?"
        ],
        [
          "Ich hätte gern ...",
          "buyurtma, xarid",
          "Ich hätte gern ein Kilo Tomaten."
        ],
        [
          "Ich würde gern ...",
          "istak",
          "Ich würde gern am Montag kommen."
        ],
        [
          "Darf ich ...? / Dürfte ich ...?",
          "ruxsat so'rash",
          "Darf ich das Fenster öffnen?"
        ]
      ]
    },
    {
      "type": "table",
      "headers": [
        "Olmosh",
        "können → könnte",
        "werden → würde",
        "haben → hätte"
      ],
      "rows": [
        [
