  "situation": {
    "title": "Qabulxonada ro'yxatdan o'tish",
    "context_uz": "Siz Myunxendagi mehmonxonaga keldingiz. Xonani internet orqali bron qilgansiz. Qabulxonadagi xodim bilan gaplashyapsiz.",
    "lines": [
      {
        "speaker": "Rezeption",
        "de": "Guten Abend! Haben Sie eine Reservierung?",
        "uz": "Xayrli kech! Bron qilganmisiz?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, auf den Namen Karimova. Ich habe ein Einzelzimmer gebucht.",
        "uz": "Ha, Karimova nomiga. Bir kishilik xona bron qilganman."
      },
      {
        "speaker": "Rezeption",
        "de": "Einen Moment ... Ja, zwei Nächte. Bitte füllen Sie das Formular aus.",
        "uz": "Bir daqiqa... Ha, ikki kecha. Iltimos, blankani to'ldiring."
      },
      {
        "speaker": "Siz",
        "de": "Gern. Ist das Frühstück inklusive?",
        "uz": "Mayli. Nonushta narxga kiritilganmi?"
      },
      {
        "speaker": "Rezeption",
        "de": "Ja, von 7 bis 10 Uhr. Hier ist Ihr Schlüssel. Der Aufzug ist links.",
        "uz": "Ha, soat 7 dan 10 gacha. Mana kalitingiz. Lift chap tomonda."
      },
      {
        "speaker": "Siz",
        "de": "Vielen Dank!",
        "uz": "Katta rahmat!"
      }
    ],
    "task_uz": "Dialogni rol bo'yicha o'qing. Keyin o'zgartiring: siz ikki kishilik xonani 3 kechaga bron qilgansiz va Wi-Fi haqida so'raysiz."
  },
