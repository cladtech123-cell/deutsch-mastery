        ]
      ]
    },
    {
      "type": "tip",
      "text": "O'zbekcha \"mening ... bor\" / \"menda ... bor\" → nemischa \"ich habe ...\". Ega — \"ich\", \"mein\" emas."
    }
  ],
  "examples": [
    {
      "de": "Ich bin Dilnoza und ich bin Studentin.",
      "uz": "Men Dilnozaman, talabaman."
    },
    {
      "de": "Bist du müde?",
      "uz": "Charchadingmi?"
    },
    {
      "de": "Mein Bruder ist 25 Jahre alt.",
      "uz": "Akam 25 yoshda."
    },
    {
      "de": "Wir haben zwei Kinder.",
      "uz": "Bizning ikki farzandimiz bor."
    },
    {
      "de": "Hast du heute Zeit?",
      "uz": "Bugun vaqting bormi?"
    },
    {
      "de": "Sie hat Kopfschmerzen.",
      "uz": "Uning boshi og'riyapti."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Ich habe 20 Jahre.",
      "right": "Ich bin 20 Jahre alt.",
      "why": "Yosh \"sein\" bilan aytiladi: ... Jahre alt."
    },
    {
      "wrong": "Ich Student.",
      "right": "Ich bin Student.",
      "why": "O'zbekchadagi \"-man\" qo'shimchasi o'rniga nemischada fe'l (bin) kerak."
    },
    {
      "wrong": "Du hat ein Auto.",
      "right": "Du hast ein Auto.",
      "why": "du bilan haben → hast."
    },
    {
      "wrong": "Mein ist ein Auto.",
      "right": "Ich habe ein Auto.",
      "why": "\"Mening mashinam bor\" = Ich habe ein Auto."
    }
  ],
