  "listening": {
    "title": "Video qo'ng'iroq",
    "lines": [
      {
        "speaker": "Anna",
        "de": "Hallo Malika! Wer ist das neben dir?",
        "uz": "Salom, Malika! Yoningdagi kim?"
      },
      {
        "speaker": "Malika",
        "de": "Das ist mein Mann Jasur. Und das sind unsere Kinder.",
        "uz": "Bu erim Jasur. Bular esa bolalarimiz."
      },
      {
        "speaker": "Anna",
        "de": "Wie heißen eure Kinder?",
        "uz": "Bolalaringizning ismi nima?"
      },
      {
        "speaker": "Malika",
        "de": "Unsere Tochter heißt Lola und unser Sohn heißt Ali.",
        "uz": "Qizimizning ismi Lola, o'g'limizning ismi Ali."
      },
      {
        "speaker": "Anna",
        "de": "Und die Katze? Ist das eure Katze?",
        "uz": "Mushuk-chi? Bu sizlarning mushugingizmi?"
      },
      {
        "speaker": "Malika",
        "de": "Nein, das ist die Katze von Lola. Sie liebt ihre Katze!",
        "uz": "Yo'q, bu Lolaning mushugi. U mushugini juda yaxshi ko'radi!"
      }
    ],
