{
  "id": "a1-m08-l1",
  "version": 1,
  "level": "A1",
  "module": 8,
  "order": 1,
  "title": "Narx va miqdor",
  "title_de": "Was kostet das?",
  "goal": "Dars oxirida narxni so'raysiz va tushunasiz (Was kostet ...? / Was kosten ...?), evro va sentni o'qiysiz hamda miqdorni aytasiz: ein Kilo, eine Flasche, 200 Gramm.",
  "skill_focus": [
    "vocabulary",
    "listening",
    "speaking"
  ],
  "explanation": [
    {
      "type": "p",
      "text": "Narx so'rash: \"Was kostet ...?\" — bitta narsa uchun, \"Was kosten ...?\" — ko'plik uchun. Javob: \"Das kostet 2,50 Euro.\" / \"Die Äpfel kosten 3 Euro.\""
    },
    {
      "type": "table",
      "headers": [
        "Yozilishi",
        "O'qilishi"
      ],
      "rows": [
        [
          "1,50 €",
          "ein Euro fünfzig"
        ],
        [
          "0,99 €",
          "neunundneunzig Cent"
        ],
        [
          "12,30 €",
          "zwölf Euro dreißig"
        ],
        [
          "20,00 €",
          "zwanzig Euro"
        ]
      ]
    },
    {
      "type": "p",
      "text": "Miqdor so'zidan keyin ot to'g'ridan-to'g'ri keladi, o'rtada boshqa so'z kerak emas: ein Kilo Äpfel, eine Flasche Wasser, 200 Gramm Käse, eine Dose Tomaten, ein Stück Kuchen."
    },
    {
      "type": "tip",
      "text": "Kilo, Gramm, Euro, Cent ko'plikda o'zgarmaydi: zwei Kilo, drei Euro, 500 Gramm. Flasche, Dose, Packung esa ko'plik oladi: zwei Flaschen, drei Dosen, zwei Packungen."
    },
    {
      "type": "tip",
      "text": "Nemis tilida o'nlik kasr vergul bilan yoziladi: 2,50 € (2.50 emas). Narx o'qilganda \"Komma\" aytilmaydi: zwei Euro fünfzig."
    }
  ],
