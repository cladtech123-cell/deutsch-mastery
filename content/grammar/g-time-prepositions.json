{
  "id": "g-time-prepositions",
  "version": 1,
  "level": "A1",
  "order": 11,
  "title": "Vaqt predloglari: um, am, im, von ... bis",
  "prerequisites": [
    "g-articles"
  ],
  "next": [
    "g-dativ",
    "g-future"
  ],
  "rule": "Vaqtni aytganda predlog vaqt turiga bog'liq: soat — um, kun — am, oy va fasl — im.",
  "when": "Uchrashuv, kun tartibi, dars jadvali va rejalar haqida gapirganda.",
  "structure": "um + soat | am + kun / kun qismi | im + oy / fasl | von ... bis ...",
  "explanation": [
    {
      "type": "table",
      "headers": [
        "Predlog",
        "Qachon",
        "Misol"
      ],
      "rows": [
        [
          "um",
          "aniq soat",
          "um 8 Uhr, um halb neun"
        ],
        [
          "am",
          "hafta kuni, kun qismi, sana",
          "am Montag, am Abend, am 5. Mai"
        ],
        [
          "im",
          "oy, fasl",
          "im Mai, im Winter"
        ],
        [
          "in der",
          "tun",
          "in der Nacht"
        ],
        [
          "—",
          "yil",
          "2025 / im Jahr 2025"
        ],
        [
          "von ... bis",
          "dan ... gacha",
          "von 9 bis 17 Uhr"
        ],
        [
          "vor / nach",
          "oldin / keyin",
          "vor dem Essen, nach der Arbeit"
        ],
        [
          "seit",
          "... dan beri",
          "seit zwei Jahren"
        ]
      ]
    },
    {
      "type": "p",
      "text": "am = an + dem, im = in + dem. Shuning uchun \"am\" erkak va o'rta jinsdagi so'zlar bilan keladi (der Montag, der Abend), istisno: in der Nacht."
    },
    {
      "type": "tip",
      "text": "Yildan oldin predlog qo'yilmaydi: \"Ich bin 2004 geboren\". \"in 2004\" — inglizcha ta'sir, xato."
    }
  ],
  "examples": [
    {
      "de": "Der Kurs beginnt um neun Uhr.",
      "uz": "Kurs soat to'qqizda boshlanadi."
    },
    {
      "de": "Am Sonntag besuche ich meine Oma.",
      "uz": "Yakshanba kuni buvimnikiga boraman."
    },
    {
      "de": "Im Sommer ist es in Taschkent sehr heiß.",
      "uz": "Yozda Toshkentda juda issiq."
    },
    {
      "de": "Ich arbeite von acht bis fünf.",
      "uz": "Men sakkizdan beshgacha ishlayman."
    },
    {
      "de": "Nach dem Unterricht gehe ich nach Hause.",
      "uz": "Darsdan keyin uyga boraman."
    },
    {
      "de": "Ich lerne seit drei Monaten Deutsch.",
      "uz": "Uch oydan beri nemis tilini o'rganyapman."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "im Montag",
      "right": "am Montag",
      "why": "Hafta kunlari bilan am."
    },
    {
      "wrong": "am Mai",
      "right": "im Mai",
      "why": "Oylar bilan im."
    },
    {
      "wrong": "am 8 Uhr",
      "right": "um 8 Uhr",
      "why": "Aniq soat bilan um."
    },
    {
      "wrong": "in 2025",
      "right": "2025 / im Jahr 2025",
      "why": "Yil oldida predlog ishlatilmaydi."
    }
  ],
