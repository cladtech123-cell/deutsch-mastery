  "grammar": [
    {
      "topic_id": "g-praesens",
      "rule": "\"trinken\" — muntazam fe'l. \"essen\" va \"mögen\" — nomuntazam: essen → du isst, er isst; mögen → ich mag, du magst, er mag. Yoqtirishni ikki yo'l bilan aytish mumkin: fe'l + gern yoki mögen + ot.",
      "when": "Nima yeyishingiz, ichishingiz va nimani yoqtirishingiz haqida gapirganda.",
      "structure": "Ega + fe'l + gern + ovqat: Ich esse gern Reis.\nEga + mag + ovqat: Ich mag Reis.",
      "examples": [
        {
          "de": "Ich esse gern Reis.",
          "uz": "Men guruch yeyishni yaxshi ko'raman."
        },
        {
          "de": "Isst du gern Fleisch?",
          "uz": "Go'shtni yaxshi ko'rasanmi?"
        },
        {
          "de": "Mein Bruder trinkt gern Saft.",
          "uz": "Akam sharbatni yaxshi ko'radi."
        },
        {
          "de": "Wir mögen Käse.",
          "uz": "Biz pishloqni yoqtiramiz."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Er esst Brot.",
          "right": "Er isst Brot.",
          "why": "\"essen\" nomuntazam: du va er/sie/es bilan o'zak \"iss-\" bo'ladi."
        },
        {
          "wrong": "Sie magt Tee.",
          "right": "Sie mag Tee.",
          "why": "\"mögen\"da er/sie/es shakli \"mag\" — oxiriga -t qo'shilmaydi."
        },
        {
          "wrong": "Ich gern trinke Tee.",
          "right": "Ich trinke gern Tee.",
          "why": "Fe'l doim 2-o'rinda turadi, \"gern\" fe'ldan keyin keladi. O'zbekcha tartibni ko'chirmang."
        }
      ],
      "check": [
        "a1-m07-l1-e04",
        "a1-m07-l1-e05",
        "a1-m07-l1-e06",
        "a1-m07-l1-e10"
      ]
    }
  ],
  "listening": {
    "title": "Nimani yaxshi ko'rasan?",
    "lines": [
      {
        "speaker": "Lena",
        "de": "Was isst du gern, Aziz?",
        "uz": "Aziz, nimani yeyishni yaxshi ko'rasan?"
      },
      {
        "speaker": "Aziz",
        "de": "Ich esse gern Reis und Fleisch. Und du?",
        "uz": "Men guruch va go'shtni yaxshi ko'raman. Sen-chi?"
      },
      {
        "speaker": "Lena",
        "de": "Ich esse nicht gern Fleisch. Ich mag Gemüse und Käse.",
        "uz": "Men go'shtni unchalik yoqtirmayman. Men sabzavot va pishloqni yaxshi ko'raman."
      },
      {
        "speaker": "Aziz",
        "de": "Und was trinkst du?",
        "uz": "Nima ichasan-chi?"
      },
      {
        "speaker": "Lena",
        "de": "Ich trinke gern Tee mit Milch.",
        "uz": "Men sutli choyni yaxshi ko'raman."
      },
      {
        "speaker": "Aziz",
        "de": "Ich auch! In Usbekistan trinken wir viel Tee.",
        "uz": "Men ham! O'zbekistonda biz ko'p choy ichamiz."
      }
    ],
    "questions": [
      "a1-m07-l1-e07"
    ]
  },
  "situation": {
    "title": "Mehmon kutish",
    "context_uz": "Nemis hamkasbingiz Jonas uyingizga mehmonga keldi. Siz undan nima ichishi va nima yeyishini so'raysiz.",
    "lines": [
      {
        "speaker": "Siz",
        "de": "Was trinkst du gern, Jonas? Tee oder Saft?",
        "uz": "Jonas, nima ichishni yaxshi ko'rasan? Choymi yoki sharbatmi?"
      },
      {
        "speaker": "Jonas",
        "de": "Ich trinke gern Tee.",
        "uz": "Men choyni yaxshi ko'raman."
      },
      {
        "speaker": "Siz",
        "de": "Magst du Reis mit Fleisch? Das ist Plov.",
        "uz": "Go'shtli guruchni yoqtirasanmi? Bu palov."
      },
      {
        "speaker": "Jonas",
        "de": "Ja, ich mag Reis sehr. Und ich esse gern Fleisch.",
        "uz": "Ha, guruchni juda yoqtiraman. Go'shtni ham yaxshi ko'raman."
      },
      {
        "speaker": "Siz",
        "de": "Super! Hier sind Brot und Käse.",
        "uz": "Zo'r! Mana non va pishloq."
      },
      {
        "speaker": "Jonas",
        "de": "Danke schön!",
        "uz": "Katta rahmat!"
      }
    ],
    "task_uz": "Dialogni ovoz chiqarib o'qing. Keyin mehmoningizga 3 ta savol bering: \"Trinkst du gern ...?\", \"Isst du gern ...?\", \"Magst du ...?\". Uning javobini ham nemischa ayting."
  },
