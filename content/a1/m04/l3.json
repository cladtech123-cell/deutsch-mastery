  "grammar": [
    {
      "topic_id": "g-possessive",
      "rule": "Egalik so'zlari: mein, dein, sein, ihr, unser, euer, Ihr. Ular otning jinsiga qarab o'zgaradi: der/das-ot oldida asosiy shakl (mein), die-ot va ko'plik oldida -e bilan (meine).",
      "when": "Kimgadir yoki nimagadir egalikni bildirganda: oilangiz, uyingiz, narsalaringiz haqida.",
      "structure": "mein/dein/sein ... + der/das-ot  |  meine/deine/seine ... + die-ot yoki ko'plik",
      "examples": [
        {
          "de": "Das ist meine Familie: mein Mann, meine Tochter und mein Sohn.",
          "uz": "Bu mening oilam: erim, qizim va o'g'lim."
        },
        {
          "de": "Wie heißt dein Hund?",
          "uz": "Itingning ismi nima?"
        },
        {
          "de": "Malika und ihr Mann wohnen in Bonn.",
          "uz": "Malika va uning eri Bonnda yashaydi."
        },
        {
          "de": "Unsere Großeltern sind sehr nett.",
          "uz": "Bobo-buvimiz juda mehribon."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "mein Mutter",
          "right": "meine Mutter",
          "why": "Mutter — die-ot, shuning uchun meine."
        },
        {
          "wrong": "Malika und sein Mann",
          "right": "Malika und ihr Mann",
          "why": "Ega ayol (Malika) — ihr. sein — ega erkak bo'lganda."
        },
        {
          "wrong": "Meine Eltern ist nett.",
          "right": "Meine Eltern sind nett.",
          "why": "Eltern — ko'plik → sind."
        }
      ],
      "check": [
        "a1-m04-l3-e01",
        "a1-m04-l3-e02",
        "a1-m04-l3-e03",
        "a1-m04-l3-e04",
        "a1-m04-l3-e07"
      ]
    }
