  "grammar": [
    {
      "topic_id": "g-reflexive",
      "rule": "Perfektda qaytishli fe'llar doim haben bilan: ich habe mich geärgert. Olmosh yordamchi fe'ldan keyin turadi. Modal fe'l bilan: Ich muss mich beeilen. Buyruqda: Beeil dich! / Ärgern Sie sich nicht!",
      "when": "Muammo va his-tuyg'ularni aytganda: jahl chiqishi, shoshilish.",
      "structure": "Ich habe mich + ... + Partizip II.   Ich muss mich + ... + infinitiv.   Beeil dich! / Beeilen Sie sich!",
      "examples": [
        {
          "de": "Ich habe mich sehr geärgert, weil der Laptop abgestürzt ist.",
          "uz": "Noutbuk qotib qolgani uchun juda jahlim chiqdi."
        },
        {
          "de": "Wir müssen uns beeilen, der Akku ist fast leer.",
          "uz": "Shoshilishimiz kerak, batareya deyarli tugadi."
        },
        {
          "de": "Ärgern Sie sich nicht, ich helfe Ihnen.",
          "uz": "Asabiylashmang, sizga yordam beraman."
        },
        {
          "de": "Beeil dich, der Bus kommt!",
          "uz": "Shoshil, avtobus kelyapti!"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich bin mich geärgert.",
          "right": "Ich habe mich geärgert.",
          "why": "Qaytishli fe'llar Perfektda doim haben bilan."
        },
        {
          "wrong": "Ich muss beeilen mich.",
          "right": "Ich muss mich beeilen.",
          "why": "Olmosh modal fe'ldan keyin, infinitiv esa oxirda."
        },
        {
          "wrong": "Beeil sich!",
          "right": "Beeil dich!",
          "why": "du ga buyruqda olmosh — dich."
        }
      ],
      "check": [
        "a2-m22-l2-e03",
        "a2-m22-l2-e04",
        "a2-m22-l2-e05"
      ]
    }
  ],
  "listening": {
    "title": "Texnik yordam xizmati",
    "lines": [
      {
        "speaker": "Hotline",
        "de": "Technik-Hotline, guten Tag. Was ist das Problem?",
        "uz": "Texnik yordam xizmati, assalomu alaykum. Muammo nima?"
      },
      {
        "speaker": "Lola",
        "de": "Guten Tag. Seit dem Update stürzt meine App immer ab.",
        "uz": "Assalomu alaykum. Yangilanishdan beri ilovam doim qotib qolyapti."
      },
      {
        "speaker": "Hotline",
        "de": "Haben Sie das Handy schon neu gestartet?",
        "uz": "Telefonni qayta yoqib ko'rdingizmi?"
      },
      {
        "speaker": "Lola",
        "de": "Ja, zweimal. Und der Akku ist schon wieder leer. Ich habe ihn heute Morgen aufgeladen.",
        "uz": "Ha, ikki marta. Batareya ham yana tugadi. Bugun ertalab quvvatlagan edim."
      },
      {
        "speaker": "Hotline",
        "de": "Das ist ein bekannter Fehler. Löschen Sie die App und installieren Sie sie neu.",
        "uz": "Bu ma'lum nosozlik. Ilovani o'chiring va qayta o'rnating."
      },
      {
        "speaker": "Lola",
        "de": "Sind meine Fotos dann weg?",
        "uz": "Unda suratlarim yo'qolib ketadimi?"
      },
      {
        "speaker": "Hotline",
        "de": "Nein, keine Sorge. Die Fotos sind gespeichert.",
        "uz": "Yo'q, xavotir olmang. Suratlar saqlangan."
      }
    ],
    "questions": [
      "a2-m22-l2-e06",
      "a2-m22-l2-e07"
    ]
  },
  "situation": {
    "title": "Ofisda printer ishlamayapti",
    "context_uz": "Hamkasbingiz Max majlis oldidan taqdimotni chop eta olmayapti va juda asabiy.",
    "lines": [
      {
        "speaker": "Max",
        "de": "Ich ärgere mich so! Der Drucker funktioniert schon wieder nicht.",
        "uz": "Jahlim chiqyapti! Printer yana ishlamayapti."
      },
      {
        "speaker": "Siz",
        "de": "Was ist denn los?",
        "uz": "Nima bo'ldi?"
      },
      {
        "speaker": "Max",
        "de": "Ich muss mich beeilen, das Meeting beginnt in zehn Minuten. Und ich brauche die Präsentation auf Papier.",
        "uz": "Shoshilishim kerak, majlis o'n daqiqadan keyin boshlanadi. Taqdimot qog'ozda kerak."
      },
      {
        "speaker": "Siz",
        "de": "Hast du den Drucker neu gestartet?",
        "uz": "Printerni qayta yoqdingmi?"
      },
      {
        "speaker": "Max",
        "de": "Nein, noch nicht.",
        "uz": "Yo'q, hali yo'q."
      },
      {
        "speaker": "Siz",
        "de": "Dann versuch das. Und wenn es nicht geht, schick mir die Datei. Ich drucke sie im Büro nebenan aus.",
        "uz": "Unda shuni sinab ko'r. Bo'lmasa, faylni menga yubor. Qo'shni xonada chop etib beraman."
      },
      {
        "speaker": "Max",
        "de": "Danke, du bist super!",
        "uz": "Rahmat, sen zo'rsan!"
      }
    ],
    "task_uz": "Hamkasbingizga yoki texnik yordamga muammo haqida gapiring: nima ishlamayapti, qachondan beri (seit), nima qildingiz (Perfekt). Kamida bitta qaytishli fe'l ishlating."
  },
