  "listening": {
    "title": "Sviter xaridi",
    "lines": [
      {
        "speaker": "Verkäuferin",
        "de": "Guten Tag! Kann ich Ihnen helfen?",
        "uz": "Assalomu alaykum! Sizga yordam bera olamanmi?"
      },
      {
        "speaker": "Bekzod",
        "de": "Ja, ich suche einen Pullover in Größe L.",
        "uz": "Ha, men L o'lchamli sviter qidiryapman."
      },
      {
        "speaker": "Verkäuferin",
        "de": "In Größe L haben wir keinen Pullover in Schwarz. Aber in Blau, ja.",
        "uz": "L o'lchamda qora sviterimiz yo'q. Lekin ko'ki bor."
      },
      {
        "speaker": "Bekzod",
        "de": "Blau ist gut. Was kostet der Pullover?",
        "uz": "Ko'k yaxshi. Sviter qancha turadi?"
      },
      {
        "speaker": "Verkäuferin",
        "de": "Heute kostet er nur 29 Euro.",
        "uz": "Bugun u atigi 29 evro."
      },
      {
        "speaker": "Bekzod",
        "de": "Gut, ich nehme den Pullover.",
        "uz": "Yaxshi, men sviterni olaman."
      },
      {
        "speaker": "Verkäuferin",
        "de": "Zahlen Sie bar oder mit Karte?",
        "uz": "Naqd to'laysizmi yoki karta bilan?"
      },
      {
        "speaker": "Bekzod",
        "de": "Mit Karte, bitte. Und ich brauche keine Tüte.",
        "uz": "Karta bilan, iltimos. Paket kerak emas."
      }
    ],
    "questions": [
      "a1-m08-l3-e08",
      "a1-m08-l3-e09"
    ]
  },
  "situation": {
    "title": "Poyabzal do'konida",
    "context_uz": "Siz 42-o'lchamli poyabzal qidiryapsiz. Sotuvchi bilan gaplashing.",
    "lines": [
      {
        "speaker": "Verkäufer",
        "de": "Hallo! Suchen Sie etwas?",
        "uz": "Salom! Biror narsa qidiryapsizmi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, ich suche Schuhe in Größe 42.",
        "uz": "Ha, 42-o'lchamli poyabzal qidiryapman."
      },
      {
        "speaker": "Verkäufer",
        "de": "Tut mir leid, wir haben keine Schuhe in Größe 42.",
        "uz": "Kechirasiz, bizda 42-o'lchamli poyabzal yo'q."
      },
      {
        "speaker": "Siz",
        "de": "Schade. Haben Sie Größe 43?",
        "uz": "Attang. 43-o'lcham bormi?"
      },
      {
        "speaker": "Verkäufer",
        "de": "Ja, hier. Möchten Sie die Schuhe anprobieren?",
        "uz": "Ha, mana. Kiyib ko'rasizmi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, gern. Sie passen gut! Was kosten sie?",
        "uz": "Ha, bajonidil. Yaxshi to'g'ri keldi! Qancha turadi?"
      },
      {
        "speaker": "Verkäufer",
        "de": "59 Euro.",
        "uz": "59 evro."
      },
      {
        "speaker": "Siz",
        "de": "Ich nehme die Schuhe. Ich zahle bar.",
        "uz": "Poyabzalni olaman. Naqd to'layman."
      }
    ],
    "task_uz": "Sotuvchi va xaridor rollarini o'ynang. Xaridor nima qidirayotganini, o'lcham va rangni aytsin, narxni so'rasin va to'lov usulini tanlasin. Sotuvchi kamida bir marta \"keinen/keine/kein\" bilan javob bersin."
  },
