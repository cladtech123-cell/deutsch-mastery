  "writing_task": {
    "id": "w-a1-m11",
    "title": "Dam olish kunlariga taklif",
    "task_uz": "Do'stingizga xat yozing: 1) bo'sh vaqtingizda nima qilishni yaxshi ko'rasiz; 2) dam olish kunlari nima qilmoqchisiz (will); 3) uni taklif qiling: qachon va qayerda uchrashasiz, qanday borasiz.",
    "required_words": [
      "Zeit",
      "treffen"
    ],
    "min_words": 35,
    "max_words": 80,
    "criteria": [
      "Kamida 2 ta hobbi gern / nicht gern bilan",
      "wollen bilan kamida bitta reja (Am Samstag will ich ...)",
      "Ha/yo'q savoli bilan taklif (Hast du Zeit? Kommst du mit?)",
      "Uchrashuv vaqti va joyi aniq",
      "Modal fe'l bilan infinitiv gap oxirida",
      "Murojaat va xayrlashish bor"
    ],
    "sample_answer": "Liebe Sara, wie geht es dir? In meiner Freizeit schwimme ich gern und ich fotografiere viel. Am Samstag will ich mit Freunden einen Ausflug zum See machen. Wir grillen und spielen Volleyball. Hast du Zeit und Lust? Wir treffen uns um 11 Uhr am Bahnhof und fahren mit dem Zug. Bitte antworte bis Freitag! Viele Grüße, Aziz"
  }
