  "grammar": [
    {
      "topic_id": "g-questions",
      "rule": "Ha/yo'q savolida fe'l birinchi o'rinda turadi: Kommst du mit? W-savolda W-so'z birinchi, fe'l ikkinchi: Wann treffen wir uns? Taklifda \"Wollen wir ...?\" ko'p ishlatiladi. Inkor savolga ijobiy javob — doch.",
      "when": "Taklif qilganda, vaqt va joyni kelishganda, taklifga javob berganda.",
      "structure": "Fe'l + ega + ...?: Hast du Zeit? Kommst du mit?\nWollen wir + ... + infinitiv?: Wollen wir grillen?\nW-so'z + fe'l + ega?: Wo treffen wir uns?",
      "examples": [
        {
          "de": "Kommst du mit ins Kino?",
          "uz": "Kinoga birga borasanmi?"
        },
        {
          "de": "Hast du am Freitag Zeit?",
          "uz": "Juma kuni vaqting bormi?"
        },
        {
          "de": "Wollen wir am See grillen?",
          "uz": "Ko'l bo'yida kabob pishiramizmi?"
        },
        {
          "de": "Wo treffen wir uns?",
          "uz": "Qayerda uchrashamiz?"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Du kommst mit?",
          "right": "Kommst du mit?",
          "why": "Yozma ha/yo'q savolida fe'l birinchi o'rinda turadi."
        },
        {
          "wrong": "Wann wir treffen uns?",
          "right": "Wann treffen wir uns?",
          "why": "W-savolda fe'l ikkinchi o'rinda, ega undan keyin."
        },
        {
          "wrong": "Hast du keine Zeit? — Ja, ich habe Zeit.",
          "right": "Hast du keine Zeit? — Doch, ich habe Zeit.",
          "why": "Inkor savolga \"ha\" ma'nosida javob — doch."
        }
      ],
      "check": [
        "a1-m11-l3-e03",
        "a1-m11-l3-e04",
        "a1-m11-l3-e05"
      ]
    }
  ],
  "listening": {
    "title": "Ovozli xabar",
    "lines": [
      {
        "speaker": "Lisa",
        "de": "Hallo Dilshod, hier ist Lisa. Am Samstag mache ich ein Picknick am See.",
        "uz": "Salom Dilshod, bu Lisa. Shanba kuni ko'l bo'yida piknik qilyapman."
      },
      {
        "speaker": "Lisa",
        "de": "Ich lade dich ein! Wir grillen und spielen Volleyball.",
        "uz": "Seni taklif qilaman! Kabob pishiramiz va voleybol o'ynaymiz."
      },
      {
        "speaker": "Lisa",
        "de": "Kommst du mit? Wir treffen uns um 14 Uhr am Bahnhof. Tschüs!",
        "uz": "Kelasanmi? Soat 14 da vokzalda uchrashamiz. Xayr!"
      },
      {
        "speaker": "Dilshod",
        "de": "Hallo Lisa, danke für die Einladung!",
        "uz": "Salom Lisa, taklif uchun rahmat!"
      },
      {
        "speaker": "Dilshod",
        "de": "Leider kann ich am Samstag nicht. Ich arbeite. Vielleicht nächstes Mal!",
        "uz": "Afsuski, shanba kuni kela olmayman. Ishlayman. Balki keyingi safar!"
      }
    ],
