        ]
      ]
    },
    {
      "type": "table",
      "headers": [
        "Akkusativ bilan",
        "Dativ bilan"
      ],
      "rows": [
        [
          "sehen, kennen, lieben, besuchen, anrufen, fragen",
          "helfen, danken, gefallen, gehören, schmecken, antworten"
        ],
        [
          "für, ohne, gegen, durch, um",
          "mit, bei, zu, von, nach, aus, seit"
        ]
      ]
    },
    {
      "type": "tip",
      "text": "Ikki olmosh bo'lsa, Akkusativ oldin: Ich gebe es dir. Ot va olmosh bo'lsa, olmosh oldin: Ich gebe dir das Buch."
    }
  ],
  "examples": [
    {
      "de": "Ich rufe dich morgen an.",
      "uz": "Ertaga senga qo'ng'iroq qilaman."
    },
    {
      "de": "Kannst du mir helfen?",
      "uz": "Menga yordam bera olasanmi?"
    },
    {
      "de": "Ich sehe ihn jeden Tag.",
      "uz": "Men uni har kuni ko'raman."
    },
    {
      "de": "Wie geht es Ihnen?",
      "uz": "Ahvolingiz qanday?"
    },
    {
      "de": "Das Essen schmeckt uns.",
      "uz": "Ovqat bizga yoqyapti."
    },
    {
      "de": "Das Geschenk ist für sie.",
      "uz": "Sovg'a u (ayol) uchun."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Ich liebe dir.",
      "right": "Ich liebe dich.",
      "why": "lieben + Akkusativ."
    },
    {
      "wrong": "Kannst du mich helfen?",
      "right": "Kannst du mir helfen?",
      "why": "helfen + Dativ."
    },
    {
      "wrong": "Das gefällt ich.",
      "right": "Das gefällt mir.",
      "why": "gefallen + Dativ: Das gefällt mir — Bu menga yoqadi."
    },
    {
      "wrong": "für ihm",
      "right": "für ihn",
      "why": "für — Akkusativ predlogi."
    }
  ],
