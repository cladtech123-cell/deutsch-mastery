      },
      {
        "speaker": "Verkäufer",
        "de": "Ein Kilo kostet 2,80 Euro.",
        "uz": "Bir kilosi 2 evro 80 sent."
      },
      {
        "speaker": "Malika",
        "de": "Gut. Und 500 Gramm Käse, bitte.",
        "uz": "Yaxshi. Yana 500 gramm pishloq, iltimos."
      },
      {
        "speaker": "Verkäufer",
        "de": "Das macht zusammen 7,30 Euro.",
        "uz": "Hammasi bo'lib 7 evro 30 sent."
      },
      {
        "speaker": "Malika",
        "de": "Hier sind 10 Euro.",
        "uz": "Mana 10 evro."
      },
      {
        "speaker": "Verkäufer",
        "de": "Und 2,70 Euro zurück. Danke!",
        "uz": "2 evro 70 sent qaytim. Rahmat!"
      }
    ],
