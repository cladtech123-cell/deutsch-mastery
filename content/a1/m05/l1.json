  "grammar": [
    {
      "topic_id": "g-praesens",
      "rule": "Hozirgi zamonda fe'l o'zagiga shaxs qo'shimchasi qo'shiladi. O'zagi -t yoki -d bilan tugagan fe'llarda (arbeiten) du, er/sie/es va ihr shakllarida qo'shimchadan oldin -e- qo'shiladi.",
      "when": "Kasbingiz, ish joyingiz va har kungi ishingiz haqida gapirganda.",
      "structure": "ich arbeit-e | du arbeit-est | er/sie arbeit-et | wir arbeit-en | ihr arbeit-et | sie/Sie arbeit-en",
      "examples": [
        {
          "de": "Ich arbeite als Ingenieur.",
          "uz": "Men muhandis bo'lib ishlayman."
        },
        {
          "de": "Du arbeitest im Krankenhaus.",
          "uz": "Sen kasalxonada ishlaysan."
        },
        {
          "de": "Sie arbeitet als Verkäuferin.",
          "uz": "U sotuvchi bo'lib ishlaydi."
        },
        {
          "de": "Was sind Sie von Beruf? — Ich bin Koch.",
          "uz": "Kasbingiz nima? — Men oshpazman."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Du arbeitst im Büro.",
          "right": "Du arbeitest im Büro.",
          "why": "O'zak -t bilan tugasa, -st dan oldin -e- qo'shiladi."
        },
        {
          "wrong": "Sie arbeitet als eine Ärztin.",
          "right": "Sie arbeitet als Ärztin.",
          "why": "Kasb oldidan (ayniqsa \"als\" dan keyin) artikl qo'yilmaydi."
        },
        {
          "wrong": "Malika ist Lehrer.",
          "right": "Malika ist Lehrerin.",
          "why": "Ayol uchun kasbning ayol shakli (-in) ishlatiladi."
        }
      ],
      "check": [
        "a1-m05-l1-e03",
        "a1-m05-l1-e04",
        "a1-m05-l1-e07"
      ]
    }
  ],
