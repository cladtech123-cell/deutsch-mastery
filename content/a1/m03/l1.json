  "grammar": [
    {
      "topic_id": "g-sein-haben",
      "rule": "Yosh nemis tilida \"sein\" fe'li bilan aytiladi: kim + sein + son + Jahre alt. \"Jahre alt\" ni tushirib qoldirish mumkin, lekin \"alt\" siz \"Jahre\" qolmaydi.",
      "when": "Yoshingizni yoki boshqa odamning yoshini aytganda va so'raganda.",
      "structure": "Ich bin + son + Jahre alt.  |  Wie alt + sein + ega?",
      "examples": [
        {
          "de": "Ich bin neunzehn Jahre alt.",
          "uz": "Men o'n to'qqiz yoshdaman."
        },
        {
          "de": "Wie alt bist du? — Ich bin zwölf.",
          "uz": "Necha yoshdasan? — O'n ikki yoshdaman."
        },
        {
          "de": "Mein Bruder ist einundzwanzig.",
          "uz": "Akam yigirma bir yoshda."
        },
        {
          "de": "Wie alt sind Sie? — Ich bin achtundzwanzig Jahre alt.",
          "uz": "Necha yoshdasiz? — Yigirma sakkiz yoshdaman."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich habe 20 Jahre.",
          "right": "Ich bin 20 Jahre alt.",
          "why": "O'zbekcha \"20 yoshim bor\" ga qarab haben ishlatilmaydi — yosh doim sein bilan."
        },
        {
          "wrong": "Ich bin 20 Jahre.",
          "right": "Ich bin 20 Jahre alt. / Ich bin 20.",
          "why": "\"Jahre\" ishlatilsa, oxirida \"alt\" bo'lishi shart."
        },
        {
          "wrong": "zwanzigeins",
          "right": "einundzwanzig",
          "why": "21–99 da avval birlik, keyin und, keyin o'nlik aytiladi; 1 bu yerda \"ein\" bo'ladi."
        }
      ],
      "check": [
