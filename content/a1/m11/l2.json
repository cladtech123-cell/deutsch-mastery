  "grammar": [
    {
      "topic_id": "g-modal-verbs",
      "rule": "wollen — qat'iy xohish yoki reja. ich will va er will bir xil (-t yo'q). Ikkinchi fe'l infinitivda gap oxirida turadi. Muloyim so'rovda wollen emas, möchten ishlatiladi.",
      "when": "Rejalar, maqsadlar va kuchli xohish haqida gapirganda: dam olish kunlari, ta'til, kelajak rejalari.",
      "structure": "Ega + will/willst/wollen + ... + infinitiv (oxirida): Ich will am Samstag joggen.\nVaqt bilan boshlash: Am Samstag will ich joggen.",
      "examples": [
        {
          "de": "Am Samstag will ich ins Schwimmbad gehen.",
          "uz": "Shanba kuni basseynga bormoqchiman."
        },
        {
          "de": "Willst du mit uns Fußball spielen?",
          "uz": "Biz bilan futbol o'ynashni xohlaysanmi?"
        },
        {
          "de": "Meine Freunde wollen ein Konzert besuchen.",
          "uz": "Do'stlarim konsertga bormoqchi."
        },
        {
          "de": "Wir wollen am Sonntag einen Ausflug machen.",
          "uz": "Biz yakshanba kuni sayohatga chiqmoqchimiz."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich will gehen ins Kino.",
          "right": "Ich will ins Kino gehen.",
          "why": "Ikkinchi fe'l (gehen) gap oxiriga o'tadi."
        },
        {
          "wrong": "Er willt joggen.",
          "right": "Er will joggen.",
          "why": "er/sie/es bilan \"will\" — oxiriga -t qo'shilmaydi."
        },
        {
          "wrong": "Ich will einen Kaffee!",
          "right": "Ich möchte einen Kaffee, bitte.",
          "why": "Restoran va do'konda \"will\" qo'pol eshitiladi, muloyim shakl — möchte."
        }
      ],
      "check": [
        "a1-m11-l2-e02",
        "a1-m11-l2-e03",
        "a1-m11-l2-e04",
        "a1-m11-l2-e05",
        "a1-m11-l2-e06"
      ]
    }
  ],
  "listening": {
    "title": "Dam olish kunlari rejasi",
    "lines": [
      {
        "speaker": "Jasur",
        "de": "Hallo Eva! Was willst du am Wochenende machen?",
        "uz": "Salom Eva! Dam olish kunlari nima qilmoqchisan?"
      },
      {
        "speaker": "Eva",
        "de": "Am Samstag will ich joggen und dann ins Schwimmbad gehen.",
        "uz": "Shanba kuni yugurmoqchiman, keyin basseynga bormoqchiman."
      },
      {
        "speaker": "Jasur",
        "de": "Und am Sonntag?",
        "uz": "Yakshanba kuni-chi?"
      },
      {
        "speaker": "Eva",
        "de": "Am Sonntag besuche ich meine Oma. Und du?",
        "uz": "Yakshanba kuni buvimni ko'rgani boraman. Sen-chi?"
      },
      {
        "speaker": "Jasur",
        "de": "Ich will mit Freunden Fußball spielen. Am Abend gibt es ein Konzert im Park.",
        "uz": "Do'stlarim bilan futbol o'ynamoqchiman. Kechqurun parkda konsert bor."
      },
      {
        "speaker": "Eva",
        "de": "Oh, ich habe Lust auf ein Konzert! Wann beginnt es?",
        "uz": "Voy, konsertga borgim kelyapti! U qachon boshlanadi?"
      },
      {
        "speaker": "Jasur",
        "de": "Um acht Uhr.",
        "uz": "Soat sakkizda."
      }
    ],
    "questions": [
      "a1-m11-l2-e07",
      "a1-m11-l2-e08"
    ]
  },
  "situation": {
    "title": "Shanba kuni nima qilamiz?",
    "context_uz": "Siz kursdoshingiz Ben bilan shanba kunini rejalashtiryapsiz.",
    "lines": [
      {
        "speaker": "Ben",
        "de": "Was wollen wir am Samstag machen?",
        "uz": "Shanba kuni nima qilamiz?"
      },
      {
        "speaker": "Siz",
        "de": "Ich will einen Ausflug machen. Wir können nach Potsdam fahren.",
        "uz": "Men sayohatga chiqmoqchiman. Potsdamga borishimiz mumkin."
      },
      {
        "speaker": "Ben",
        "de": "Gute Idee! Aber ich will auch Sport machen.",
        "uz": "Yaxshi fikr! Lekin men sport bilan ham shug'ullanmoqchiman."
      },
      {
        "speaker": "Siz",
        "de": "Kein Problem. Wir können dort Rad fahren!",
        "uz": "Muammo yo'q. U yerda velosiped haydashimiz mumkin!"
      },
      {
        "speaker": "Ben",
        "de": "Super, ich habe Lust!",
        "uz": "Zo'r, xohlayman!"
      },
      {
        "speaker": "Siz",
        "de": "Dann treffen wir uns um zehn Uhr am Bahnhof.",
        "uz": "Unda soat o'nda vokzalda uchrashamiz."
      }
    ],
    "task_uz": "Dam olish kunlaringizni rejalashtiring: \"will\" bilan 3 ta gap (Am Samstag will ich ...) va sherigingizga bitta taklif ayting (Wir können ...). Sherigingiz \"Ich habe Lust\" yoki \"Ich habe keine Lust\" bilan javob bersin."
  },
