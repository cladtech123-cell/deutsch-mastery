  "grammar": [
    {
      "topic_id": "g-separable-verbs",
      "rule": "Ajraladigan fe'lning old qo'shimchasi (ab-, an-, um-) hozirgi zamonda gap oxiriga ketadi. Asosiy qism (fährt, kommt, steigt) 2-o'rinda turadi. Modal fe'l bilan fe'l butun holda oxirda qoladi.",
      "when": "Transport jadvali, jo'nash va kelish vaqti, almashish joyi haqida gapirganda.",
      "structure": "Ega + asosiy fe'l + ... + old qo'shimcha: Der Zug fährt um 8 Uhr ab.\nSavol: Wann kommt der Bus an?\nModal bilan: Ich möchte in Köln umsteigen.",
      "examples": [
        {
          "de": "Der Zug fährt um 9:15 Uhr ab.",
          "uz": "Poyezd 9:15 da jo'naydi."
        },
        {
          "de": "Wir kommen um 12 Uhr in Berlin an.",
          "uz": "Biz soat 12 da Berlinga yetib kelamiz."
        },
        {
          "de": "Ich steige am Hauptbahnhof um.",
          "uz": "Men markaziy vokzalda boshqa transportga o'taman."
        },
        {
          "de": "Wann kommt der Bus an?",
          "uz": "Avtobus qachon keladi?"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Der Zug abfährt um 8 Uhr.",
          "right": "Der Zug fährt um 8 Uhr ab.",
          "why": "Hozirgi zamonda \"ab\" ajralib, gap oxiriga ketadi."
        },
        {
          "wrong": "Ich steige um in Köln.",
          "right": "Ich steige in Köln um.",
          "why": "Old qo'shimcha eng oxirida turadi — joy undan oldin."
        },
        {
          "wrong": "Er fahrt mit dem Bus.",
          "right": "Er fährt mit dem Bus.",
          "why": "fahren nomuntazam: du fährst, er fährt (a → ä)."
        }
      ],
      "check": [
        "a1-m10-l2-e04",
        "a1-m10-l2-e05",
        "a1-m10-l2-e06",
        "a1-m10-l2-e12"
      ]
    }
  ],
  "listening": {
    "title": "Vokzalda",
    "lines": [
      {
        "speaker": "Gulnora",
        "de": "Entschuldigung, wann fährt der Zug nach Hamburg ab?",
        "uz": "Kechirasiz, Gamburgga poyezd qachon jo'naydi?"
      },
      {
        "speaker": "Mitarbeiter",
        "de": "Der nächste Zug fährt um 10:20 Uhr ab, von Gleis 7.",
        "uz": "Keyingi poyezd soat 10:20 da, 7-yo'ldan jo'naydi."
      },
      {
        "speaker": "Gulnora",
        "de": "Und wo steige ich um?",
        "uz": "Qayerda boshqa poyezdga o'taman?"
      },
      {
        "speaker": "Mitarbeiter",
        "de": "Sie steigen in Hannover um.",
        "uz": "Gannoverda almashasiz."
      },
      {
        "speaker": "Gulnora",
        "de": "Wann komme ich in Hamburg an?",
        "uz": "Gamburgga qachon yetib boraman?"
      },
      {
        "speaker": "Mitarbeiter",
        "de": "Um 13:45 Uhr.",
        "uz": "Soat 13:45 da."
      },
      {
        "speaker": "Gulnora",
        "de": "Danke! Wo kaufe ich eine Fahrkarte?",
        "uz": "Rahmat! Chiptani qayerdan olaman?"
      },
      {
        "speaker": "Mitarbeiter",
        "de": "Dort am Automaten.",
        "uz": "Ana u avtomatdan."
      }
    ],
    "questions": [
      "a1-m10-l2-e07",
      "a1-m10-l2-e08"
    ]
  },
  "situation": {
    "title": "Ishga qanday borasan?",
    "context_uz": "Yangi ishxonangizda hamkasbingiz Lukas siz bilan tanishyapti va ishga qanday kelishingizni so'rayapti.",
    "lines": [
      {
        "speaker": "Lukas",
        "de": "Wie kommst du zur Arbeit?",
        "uz": "Ishga qanday kelasan?"
      },
      {
        "speaker": "Siz",
        "de": "Ich fahre mit der U-Bahn. Ich steige am Marktplatz um.",
        "uz": "Metroda kelaman. Bozor maydonida almashaman."
      },
      {
        "speaker": "Lukas",
        "de": "Und dann?",
        "uz": "Keyin-chi?"
      },
      {
        "speaker": "Siz",
        "de": "Dann fahre ich mit dem Bus. Ich komme um 8:50 Uhr an. Und du?",
        "uz": "Keyin avtobusda kelaman. Soat 8:50 da yetib kelaman. Sen-chi?"
      },
      {
        "speaker": "Lukas",
        "de": "Ich fahre mit dem Fahrrad. Das ist schnell und billig.",
        "uz": "Men velosipedda kelaman. Bu tez va arzon."
      },
      {
        "speaker": "Siz",
        "de": "Super! Ich gehe manchmal zu Fuß.",
        "uz": "Zo'r! Men ba'zan piyoda kelaman."
      }
    ],
    "task_uz": "Siz ham ishga yoki kursga qanday borishingizni ayting: qaysi transport (mit dem/der ...), qayerda almashasiz (umsteigen), qachon yetib kelasiz (ankommen)."
  },
