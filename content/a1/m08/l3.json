  "grammar": [
    {
      "topic_id": "g-negation",
      "rule": "kein Akkusativda xuddi ein kabi o'zgaradi: erkak jinsi — keinen, ayol jinsi va ko'plik — keine, o'rta jins — kein.",
      "when": "Do'konda \"Haben Sie ...?\" savoliga inkor javob berganda va \"Ich brauche keine Tüte\" kabi rad etganda.",
      "structure": "haben / brauchen / suchen + keinen / keine / kein + ot:\nWir haben keinen Pullover in Größe XL.",
      "examples": [
        {
          "de": "Wir haben keinen Pullover in Größe XL.",
          "uz": "Bizda XL o'lchamli sviter yo'q."
        },
        {
          "de": "Danke, ich brauche keine Tüte.",
          "uz": "Rahmat, menga paket kerak emas."
        },
        {
          "de": "Er sucht kein Hemd, er sucht ein T-Shirt.",
          "uz": "U ko'ylak emas, futbolka qidiryapti."
        },
        {
          "de": "Wir haben keine Schuhe in Größe 46.",
          "uz": "Bizda 46-o'lchamli poyabzal yo'q."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Wir haben kein Pullover.",
          "right": "Wir haben keinen Pullover.",
          "why": "der Pullover — Akkusativda erkak jinsi: keinen."
        },
        {
          "wrong": "Ich brauche nicht eine Tüte.",
          "right": "Ich brauche keine Tüte.",
          "why": "\"nicht eine\" o'rniga \"keine\" ishlatiladi."
        },
        {
          "wrong": "Ich habe keine Geld.",
          "right": "Ich habe kein Geld.",
          "why": "das Geld — o'rta jins: kein."
        }
      ],
      "check": [
