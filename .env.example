# Copy to .env and replace every <placeholder>. Never commit .env.
ENV=development

POSTGRES_USER=deutsch
POSTGRES_PASSWORD=<change-me-db-password>
POSTGRES_DB=deutsch
# Host ports (db is bound to 127.0.0.1 only). If you change BACKEND/FRONTEND ports, add the new frontend origin to ALLOWED_ORIGINS.
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=8080

# Used by host-side tools (alembic, seed, uvicorn --reload). docker-compose overrides it for the backend container.
DATABASE_URL=postgresql+asyncpg://deutsch:<change-me-db-password>@localhost:5433/deutsch
# pytest drops and recreates the public schema of this DB; never point it at real data.
TEST_DATABASE_URL=postgresql+asyncpg://deutsch:<change-me-db-password>@localhost:5433/deutsch_mastery_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<change-me-long-random-secret>
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# AI tutor: none | openai | gemini. With "none" the whole course still works; the tutor answers 503.
AI_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=30

# Optional: when set, the container seeds demo@deutsch-mastery.local with this password.
DEMO_PASSWORD=
