  "situation": {
    "title": "Poyezdda tanishuv",
    "context_uz": "Siz Myunxenga poyezdda ketyapsiz. Yoningizdagi odam siz bilan tanishmoqchi.",
    "lines": [
      {
        "speaker": "Herr Braun",
        "de": "Guten Tag! Ich bin Thomas Braun. Und Sie?",
        "uz": "Assalomu alaykum! Men Tomas Braunman. Siz-chi?"
      },
      {
        "speaker": "Siz",
        "de": "Guten Tag! Ich heiße Malika Rahimova.",
        "uz": "Assalomu alaykum! Mening ismim Malika Rahimova."
      },
      {
        "speaker": "Herr Braun",
        "de": "Woher kommen Sie, Frau Rahimova?",
        "uz": "Qayerdansiz, Rahimova xonim?"
      },
      {
        "speaker": "Siz",
        "de": "Ich komme aus Usbekistan, aus Namangan. Und Sie?",
        "uz": "O'zbekistondanman, Namangandan. Siz-chi?"
      },
      {
        "speaker": "Herr Braun",
        "de": "Ich komme aus Österreich, aus Wien. Aber ich wohne in München.",
        "uz": "Men Avstriyadanman, Venadan. Lekin Myunxenda yashayman."
      },
      {
        "speaker": "Siz",
        "de": "Ich wohne auch in München!",
        "uz": "Men ham Myunxenda yashayman!"
      }
    ],
    "task_uz": "Dialogni o'z ma'lumotlaringiz bilan qayta tuzing: qaysi shahar va mamlakatdan ekaningizni, hozir qayerda yashashingizni ayting. Keyin sherigingizdan xuddi shunday so'rang (Sie bilan)."
  },
