  "rule": "Imperativ — buyruq, iltimos yoki maslahat. Uch shakli bor: du (Komm!), ihr (Kommt!), Sie (Kommen Sie!).",
  "when": "Yo'l ko'rsatish, retsept, maslahat, darsdagi ko'rsatmalar va iltimoslarda. \"bitte\" bilan muloyimroq bo'ladi.",
  "structure": "du: o'zak (+ e) ...! | ihr: ihr-shakl ...! | Sie: infinitiv + Sie ...!",
  "explanation": [
    {
      "type": "table",
      "headers": [
        "Infinitiv",
        "du",
        "ihr",
        "Sie"
      ],
      "rows": [
        [
          "kommen",
          "Komm!",
          "Kommt!",
          "Kommen Sie!"
        ],
        [
          "machen",
          "Mach!",
          "Macht!",
          "Machen Sie!"
        ],
        [
          "warten",
          "Warte!",
          "Wartet!",
          "Warten Sie!"
        ],
        [
          "sprechen",
          "Sprich!",
          "Sprecht!",
          "Sprechen Sie!"
        ],
        [
          "nehmen",
          "Nimm!",
          "Nehmt!",
          "Nehmen Sie!"
        ],
        [
          "fahren",
          "Fahr!",
          "Fahrt!",
          "Fahren Sie!"
        ],
        [
          "aufstehen",
          "Steh auf!",
          "Steht auf!",
          "Stehen Sie auf!"
        ],
        [
          "sein",
          "Sei!",
          "Seid!",
          "Seien Sie!"
        ]
      ]
    },
    {
      "type": "p",
      "text": "du-shakl: \"du kommst\" dan -st va du ni olib tashlang → Komm! e → i o'zgarishi saqlanadi (du sprichst → Sprich!), a → ä esa yo'qoladi (du fährst → Fahr!)."
    },
    {
      "type": "tip",
      "text": "Muloyim qilish uchun: bitte, mal, doch. Komm bitte mal her! Ajraladigan prefiks oxirida: Mach das Fenster auf!"
    }
  ],
  "examples": [
    {
      "de": "Komm bitte!",
      "uz": "Kel, iltimos!"
    },
    {
      "de": "Mach bitte das Fenster auf!",
      "uz": "Derazani och, iltimos!"
    },
    {
      "de": "Sprechen Sie bitte langsam.",
      "uz": "Iltimos, sekin gapiring."
    },
    {
      "de": "Wartet hier!",
      "uz": "Shu yerda kutinglar!"
    },
    {
      "de": "Nimm einen Regenschirm mit!",
      "uz": "Soyabon olib ol!"
    },
    {
      "de": "Seien Sie bitte pünktlich.",
      "uz": "Iltimos, o'z vaqtida keling."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Du komm!",
      "right": "Komm!",
      "why": "du-imperativda olmosh ishlatilmaydi."
    },
    {
      "wrong": "Sprech langsam!",
      "right": "Sprich langsam!",
      "why": "sprechen — e → i: du sprichst → Sprich!"
    },
    {
      "wrong": "Fähr langsam!",
      "right": "Fahr langsam!",
      "why": "a → ä o'zgarishi imperativda yo'qoladi."
    },
    {
      "wrong": "Kommen! (Sizga)",
      "right": "Kommen Sie!",
      "why": "Sie-shaklda olmosh fe'ldan keyin majburiy."
    }
  ],
