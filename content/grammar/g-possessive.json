    {
      "type": "p",
      "text": "Egalik olmoshlari \"ein\" kabi o'zgaradi. Akkusativda erkak jinsi -en oladi: Ich besuche meinen Bruder."
    },
    {
      "type": "tip",
      "text": "O'zbekchada \"uning\" bitta, nemischada ikkita: egasi erkak bo'lsa sein, ayol bo'lsa ihr. Anna und ihr Bruder; Tom und seine Schwester."
    }
  ],
  "examples": [
    {
      "de": "Das ist mein Vater.",
      "uz": "Bu mening otam."
    },
    {
      "de": "Meine Mutter heißt Dilnoza.",
      "uz": "Onamning ismi Dilnoza."
    },
    {
      "de": "Ist das dein Handy?",
      "uz": "Bu sening telefoningmi?"
    },
    {
      "de": "Tom und seine Schwester wohnen in Köln.",
      "uz": "Tom va uning singlisi Kyolnda yashaydi."
    },
    {
      "de": "Anna liebt ihren Hund.",
      "uz": "Anna itini yaxshi ko'radi."
    },
    {
      "de": "Wie ist Ihr Name?",
      "uz": "Ismingiz nima?"
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Anna und sein Bruder",
      "right": "Anna und ihr Bruder",
      "why": "Ega — Anna (ayol), shuning uchun ihr. Narsaning jinsi emas, egasining jinsi muhim."
    },
    {
      "wrong": "mein Schwester",
      "right": "meine Schwester",
      "why": "die Schwester — ayol jinsi, -e qo'shiladi."
    },
    {
      "wrong": "Wie ist ihr Name? (Sizga)",
      "right": "Wie ist Ihr Name?",
      "why": "Hurmat shakli Ihr doim katta harf bilan."
    }
  ],
