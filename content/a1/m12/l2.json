  "grammar": [
    {
      "topic_id": "g-imperative",
      "rule": "du-buyruq: du-shakldan \"du\" va -st olib tashlanadi: du nimmst → Nimm!, du trinkst → Trink! Ajraladigan fe'lda old qo'shimcha oxirida. a → ä umlauti buyruqda tushadi: Fahr!",
      "when": "Do'st, oila a'zosi yoki bolaga maslahat, iltimos yoki ko'rsatma berganda.",
      "structure": "Fe'l o'zagi + ... (+ old qo'shimcha)!: Trink viel Wasser! Zieh eine Jacke an!",
      "examples": [
        {
          "de": "Nimm einen Regenschirm mit!",
          "uz": "Soyabon olib ol!"
        },
        {
          "de": "Zieh eine Jacke an, es ist kalt!",
          "uz": "Kurtka kiy, sovuq!"
        },
        {
          "de": "Trink viel Wasser, es ist heiß!",
          "uz": "Ko'p suv ich, issiq!"
        },
        {
          "de": "Bleib heute zu Hause, du bist krank!",
          "uz": "Bugun uyda qol, sen kasalsan!"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Nimmst einen Regenschirm mit!",
          "right": "Nimm einen Regenschirm mit!",
          "why": "du-buyruqda -st tushib qoladi."
        },
        {
          "wrong": "Du geh nach Hause!",
          "right": "Geh nach Hause!",
          "why": "Buyruqda \"du\" aytilmaydi."
        },
        {
          "wrong": "Fähr langsam!",
          "right": "Fahr langsam!",
          "why": "a → ä o'zgarishi buyruqda bo'lmaydi."
        }
