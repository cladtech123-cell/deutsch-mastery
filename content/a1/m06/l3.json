  "grammar": [
    {
      "topic_id": "g-separable-verbs",
      "rule": "Ajraladigan fe'lda tuslangan qism gapda ikkinchi o'rinda turadi, old qo'shimcha (auf-, ein-, an-, fern-, ab-) esa gap oxiriga o'tadi.",
      "when": "Kun tartibi, uy ishlari va rejalar haqida gapirganda — bu fe'llar kundalik nutqda juda ko'p.",
      "structure": "ega + fe'l qismi (2-o'rin) + ... + old qo'shimcha (oxirida):  Ich stehe um sieben auf.",
      "examples": [
        {
          "de": "Ich stehe um halb sieben auf.",
          "uz": "Men olti yarimda turaman."
        },
        {
          "de": "Am Samstag kaufen wir ein.",
          "uz": "Shanba kuni xarid qilamiz."
        },
        {
          "de": "Mein Mann sieht am Abend fern.",
          "uz": "Erim kechqurun televizor ko'radi."
        },
        {
          "de": "Wann fängt der Kurs an? — Um neun.",
          "uz": "Kurs qachon boshlanadi? — To'qqizda."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich aufstehe um sieben.",
          "right": "Ich stehe um sieben auf.",
          "why": "Old qo'shimcha fe'ldan ajralib, gap oxiriga o'tadi."
        },
        {
          "wrong": "Ich stehe auf um sieben.",
          "right": "Ich stehe um sieben auf.",
          "why": "auf gap eng oxirida turadi, vaqtdan keyin."
        },
        {
          "wrong": "Er fangt um acht an.",
          "right": "Er fängt um acht an.",
          "why": "anfangen: du fängst, er fängt (a → ä)."
        }
      ],
      "check": [
