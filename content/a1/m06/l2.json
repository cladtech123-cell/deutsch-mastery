  "grammar": [
    {
      "topic_id": "g-time-prepositions",
      "rule": "Aniq soat bilan \"um\" ishlatiladi: um acht Uhr. Vaqt oralig'i: von ... bis ... Kun va soat birga: am Montag um zehn Uhr.",
      "when": "Uchrashuv, dars, ish yoki transport vaqtini aytganda va so'raganda.",
      "structure": "um + soat  |  von + soat + bis + soat  |  am + kun + um + soat",
      "examples": [
        {
          "de": "Der Kurs beginnt um neun Uhr.",
          "uz": "Kurs soat to'qqizda boshlanadi."
        },
        {
          "de": "Ich arbeite von acht bis vier.",
          "uz": "Men sakkizdan to'rtgacha ishlayman."
        },
        {
          "de": "Mein Termin ist am Dienstag um halb elf.",
          "uz": "Qabulim seshanba kuni soat o'n yarimda."
        },
        {
          "de": "Um wie viel Uhr kommst du? — Um sieben.",
          "uz": "Soat nechada kelasan? — Yettida."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "am acht Uhr",
          "right": "um acht Uhr",
          "why": "Soat bilan um, kun bilan am — adashtirmang."
        },
        {
          "wrong": "halb neun = 9:30",
          "right": "halb neun = 8:30",
          "why": "halb + keyingi soat: halb neun — to'qqizga yarim soat qoldi, ya'ni 8:30."
        },
        {
          "wrong": "von acht zu vier",
          "right": "von acht bis vier",
          "why": "Oraliqning oxiri bis bilan."
        }
      ],
      "check": [
        "a1-m06-l2-e03",
        "a1-m06-l2-e04",
        "a1-m06-l2-e08",
        "a1-m06-l2-e10"
      ]
    }
  ],
