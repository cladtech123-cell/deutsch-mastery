  "situation": {
    "title": "Qo'shni bilan suhbat",
    "context_uz": "Shanba kuni kechqurun. Qo'shningiz Frau Krüger zinapoyada sizdan kun qanday o'tganini so'rayapti. Siz kun bo'yi tashqarida bo'ldingiz.",
    "lines": [
      {
        "speaker": "Frau Krüger",
        "de": "Guten Abend! Sie waren heute nicht zu Hause, oder?",
        "uz": "Xayrli kech! Bugun uyda bo'lmadingiz, shundaymi?"
      },
      {
        "speaker": "Siz",
        "de": "Nein, wir sind an den See gefahren.",
        "uz": "Yo'q, biz ko'lga bordik."
      },
      {
        "speaker": "Frau Krüger",
        "de": "Schön! Sind Sie auch geschwommen?",
        "uz": "Zo'r! Suzdingizmi ham?"
      },
      {
        "speaker": "Siz",
        "de": "Nein, das Wasser ist zu kalt. Aber wir sind zwei Stunden gewandert.",
        "uz": "Yo'q, suv juda sovuq. Lekin ikki soat piyoda sayr qildik."
      },
      {
        "speaker": "Frau Krüger",
        "de": "Dann sind Sie sicher müde!",
        "uz": "Unda charchagan bo'lsangiz kerak!"
      }
    ],
    "task_uz": "Frau Krügerga o'tgan dam olish kuningiz haqida 3 ta gap ayting. Kamida 2 ta fe'l \"sein\" bilan bo'lsin (gefahren, gewandert, geblieben, aufgewacht...)."
  },
