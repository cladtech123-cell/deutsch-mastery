  "situation": {
    "title": "Kassada",
    "context_uz": "Siz supermarket kassasidasiz. Kassir hisobni aytdi, lekin narx sizga ko'p ko'rindi.",
    "lines": [
      {
        "speaker": "Kassiererin",
        "de": "Guten Tag! Das macht 12,40 Euro.",
        "uz": "Assalomu alaykum! Jami 12 evro 40 sent."
      },
      {
        "speaker": "Siz",
        "de": "Entschuldigung, was kostet eine Flasche Saft?",
        "uz": "Kechirasiz, bir shisha sharbat qancha turadi?"
      },
      {
        "speaker": "Kassiererin",
        "de": "1,99 Euro. Sie haben zwei Flaschen.",
        "uz": "1 evro 99 sent. Sizda ikki shisha bor."
      },
      {
        "speaker": "Siz",
        "de": "Das ist teuer. Ich nehme nur eine Flasche, bitte.",
        "uz": "Bu qimmat. Faqat bir shisha olaman, iltimos."
      },
      {
        "speaker": "Kassiererin",
        "de": "Kein Problem. Dann macht das 10,41 Euro.",
        "uz": "Muammo yo'q. Unda 10 evro 41 sent bo'ladi."
      },
      {
        "speaker": "Siz",
        "de": "Hier, bitte.",
        "uz": "Mana, marhamat."
      }
    ],
    "task_uz": "Sherigingiz kassir bo'lsin. Har bir mahsulot narxini so'rang (\"Was kostet ...? / Was kosten ...?\") va bitta mahsulot miqdorini o'zgartiring (\"Ich nehme nur ...\")."
  },
