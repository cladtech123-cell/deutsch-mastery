  "grammar": [
    {
      "topic_id": "g-questions",
      "rule": "Ha/yo'q savolida fe'l birinchi o'rinda, ega ikkinchi o'rinda turadi. Javob \"Ja, ...\" yoki \"Nein, ...\" bilan boshlanadi.",
      "when": "Biror narsani tasdiqlash yoki inkor qilishni so'raganda: tilni bilasizmi, o'zbekmisiz, nemis tilini o'rganyapsizmi.",
      "structure": "Fe'l + ega + ...?  →  Ja, ... / Nein, ...",
      "examples": [
        {
          "de": "Sprechen Sie Englisch? — Ja, ein bisschen.",
          "uz": "Siz inglizcha gapirasizmi? — Ha, ozgina."
        },
        {
          "de": "Bist du Usbekin? — Ja, ich komme aus Fergana.",
          "uz": "Sen o'zbekmisan? — Ha, men Farg'onadanman."
        },
        {
          "de": "Lernst du Deutsch? — Ja, ich lerne Deutsch.",
          "uz": "Sen nemis tilini o'rganyapsanmi? — Ha, o'rganyapman."
        },
        {
          "de": "Ist Herr Braun aus Wien? — Nein, er ist aus Graz.",
          "uz": "Braun janoblari Venadanmi? — Yo'q, u Gratsdan."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Du sprichst Deutsch?",
          "right": "Sprichst du Deutsch?",
          "why": "Og'zaki nutqda intonatsiya bilan ham so'raladi, lekin standart savolda fe'l birinchi turadi."
        },
        {
          "wrong": "Sprechen du Deutsch?",
          "right": "Sprichst du Deutsch?",
          "why": "Fe'l birinchi o'ringa o'tsa ham ega bilan moslashadi: du sprichst."
        },
        {
          "wrong": "Ich bin ein Usbeke.",
          "right": "Ich bin Usbeke.",
          "why": "Millatni aytganda artikl ishlatilmaydi."
        },
        {
          "wrong": "Ich spreche usbekisch.",
          "right": "Ich spreche Usbekisch.",
          "why": "Til nomi ot sifatida katta harf bilan yoziladi."
        }
      ],
      "check": [
        "a1-m02-l2-e03",
        "a1-m02-l2-e04",
        "a1-m02-l2-e09"
      ]
    }
  ],
  "listening": {
    "title": "Kafeda tanishuv",
    "lines": [
      {
        "speaker": "Tom",
        "de": "Hallo! Ich bin Tom. Und du?",
        "uz": "Salom! Men Tomman. Sen-chi?"
      },
      {
        "speaker": "Dilnoza",
        "de": "Ich heiße Dilnoza. Ich bin Usbekin.",
        "uz": "Mening ismim Dilnoza. Men o'zbekman."
      },
      {
        "speaker": "Tom",
        "de": "Sprichst du Deutsch?",
        "uz": "Nemischa gapirasanmi?"
      },
      {
        "speaker": "Dilnoza",
        "de": "Ja, ein bisschen. Ich lerne Deutsch.",
        "uz": "Ha, ozgina. Nemis tilini o'rganyapman."
      },
      {
        "speaker": "Tom",
        "de": "Sprichst du auch Englisch?",
        "uz": "Inglizcha ham gapirasanmi?"
      },
      {
        "speaker": "Dilnoza",
        "de": "Ja, sehr gut. Und Russisch auch.",
        "uz": "Ha, juda yaxshi. Ruschani ham."
      }
    ],
