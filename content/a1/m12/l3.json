  "grammar": [
    {
      "topic_id": "g-verb-position",
      "rule": "Darak gapda va W-savolda fe'l 2-o'rinda; ha/yo'q savoli va buyruqda 1-o'rinda. Modal fe'l bilan ikkinchi fe'l, ajraladigan fe'lda old qo'shimcha — gap oxirida.",
      "when": "Har qanday gapda — ayniqsa shifokor, dorixona kabi muhim vaziyatlarda aniq gapirish uchun.",
      "structure": "Darak: [1] + fe'l + ...: Heute habe ich Fieber.\nSavol: Haben Sie Fieber? / Wann kommt der Arzt?\nModal: Ich kann nicht schlafen. Ajraladigan: Ich rufe den Arzt an.",
      "examples": [
        {
          "de": "Heute habe ich Fieber.",
          "uz": "Bugun isitmam bor."
        },
        {
          "de": "Kannst du mir Tabletten kaufen?",
          "uz": "Menga tabletka sotib ola olasanmi?"
        },
        {
          "de": "Wann kommt der Arzt?",
          "uz": "Shifokor qachon keladi?"
        },
        {
          "de": "Ich rufe morgen den Arzt an.",
          "uz": "Ertaga shifokorga qo'ng'iroq qilaman."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Heute ich habe Husten.",
          "right": "Heute habe ich Husten.",
          "why": "Gap \"Heute\" bilan boshlansa, fe'l 2-o'rinda qoladi, ega undan keyin."
        },
        {
          "wrong": "Ich kann nicht schlafen gut.",
          "right": "Ich kann nicht gut schlafen.",
          "why": "Infinitiv (schlafen) doim gap oxirida."
        },
        {
          "wrong": "Ich rufe an den Arzt.",
          "right": "Ich rufe den Arzt an.",
          "why": "Ajraladigan old qo'shimcha (an) gap oxiriga ketadi."
        }
      ],
      "check": [
        "a1-m12-l3-e03",
        "a1-m12-l3-e04",
        "a1-m12-l3-e05",
        "a1-m12-l3-e06"
      ]
    }
  ],
  "listening": {
    "title": "Dorixonada",
    "lines": [
      {
        "speaker": "Apothekerin",
        "de": "Guten Tag! Was kann ich für Sie tun?",
        "uz": "Assalomu alaykum! Sizga qanday yordam bera olaman?"
      },
      {
        "speaker": "Herr Rahimov",
        "de": "Ich habe eine Erkältung. Ich habe Husten und Schnupfen.",
        "uz": "Shamollaganman. Yo'tal va tumovim bor."
      },
      {
        "speaker": "Apothekerin",
        "de": "Haben Sie auch Fieber?",
        "uz": "Isitmangiz ham bormi?"
      },
      {
        "speaker": "Herr Rahimov",
        "de": "Nein, kein Fieber. Aber ich bin sehr müde.",
        "uz": "Yo'q, isitma yo'q. Lekin juda charchaganman."
      },
      {
        "speaker": "Apothekerin",
        "de": "Hier sind Tabletten gegen Husten. Nehmen Sie dreimal am Tag eine Tablette.",
        "uz": "Mana, yo'talga qarshi tabletkalar. Kuniga uch marta bittadan iching."
      },
      {
        "speaker": "Herr Rahimov",
        "de": "Brauche ich ein Rezept?",
        "uz": "Retsept kerakmi?"
      },
      {
        "speaker": "Apothekerin",
        "de": "Nein, Sie brauchen kein Rezept. Das macht 6,90 Euro. Gute Besserung!",
        "uz": "Yo'q, retsept kerak emas. 6 evro 90 sent. Tezroq tuzaling!"
      }
    ],
    "questions": [
      "a1-m12-l3-e08",
      "a1-m12-l3-e09"
    ]
  },
  "situation": {
    "title": "Shifokor qabuliga yozilish",
    "context_uz": "Siz kasal bo'lib qoldingiz va Doktor Noymanning qabulxonasiga (Praxis) qo'ng'iroq qilyapsiz.",
    "lines": [
      {
        "speaker": "Arzthelferin",
        "de": "Praxis Dr. Neumann, guten Morgen!",
        "uz": "Doktor Noyman qabulxonasi, xayrli tong!"
      },
      {
        "speaker": "Siz",
        "de": "Guten Morgen! Mein Name ist Malika Usmonova. Ich bin krank und brauche einen Termin.",
        "uz": "Xayrli tong! Ismim Malika Usmonova. Kasalman, qabulga yozilishim kerak."
      },
      {
        "speaker": "Arzthelferin",
        "de": "Was haben Sie denn?",
        "uz": "Sizni nima bezovta qilyapti?"
      },
      {
        "speaker": "Siz",
        "de": "Ich habe seit gestern Fieber und mein Hals tut weh.",
        "uz": "Kechadan beri isitmam bor va tomog'im og'riyapti."
      },
      {
        "speaker": "Arzthelferin",
        "de": "Können Sie heute um 11 Uhr kommen?",
        "uz": "Bugun soat 11 da kela olasizmi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, das geht. Vielen Dank!",
        "uz": "Ha, bo'ladi. Katta rahmat!"
      },
      {
        "speaker": "Arzthelferin",
        "de": "Bringen Sie bitte Ihre Versichertenkarte mit.",
        "uz": "Iltimos, sug'urta kartangizni olib keling."
      }
    ],
    "task_uz": "Qabulxonaga qo'ng'iroq qilishni mashq qiling: ismingizni ayting, ikkita shikoyat ayting, qabul vaqtini so'rang va vaqtni tasdiqlang. Keyin rollarni almashtiring."
  },
