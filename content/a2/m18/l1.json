  "situation": {
    "title": "Shifokor qabulida",
    "context_uz": "Siz shifokor xonasiga kirdingiz. Doktor Hartman alomatlaringiz haqida so'rayapti.",
    "lines": [
      {
        "speaker": "Dr. Hartmann",
        "de": "Guten Tag! Was fehlt Ihnen?",
        "uz": "Assalomu alaykum! Sizni nima bezovta qilyapti?"
      },
      {
        "speaker": "Siz",
        "de": "Ich habe seit drei Tagen Halsschmerzen und Husten.",
        "uz": "Uch kundan beri tomog'im og'riyapti va yo'talyapman."
      },
      {
        "speaker": "Dr. Hartmann",
        "de": "Haben Sie auch Fieber?",
        "uz": "Isitmangiz ham bormi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, gestern Abend 38,5. Und mein Kopf tut weh.",
        "uz": "Ha, kecha kechqurun 38,5. Boshim ham og'riyapti."
      },
      {
        "speaker": "Dr. Hartmann",
        "de": "Haben Sie Allergien?",
        "uz": "Allergiyangiz bormi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, gegen Penizillin.",
        "uz": "Ha, penitsillinga."
      },
      {
        "speaker": "Dr. Hartmann",
        "de": "Gut, dass Sie das sagen. Das ist eine starke Erkältung. Sie müssen viel trinken und zu Hause bleiben.",
        "uz": "Aytganingiz yaxshi bo'ldi. Bu kuchli shamollash. Ko'p suyuqlik ichishingiz va uyda qolishingiz kerak."
      }
    ],
    "task_uz": "Shifokor rolida do'stingiz \"Was fehlt Ihnen?\" deb so'raydi. Siz 3 ta alomat (Ich habe ..., ... tut weh, Mir ist ...) va qachondan beri (seit) ekanini ayting."
  },
