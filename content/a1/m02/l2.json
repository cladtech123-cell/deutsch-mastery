      "a1-m02-l2-e06"
    ]
  },
  "situation": {
    "title": "Ish suhbati",
    "context_uz": "Siz kafega yarim kunlik ishga (Minijob) murojaat qildingiz. Rahbar tillar haqida so'rayapti.",
    "lines": [
      {
        "speaker": "Chefin",
        "de": "Sprechen Sie Deutsch?",
        "uz": "Nemischa gapirasizmi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, ein bisschen. Ich lerne Deutsch.",
        "uz": "Ha, ozgina. Nemis tilini o'rganyapman."
      },
      {
        "speaker": "Chefin",
        "de": "Verstehen Sie Englisch?",
        "uz": "Inglizchani tushunasizmi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, ich spreche gut Englisch. Und ich spreche auch Usbekisch und Russisch.",
        "uz": "Ha, inglizchani yaxshi gapiraman. O'zbekcha va ruscha ham gapiraman."
      },
      {
        "speaker": "Chefin",
        "de": "Sehr gut!",
        "uz": "Juda yaxshi!"
      }
    ],
    "task_uz": "Rahbarning savollariga o'zingiz haqingizda haqqoniy javob bering: qaysi tillarni qanchalik bilasiz (sehr gut / gut / ein bisschen). Keyin rahbarga bitta ha/yo'q savol bering."
  },
