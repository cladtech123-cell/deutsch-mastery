          "arbeite",
          "ich",
          "im Büro."
        ],
        [
          "Morgen",
          "fährt",
          "mein Kollege",
          "nach Berlin."
        ],
        [
          "Dann",
          "trinken",
          "wir",
          "Tee."
        ]
      ]
    },
    {
      "type": "p",
      "text": "O'zbek tilida fe'l gap oxirida keladi (Men bugun ofisda ishlayman), nemis tilida esa ikkinchi o'rinda. Bu — o'zbek o'quvchilari uchun eng muhim farqlardan biri."
    },
    {
      "type": "p",
      "text": "und (va), aber (lekin), oder (yoki) — so'z tartibini o'zgartirmaydi: Ich arbeite viel, aber ich habe am Abend Zeit."
    },
    {
      "type": "tip",
      "text": "\"fahren\" ham unli o'zgaradigan fe'l: du fährst, er fährt (a → ä)."
    }
  ],
