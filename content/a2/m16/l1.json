  "grammar": [
    {
      "topic_id": "g-questions",
      "rule": "Ha/yo'q savolida tuslangan fe'l 1-o'rinda turadi (Passt Ihnen ...? Haben Sie ...?). W-savolda so'roq so'z 1-o'rinda, fe'l 2-o'rinda (Wann haben Sie Zeit?).",
      "when": "Uchrashuv vaqtini so'raganda va taklif berganda.",
      "structure": "Ha/yo'q: Fe'l + subyekt + ...?  W-savol: Wann / Um wie viel Uhr / Wie lange + fe'l + subyekt + ...?",
      "examples": [
        {
          "de": "Haben Sie am Donnerstag Zeit?",
          "uz": "Payshanba kuni bo'shmisiz?"
        },
        {
          "de": "Um wie viel Uhr passt es Ihnen?",
          "uz": "Sizga soat nechada to'g'ri keladi?"
        },
        {
          "de": "Geht es auch am Nachmittag?",
          "uz": "Tushdan keyin ham bo'ladimi?"
        },
        {
          "de": "Wie lange dauert der Termin?",
          "uz": "Uchrashuv qancha davom etadi?"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Sie haben am Montag Zeit?",
          "right": "Haben Sie am Montag Zeit?",
          "why": "Yozma va rasmiy nutqda ha/yo'q savolida fe'l birinchi turadi. Faqat ohang bilan so'rash noto'g'ri yoki qo'pol eshitiladi."
        },
        {
          "wrong": "Wann Sie haben Zeit?",
          "right": "Wann haben Sie Zeit?",
          "why": "W-savolda fe'l 2-o'rinda, subyektdan oldin."
        },
        {
          "wrong": "Wie viel Uhr passt es?",
          "right": "Um wie viel Uhr passt es Ihnen?",
          "why": "Soat haqida so'rashda \"Um wie viel Uhr ...?\" deyiladi."
        }
      ],
      "check": [
        "a2-m16-l1-e02",
        "a2-m16-l1-e03",
        "a2-m16-l1-e09"
      ]
    }
  ],
  "listening": {
    "title": "Sartaroshxonaga qo'ng'iroq",
    "lines": [
      {
        "speaker": "Friseur",
        "de": "Salon Haarschnitt, guten Tag!",
        "uz": "Haarschnitt saloni, assalomu alaykum!"
      },
      {
        "speaker": "Frau Nazarova",
        "de": "Guten Tag! Ich möchte einen Termin zum Haareschneiden vereinbaren.",
        "uz": "Assalomu alaykum! Soch oldirish uchun vaqt belgilamoqchiman."
      },
      {
        "speaker": "Friseur",
        "de": "Gern. Passt Ihnen Mittwoch um 10 Uhr?",
        "uz": "Mamnuniyat bilan. Chorshanba soat 10 sizga to'g'ri keladimi?"
      },
      {
        "speaker": "Frau Nazarova",
        "de": "Mittwoch geht leider nicht. Ist Donnerstag möglich?",
        "uz": "Chorshanba afsuski bo'lmaydi. Payshanba mumkinmi?"
      },
      {
        "speaker": "Friseur",
        "de": "Donnerstag um 14.30 Uhr oder um 17 Uhr.",
        "uz": "Payshanba soat 14:30 yoki 17:00 da."
      },
      {
        "speaker": "Frau Nazarova",
        "de": "Lieber um 17 Uhr. Dann komme ich nach der Arbeit.",
        "uz": "Yaxshisi soat 17 da. Unda ishdan keyin kelaman."
      },
      {
        "speaker": "Friseur",
        "de": "Gut, also Donnerstag, 17 Uhr. Bis dann!",
        "uz": "Yaxshi, demak payshanba, soat 17. Ko'rishguncha!"
      }
    ],
    "questions": [
      "a2-m16-l1-e05"
    ]
  },
  "situation": {
    "title": "Hamkasb bilan yig'ilish vaqtini kelishish",
    "context_uz": "Siz va hamkasbingiz Frau Roth yangi loyiha haqida gaplashishingiz kerak. Vaqt kelishyapsiz.",
    "lines": [
      {
        "speaker": "Frau Roth",
        "de": "Wir müssen über das Projekt sprechen. Wann haben Sie Zeit?",
        "uz": "Loyiha haqida gaplashishimiz kerak. Qachon bo'shsiz?"
      },
      {
        "speaker": "Siz",
        "de": "Passt Ihnen Dienstag um 9 Uhr?",
        "uz": "Seshanba soat 9 sizga to'g'ri keladimi?"
      },
      {
        "speaker": "Frau Roth",
        "de": "Hm, um 9 habe ich schon eine Besprechung. Geht es auch später?",
        "uz": "Hm, soat 9 da yig'ilishim bor. Kechroq ham bo'ladimi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, ich schlage 11 Uhr vor.",
        "uz": "Ha, soat 11 ni taklif qilaman."
      },
      {
        "speaker": "Frau Roth",
        "de": "Einverstanden. Dienstag, 11 Uhr, in meinem Büro.",
        "uz": "Roziman. Seshanba, soat 11, mening xonamda."
      }
    ],
    "task_uz": "O'z variantingizni tuzing: siz chorshanbani taklif qilasiz, hamkasbingiz rad etadi, siz boshqa kun va vaqtni taklif qilasiz. \"Passt Ihnen ...?\", \"lieber\", \"einverstanden\" so'zlarini ishlating."
  },
