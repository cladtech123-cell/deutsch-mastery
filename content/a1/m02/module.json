  "writing_task": {
    "id": "w-a1-m02",
    "title": "Men haqimda",
    "task_uz": "Til kursidagi yangi guruhingiz uchun o'zingiz haqingizda qisqa matn yozing: ismingiz, qayerdan ekaningiz, hozir qayerda yashashingiz, qaysi tillarda gapirishingiz, talaba yoki ishlashingiz va oilaviy holatingiz.",
    "required_words": [
      "komme",
      "wohne",
      "spreche"
    ],
    "min_words": 20,
    "max_words": 60,
    "criteria": [
      "Ism va kelib chiqish aytilgan (Ich heiße ... / Ich komme aus ...).",
      "Yashash joyi aytilgan (Ich wohne in ...).",
      "Kamida ikkita til nomi to'g'ri va katta harf bilan yozilgan.",
      "sein va boshqa fe'llar egaga mos tuslangan.",
      "Har bir gapda fe'l ikkinchi o'rinda."
    ],
    "sample_answer": "Hallo! Ich heiße Shahzoda Tursunova. Ich komme aus Usbekistan, aus Fergana. Jetzt wohne ich in Bonn. Ich bin Studentin und ich bin ledig. Ich spreche Usbekisch, Russisch und Englisch. Ich lerne jetzt Deutsch. Ich spreche ein bisschen Deutsch."
  }
