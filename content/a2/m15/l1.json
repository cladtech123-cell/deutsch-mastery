      {
        "speaker": "Siz",
        "de": "Ja, ich heiße Jasur. Ich arbeite ab heute im Lager.",
        "uz": "Ha, ismim Jasur. Bugundan boshlab omborda ishlayman."
      },
      {
        "speaker": "Markus",
        "de": "Super! Arbeitest du Vollzeit?",
        "uz": "Zo'r! To'liq stavkadami?"
      },
      {
        "speaker": "Siz",
        "de": "Nein, in Teilzeit. Vormittags lerne ich Deutsch.",
        "uz": "Yo'q, yarim stavkada. Tushgacha nemis tilini o'qiyman."
      },
      {
        "speaker": "Markus",
        "de": "Verstehe. Unser Chef ist Herr Braun. Um zehn haben wir eine kurze Besprechung.",
        "uz": "Tushundim. Boshlig'imiz — Braun janoblari. Soat o'nda qisqa yig'ilishimiz bor."
      },
      {
        "speaker": "Siz",
        "de": "Danke für die Info!",
        "uz": "Ma'lumot uchun rahmat!"
      }
    ],
    "task_uz": "Markusga o'zingiz haqingizda ayting: kasbingiz, qayerda ishlaysiz (yoki ishlagansiz), to'liq/yarim stavka va 2 ta vazifangiz. Gaplarni vaqt yoki joy bilan boshlang (Morgens ..., Im Büro ...)."
  },
