  "listening": {
    "title": "Bozorda",
    "lines": [
      {
        "speaker": "Verkäufer",
        "de": "Guten Tag! Was möchten Sie?",
        "uz": "Assalomu alaykum! Nima xohlaysiz?"
      },
      {
        "speaker": "Malika",
        "de": "Ein Kilo Tomaten, bitte. Was kosten die Tomaten?",
