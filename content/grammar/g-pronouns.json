{
  "id": "g-pronouns",
  "version": 1,
  "level": "A1",
  "order": 2,
  "title": "Kishilik olmoshlari",
  "prerequisites": [
    "g-alphabet"
  ],
  "next": [
    "g-sein-haben",
    "g-praesens",
    "g-possessive"
  ],
  "rule": "Kishilik olmoshlari gapda ega bo'ladi: ich, du, er, sie, es, wir, ihr, sie, Sie. Nemis tilida ega tushib qolmaydi.",
  "when": "Kim haqida gapirayotganingizni ko'rsatish uchun. Notanish va katta odamlarga \"Sie\" (Siz), do'st va oilaga \"du\" (sen).",
  "structure": "Olmosh + fe'l: Ich wohne ... / Sie wohnen ...",
  "explanation": [
    {
      "type": "table",
      "headers": [
        "Olmosh",
        "O'zbekcha",
        "Izoh"
      ],
      "rows": [
        [
          "ich",
          "men",
          "gap boshida bo'lmasa ham kichik harf"
        ],
        [
          "du",
          "sen",
          "do'st, oila, bolalar"
        ],
        [
          "er",
          "u (erkak)",
          "der-so'zlar ham: der Tisch → er"
        ],
        [
          "sie",
          "u (ayol)",
          "die-so'zlar ham: die Lampe → sie"
        ],
        [
          "es",
          "u (o'rta jins)",
          "das-so'zlar: das Kind → es"
        ],
        [
          "wir",
          "biz",
          ""
        ],
        [
          "ihr",
          "sizlar (norasmiy)",
          "bir nechta do'st"
        ],
        [
          "sie",
          "ular",
          "kichik harf"
        ],
        [
          "Sie",
          "Siz (hurmat)",
          "doim katta harf, birlik va ko'plik"
        ]
      ]
    },
    {
      "type": "p",
      "text": "O'zbek tilida \"u\" bitta, nemis tilida esa uchta: er, sie, es. Narsalar ham jinsiga qarab er/sie/es bilan almashtiriladi: Der Bus kommt. → Er kommt."
    },
    {
      "type": "tip",
      "text": "sie (u, ayol), sie (ular) va Sie (Siz) ni fe'l ajratadi: sie wohnt (u), sie wohnen (ular), Sie wohnen (Siz). Yozuvda Sie doim katta harf bilan."
    }
  ],
  "examples": [
    {
      "de": "Ich bin Aziz.",
      "uz": "Men Azizman."
    },
    {
      "de": "Du bist mein Freund.",
      "uz": "Sen mening do'stimsan."
    },
    {
      "de": "Er ist Lehrer, und sie ist Ärztin.",
      "uz": "U (erkak) o'qituvchi, u (ayol) esa shifokor."
    },
    {
      "de": "Wir kommen aus Usbekistan.",
      "uz": "Biz O'zbekistondanmiz."
    },
    {
      "de": "Ihr seid sehr nett.",
      "uz": "Sizlar juda yoqimlisizlar."
    },
    {
      "de": "Sind Sie Herr Weber?",
      "uz": "Siz Veber janoblarimisiz?"
    },
    {
      "de": "Wo ist der Bus? — Er kommt gleich.",
      "uz": "Avtobus qayerda? — Hozir keladi."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Bin Aziz.",
      "right": "Ich bin Aziz.",
      "why": "O'zbekchada \"Azizman\" deyish mumkin, lekin nemis tilida ega (ich) majburiy."
    },
    {
      "wrong": "Herr Weber, kommst du?",
      "right": "Herr Weber, kommen Sie?",
      "why": "Notanish yoki rasmiy odamga \"Sie\" bilan murojaat qilinadi."
    },
    {
      "wrong": "Der Tisch ist neu. Es ist schön.",
      "right": "Der Tisch ist neu. Er ist schön.",
      "why": "der Tisch — erkak jinsi, shuning uchun \"er\"."
    }
  ],
