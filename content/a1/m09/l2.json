        "a1-m09-l2-e05",
        "a1-m09-l2-e06",
        "a1-m09-l2-e10"
      ]
    }
  ],
  "listening": {
    "title": "Kvartirani ko'rish",
    "lines": [
      {
        "speaker": "Vermieter",
        "de": "Hier ist die Küche. Es gibt einen Herd und einen Kühlschrank.",
        "uz": "Mana oshxona. Plita va muzlatgich bor."
      },
      {
        "speaker": "Sardor",
        "de": "Gibt es auch eine Waschmaschine?",
        "uz": "Kir yuvish mashinasi ham bormi?"
      },
      {
        "speaker": "Vermieter",
        "de": "Ja, die Waschmaschine ist im Bad.",
        "uz": "Ha, kir yuvish mashinasi hammomda."
      },
      {
        "speaker": "Sardor",
        "de": "Und im Schlafzimmer? Gibt es ein Bett?",
        "uz": "Yotoqxonada-chi? Karavot bormi?"
      },
      {
        "speaker": "Vermieter",
        "de": "Nein, im Schlafzimmer gibt es kein Bett. Aber es gibt einen Schrank.",
        "uz": "Yo'q, yotoqxonada karavot yo'q. Lekin shkaf bor."
      },
      {
        "speaker": "Sardor",
        "de": "Okay. Das Zimmer hat zwei Fenster. Es ist sehr hell!",
        "uz": "Yaxshi. Xonada ikkita deraza bor. Juda yorug'!"
      }
    ],
    "questions": [
      "a1-m09-l2-e07",
      "a1-m09-l2-e08"
    ]
  },
  "situation": {
    "title": "Talabalar yotoqxonasi",
    "context_uz": "Siz talabalar yotoqxonasida (Studentenwohnheim) xona ijaraga olmoqchisiz va telefonda administrator Schulz xonim bilan gaplashyapsiz.",
    "lines": [
      {
        "speaker": "Siz",
        "de": "Guten Tag! Ich habe eine Frage. Gibt es im Zimmer ein Bett?",
        "uz": "Assalomu alaykum! Bir savolim bor. Xonada karavot bormi?"
      },
      {
        "speaker": "Frau Schulz",
        "de": "Ja, es gibt ein Bett, einen Tisch und einen Stuhl.",
        "uz": "Ha, karavot, stol va stul bor."
      },
      {
        "speaker": "Siz",
        "de": "Gibt es auch einen Kühlschrank?",
        "uz": "Muzlatgich ham bormi?"
      },
      {
        "speaker": "Frau Schulz",
        "de": "Nein, im Zimmer gibt es keinen Kühlschrank. Aber in der Küche gibt es zwei Kühlschränke.",
        "uz": "Yo'q, xonada muzlatgich yo'q. Lekin oshxonada ikkita muzlatgich bor."
      },
      {
        "speaker": "Siz",
        "de": "Und was kostet das Zimmer?",
        "uz": "Xona qancha turadi?"
      },
      {
        "speaker": "Frau Schulz",
        "de": "Die Miete ist 350 Euro im Monat.",
        "uz": "Ijara haqi oyiga 350 evro."
      }
    ],
    "task_uz": "Siz ham xona haqida kamida 3 ta savol bering \"Gibt es ...?\" bilan (masalan: Schrank, Regal, Waschmaschine). Sherigingiz \"Ja, es gibt ...\" yoki \"Nein, es gibt keinen/keine/kein ...\" bilan javob bersin."
  },
