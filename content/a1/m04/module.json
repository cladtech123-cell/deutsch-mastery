  "writing_task": {
    "id": "w-a1-m04",
    "title": "Mening oilam",
    "task_uz": "Nemis do'stingizga oilangiz haqida xat yozing: oilangiz katta yoki kichikligi, 3–4 oila a'zosi (ismi, yoshi, qanday odam), ular qayerda yashashi.",
    "required_words": [
      "mein",
      "meine"
    ],
    "min_words": 30,
    "max_words": 80,
    "criteria": [
      "Kamida 3 ta oila a'zosi tilga olingan.",
      "mein/meine (va boshqa egalik so'zlari) jinsga mos ishlatilgan.",
      "Sondan keyin ko'plik shakli to'g'ri (zwei Brüder, drei Kinder).",
      "Har bir odam kamida bitta sifat bilan tasvirlangan.",
      "Fe'llar egaga mos: ist/sind, wohnt/wohnen."
    ],
    "sample_answer": "Hallo Anna! Meine Familie ist groß. Mein Vater heißt Bahodir, er ist fünfzig Jahre alt und sehr nett. Meine Mutter heißt Gulnora, sie ist klein und lustig. Ich habe zwei Brüder und eine Schwester. Meine Brüder sind groß und schlank. Unsere Großeltern wohnen in Buchara. Viele Grüße, Lola"
  }
