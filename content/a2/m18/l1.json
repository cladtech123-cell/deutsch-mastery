      },
      {
        "speaker": "Praxis",
        "de": "Seit wann haben Sie Fieber?",
        "uz": "Qachondan beri isitmangiz bor?"
      },
      {
        "speaker": "Herr Nazarov",
        "de": "Seit zwei Tagen.",
        "uz": "Ikki kundan beri."
      },
      {
        "speaker": "Praxis",
        "de": "Gut, kommen Sie um 11 Uhr. Bringen Sie bitte Ihre Versichertenkarte mit.",
        "uz": "Yaxshi, soat 11 da keling. Iltimos, sug'urta kartangizni olib keling."
      }
    ],
