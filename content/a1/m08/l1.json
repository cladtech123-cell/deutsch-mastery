  "grammar": [
    {
      "topic_id": "g-plural",
      "rule": "Fe'l ega bilan moslashadi: bitta narsa → kostet, ko'plik → kosten. Kilo, Gramm, Euro, Cent ko'plikda o'zgarmaydi; Flasche, Dose, Packung esa ko'plik qo'shimchasini oladi.",
      "when": "Narx so'raganda va mahsulot miqdorini aytganda.",
      "structure": "Was kostet + birlik? Was kosten + ko'plik?\nson + Kilo/Gramm + ot: zwei Kilo Kartoffeln\nson + Flaschen/Dosen/Packungen + ot: drei Flaschen Saft",
      "examples": [
        {
          "de": "Was kostet der Käse?",
          "uz": "Pishloq qancha turadi?"
        },
        {
          "de": "Was kosten die Tomaten?",
          "uz": "Pomidorlar qancha turadi?"
        },
        {
          "de": "Zwei Kilo Kartoffeln kosten drei Euro.",
          "uz": "Ikki kilo kartoshka uch evro turadi."
        },
        {
          "de": "Ich nehme drei Flaschen Saft.",
          "uz": "Men uch shisha sharbat olaman."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Was kostet die Äpfel?",
          "right": "Was kosten die Äpfel?",
          "why": "Äpfel — ko'plik, shuning uchun fe'l ham ko'plikda: kosten."
        },
        {
          "wrong": "zwei Kilos Reis",
          "right": "zwei Kilo Reis",
          "why": "Kilo, Gramm, Euro ko'plikda o'zgarmaydi."
        },
        {
          "wrong": "zwei Flasche Wasser",
          "right": "zwei Flaschen Wasser",
          "why": "Flasche — oddiy ot, ko'plikda -n oladi."
        }
      ],
      "check": [
