  "review_vocabulary": [],
  "grammar": [
    {
      "topic_id": "g-reflexive",
      "rule": "Qaytishli fe'llar \"sich\" bilan keladi: sich anmelden, sich registrieren. Olmosh egaga mos o'zgaradi: ich → mich, du → dich, er/sie/es → sich, wir → uns, ihr → euch, sie/Sie → sich. Darak gapda olmosh tuslangan fe'ldan keyin turadi.",
      "when": "Ro'yxatdan o'tish, tizimga kirish va harakat egasining o'ziga qaytganda.",
      "structure": "Ega + fe'l + qaytish olmoshi + ... (+ ajraladigan qism).   Ich melde mich an.",
      "examples": [
        {
          "de": "Ich melde mich mit meinem Passwort an.",
          "uz": "Parolim bilan tizimga kiraman."
        },
        {
          "de": "Hast du dich schon registriert?",
          "uz": "Ro'yxatdan o'tdingmi?"
        },
        {
          "de": "Wir müssen uns für den Kurs online anmelden.",
          "uz": "Kursga onlayn yozilishimiz kerak."
        },
        {
          "de": "Melden Sie sich bitte mit Ihrem Benutzernamen an.",
          "uz": "Iltimos, foydalanuvchi nomingiz bilan kiring."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich melde an.",
          "right": "Ich melde mich an.",
          "why": "Qaytish olmoshi tushib qolmaydi."
        },
        {
          "wrong": "Ich melde sich an.",
          "right": "Ich melde mich an.",
          "why": "\"sich\" faqat er/sie/es va sie/Sie uchun. ich bilan — mich."
        },
        {
          "wrong": "Wir registrieren sich.",
          "right": "Wir registrieren uns.",
          "why": "wir bilan — uns."
        }
      ],
      "check": [
        "a2-m22-l1-e03",
        "a2-m22-l1-e04",
        "a2-m22-l1-e05",
        "a2-m22-l1-e08"
      ]
    }
  ],
  "listening": {
    "title": "Bank ilovasi",
    "lines": [
      {
        "speaker": "Herr Schulz",
        "de": "Azamat, kannst du mir helfen? Ich möchte die Bank-App benutzen.",
        "uz": "Azamat, menga yordam bera olasanmi? Bank ilovasidan foydalanmoqchiman."
      },
      {
        "speaker": "Azamat",
        "de": "Klar. Zuerst müssen Sie die App herunterladen und installieren.",
        "uz": "Albatta. Avval ilovani yuklab olib o'rnatishingiz kerak."
      },
      {
        "speaker": "Herr Schulz",
        "de": "Gut, das habe ich gemacht. Und jetzt?",
        "uz": "Yaxshi, buni qildim. Endi-chi?"
      },
      {
        "speaker": "Azamat",
        "de": "Jetzt müssen Sie sich registrieren. Geben Sie Ihre E-Mail-Adresse ein und wählen Sie ein Passwort.",
        "uz": "Endi ro'yxatdan o'tishingiz kerak. Email manzilingizni kiriting va parol tanlang."
      },
      {
        "speaker": "Herr Schulz",
        "de": "Ein Passwort? Ich vergesse meine Passwörter immer!",
        "uz": "Parol? Men parollarimni doim unutaman!"
      },
      {
        "speaker": "Azamat",
        "de": "Dann schreiben Sie es auf und legen Sie den Zettel an einen sicheren Ort. Aber nicht neben das Handy!",
        "uz": "Unda uni yozib qo'ying va qog'ozni xavfsiz joyga qo'ying. Lekin telefon yoniga emas!"
      },
      {
        "speaker": "Herr Schulz",
        "de": "Gute Idee. So, jetzt melde ich mich an ... Es funktioniert!",
        "uz": "Yaxshi fikr. Xo'sh, endi kiraman ... Ishlayapti!"
      }
    ],
    "questions": [
      "a2-m22-l1-e06",
      "a2-m22-l1-e07"
    ]
  },
  "situation": {
    "title": "Kutubxonada internet",
    "context_uz": "Siz kutubxonada internetdan foydalanmoqchisiz. Xodimdan qanday ulanishni so'raysiz.",
    "lines": [
      {
        "speaker": "Siz",
        "de": "Entschuldigung, kann ich hier das Internet benutzen?",
        "uz": "Kechirasiz, bu yerda internetdan foydalansam bo'ladimi?"
      },
      {
        "speaker": "Mitarbeiter",
        "de": "Ja, natürlich. Sie müssen sich aber zuerst registrieren.",
        "uz": "Ha, albatta. Lekin avval ro'yxatdan o'tishingiz kerak."
      },
      {
        "speaker": "Siz",
        "de": "Wie mache ich das?",
        "uz": "Buni qanday qilaman?"
      },
      {
        "speaker": "Mitarbeiter",
        "de": "Sie brauchen Ihren Bibliotheksausweis. Der Benutzername ist die Nummer auf dem Ausweis.",
        "uz": "Sizga kutubxona guvohnomangiz kerak. Foydalanuvchi nomi — guvohnomadagi raqam."
      },
      {
        "speaker": "Siz",
        "de": "Und das Passwort?",
        "uz": "Parol-chi?"
      },
      {
        "speaker": "Mitarbeiter",
        "de": "Das ist Ihr Geburtsdatum. Dann melden Sie sich einfach an.",
        "uz": "Bu tug'ilgan sanangiz. Keyin shunchaki tizimga kirasiz."
      },
      {
        "speaker": "Siz",
        "de": "Super, vielen Dank!",
        "uz": "Zo'r, katta rahmat!"
      }
    ],
    "task_uz": "Dialogni o'qing. Keyin do'stingizga ilovada qanday ro'yxatdan o'tishni 3–4 qadamda tushuntiring: Zuerst ..., dann ..., danach ... Qaytishli fe'llarni to'g'ri olmosh bilan ishlating."
  },
