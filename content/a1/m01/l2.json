  "grammar": [
    {
      "topic_id": "g-alphabet",
      "rule": "Nemis tilida har bir harfning o'z nomi bor. Ismni harflashda har bir harfni nemischa nomi bilan ketma-ket aytasiz. Ismlar va otlar doim katta harf bilan yoziladi.",
      "when": "Ism, familiya, ko'cha nomi yoki email'ni telefonda, idorada, shifoxonada aytganda — ayniqsa nemislarga notanish o'zbek ismlarida.",
      "structure": "Ich heiße + ism. → Wie schreibt man das? → harf – harf – harf.",
      "examples": [
        {
          "de": "Ich heiße Dilnoza: D – I – L – N – O – Z – A.",
          "uz": "Mening ismim Dilnoza: D – I – L – N – O – Z – A."
        },
        {
          "de": "Wie schreibt man das? — W – E – B – E – R.",
          "uz": "Bu qanday yoziladi? — V – E – B – E – R."
        },
        {
          "de": "Mein Nachname ist Karimov: K – A – R – I – M – O – V.",
          "uz": "Mening familiyam Karimov: K – A – R – I – M – O – V."
        },
        {
          "de": "Jana schreibt man mit J.",
          "uz": "Jana \"J\" harfi bilan yoziladi."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "J harfini \"ji\" deb aytish",
          "right": "J — \"yot\"",
          "why": "Nemis tilida J harfi \"yot\" deb ataladi va \"y\" tovushini beradi: Jana [yana]."
        },
        {
          "wrong": "V harfini \"ve\" deb aytish",
          "right": "V — \"fau\", W — \"ve\"",
          "why": "Rus va ingliz tili ta'sirida V ni \"ve\" deyish oson, lekin nemischa V — \"fau\", \"ve\" esa W harfi."
        },
        {
          "wrong": "Ich heiße aziz.",
          "right": "Ich heiße Aziz.",
          "why": "Ismlar har doim katta harf bilan yoziladi."
        }
      ],
      "check": [
        "a1-m01-l2-e01",
        "a1-m01-l2-e02",
        "a1-m01-l2-e04",
        "a1-m01-l2-e10"
      ]
    }
  ],
