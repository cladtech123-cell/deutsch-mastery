  "grammar": [
    {
      "topic_id": "g-praesens",
      "rule": "Ba'zi kuchli fe'llarda du va er/sie/es shaklida unli o'zgaradi: e → ie (lesen → liest, sehen → sieht), e → i (sprechen → spricht), a → ä (fahren → fährt). ich, wir, ihr, sie shakllari muntazam.",
      "when": "Boshqa odamning (er, sie, du) hobbilari va odatlari haqida gapirganda.",
      "structure": "du + o'zgargan o'zak + -st: du liest, du siehst, du fährst\ner/sie/es + o'zgargan o'zak + -t: er liest, sie sieht, er fährt",
      "examples": [
        {
          "de": "Meine Schwester liest gern Bücher.",
          "uz": "Opam kitob o'qishni yaxshi ko'radi."
        },
        {
          "de": "Liest du gern?",
          "uz": "Kitob o'qishni yaxshi ko'rasanmi?"
        },
        {
          "de": "Er sieht gern Filme.",
          "uz": "U film ko'rishni yaxshi ko'radi."
        },
        {
          "de": "Am Wochenende fährt mein Vater Fahrrad.",
          "uz": "Dam olish kunlari otam velosiped haydaydi."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Er lest ein Buch.",
          "right": "Er liest ein Buch.",
          "why": "lesen: er/sie/es bilan e → ie: liest."
        },
        {
          "wrong": "Du sehst gern Filme.",
          "right": "Du siehst gern Filme.",
          "why": "sehen: du bilan e → ie: siehst."
        },
        {
          "wrong": "Wir liest Bücher.",
          "right": "Wir lesen Bücher.",
          "why": "Unli faqat du va er/sie/es da o'zgaradi. wir bilan — lesen."
        }
      ],
      "check": [
        "a1-m11-l1-e04",
        "a1-m11-l1-e05",
        "a1-m11-l1-e06"
      ]
    }
  ],
  "listening": {
    "title": "Bo'sh vaqt haqida intervyu",
    "lines": [
      {
        "speaker": "Moderatorin",
        "de": "Was machst du in deiner Freizeit, Sanjar?",
        "uz": "Sanjar, bo'sh vaqtingda nima qilasan?"
      },
      {
        "speaker": "Sanjar",
        "de": "Ich spiele gern Fußball. Am Wochenende spiele ich mit Freunden im Park.",
        "uz": "Futbol o'ynashni yaxshi ko'raman. Dam olish kunlari do'stlarim bilan parkda o'ynayman."
      },
      {
        "speaker": "Moderatorin",
        "de": "Und liest du auch gern?",
        "uz": "Kitob o'qishni ham yaxshi ko'rasanmi?"
      },
      {
        "speaker": "Sanjar",
        "de": "Nein, nicht so gern. Aber ich höre viel Musik.",
        "uz": "Yo'q, unchalik emas. Lekin musiqani ko'p tinglayman."
      },
      {
        "speaker": "Moderatorin",
        "de": "Und deine Schwester?",
        "uz": "Opang-chi?"
      },
      {
        "speaker": "Sanjar",
        "de": "Meine Schwester Madina tanzt und singt gern. Sie malt auch sehr schön.",
        "uz": "Opam Madina raqs tushishni va qo'shiq aytishni yaxshi ko'radi. U juda chiroyli rasm ham chizadi."
      }
    ],
