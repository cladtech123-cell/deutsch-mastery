  "grammar": [
    {
      "topic_id": "g-separable-verbs",
      "rule": "Ajraladigan fe'llar (zurückrufen, ausrichten, anrufen) hozirgi zamonda ajraladi: old qo'shimcha gap oxiriga ketadi. Modal fe'l bilan va Perfektda birga yoziladi (zurückrufen, zurückgerufen). \"wiederholen\", \"verbinden\", \"erreichen\" — AJRALMAYDIGAN fe'llar.",
      "when": "Telefonda qayta qo'ng'iroq, xabar yetkazish va ulash haqida gapirganda.",
      "structure": "Präsens: Ich rufe Sie zurück.  Modal: Können Sie mich zurückrufen?  Perfekt: Er hat zurückgerufen.",
      "examples": [
        {
          "de": "Ich rufe Sie morgen früh zurück.",
          "uz": "Ertaga ertalab sizga qayta qo'ng'iroq qilaman."
        },
        {
          "de": "Können Sie ihm bitte etwas ausrichten?",
          "uz": "Unga bir narsani yetkaza olasizmi?"
        },
        {
          "de": "Frau Klein hat noch nicht zurückgerufen.",
          "uz": "Klein xonim hali qayta qo'ng'iroq qilmadi."
        },
        {
          "de": "Ich wiederhole: 0176 3345 210.",
          "uz": "Takrorlayman: 0176 3345 210."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich zurückrufe Sie morgen.",
          "right": "Ich rufe Sie morgen zurück.",
          "why": "Präsensda \"zurück\" gap oxiriga ketadi."
        },
        {
          "wrong": "Können Sie mich rufen zurück?",
          "right": "Können Sie mich zurückrufen?",
          "why": "Modal fe'l bilan Infinitiv bitta so'z bo'lib oxirda turadi."
        },
        {
          "wrong": "Er hat zurückgeruft.",
          "right": "Er hat zurückgerufen.",
          "why": "\"rufen\" nomuntazam: gerufen → zurückgerufen."
        }
      ],
      "check": [
        "a2-m16-l2-e02",
        "a2-m16-l2-e03",
        "a2-m16-l2-e04",
        "a2-m16-l2-e11"
      ]
    }
  ],
  "listening": {
    "title": "Firmaga qo'ng'iroq",
    "lines": [
      {
        "speaker": "Sekretärin",
        "de": "Firma Becker, Schmidt am Apparat. Guten Tag!",
