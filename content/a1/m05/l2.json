  "grammar": [
    {
      "topic_id": "g-sein-haben",
      "rule": "\"haben\" — noto'g'ri fe'l: ich habe, du hast, er/sie/es hat, wir haben, ihr habt, sie/Sie haben.",
      "when": "Egalik va mavjudlikni aytganda: vaqt, ish, farzand, aka-uka bor-yo'qligi; yosh uchun emas (yosh — sein)!",
      "structure": "ega + haben shakli + ot:  Ich habe Zeit. / Hast du Kinder?",
      "examples": [
        {
          "de": "Ich habe heute viel Arbeit.",
          "uz": "Bugun ishim ko'p."
        },
        {
          "de": "Hast du morgen Zeit?",
          "uz": "Ertaga vaqting bormi?"
        },
        {
          "de": "Sie hat zwei Kinder.",
          "uz": "Uning ikkita farzandi bor."
        },
        {
          "de": "Wir haben eine Katze.",
          "uz": "Bizning mushugimiz bor."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Er habt Zeit.",
          "right": "Er hat Zeit.",
          "why": "er/sie/es bilan — hat. habt — faqat ihr uchun."
        },
        {
          "wrong": "Du habst Zeit.",
          "right": "Du hast Zeit.",
          "why": "du shakli noto'g'ri: hast (b tushadi)."
        },
        {
          "wrong": "Ich habe 25 Jahre.",
          "right": "Ich bin 25 Jahre alt.",
          "why": "Yosh haben bilan emas, sein bilan aytiladi."
        }
      ],
      "check": [
        "a1-m05-l2-e01",
        "a1-m05-l2-e02",
        "a1-m05-l2-e03",
        "a1-m05-l2-e09"
      ]
    },
    {
      "topic_id": "g-praesens",
      "rule": "Ko'p fe'llar muntazam tuslanadi (machen, kochen, hören). Ba'zi fe'llarda du va er/sie shaklida unli o'zgaradi: e → i (essen → du isst), e → ie (lesen → du liest).",
      "when": "Kundalik ishlar va yoqtirgan mashg'ulotlar haqida gapirganda; \"gern\" bilan yoqtirishni bildirganda.",
      "structure": "ega + fe'l (+ gern) + ...:  Ich koche gern. / Er liest viel.",
      "examples": [
        {
          "de": "Was machst du gern? — Ich koche gern.",
          "uz": "Nima qilishni yoqtirasan? — Ovqat pishirishni."
        },
        {
          "de": "Er isst gern Plov.",
          "uz": "U palovni yaxshi ko'radi."
        },
        {
          "de": "Liest du oft?",
          "uz": "Tez-tez kitob o'qiysanmi?"
        },
        {
          "de": "Wir hören viel Musik.",
          "uz": "Biz ko'p musiqa tinglaymiz."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Er esst Brot.",
          "right": "Er isst Brot.",
          "why": "essen: du isst, er isst (e → i)."
        },
        {
          "wrong": "Du lest viel.",
          "right": "Du liest viel.",
          "why": "lesen: du liest, er liest (e → ie)."
        },
        {
          "wrong": "Ich gern koche.",
          "right": "Ich koche gern.",
          "why": "gern fe'ldan keyin keladi; fe'l doim ikkinchi o'rinda."
        }
      ],
      "check": [
        "a1-m05-l2-e04",
        "a1-m05-l2-e05",
        "a1-m05-l2-e08"
      ]
    }
  ],
  "listening": {
    "title": "Dam olish kuni rejasi",
    "lines": [
