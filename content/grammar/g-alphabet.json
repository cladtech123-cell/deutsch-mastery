    {
      "type": "p",
      "text": "Harflab aytish: A [a], B [be], C [tse], D [de], E [e], F [ef], G [ge], H [ha], I [i], J [yot], K [ka], L [el], M [em], N [en], O [o], P [pe], Q [ku], R [er], S [es], T [te], U [u], V [fau], W [ve], X [iks], Y [ipsilon], Z [tset]. Ä — \"a-Umlaut\", ß — \"eszett\"."
    },
    {
      "type": "tip",
      "text": "\"ei\" va \"ie\" ni adashtirmang: ikkinchi harf o'qiladi. ei → [ay] (drei), ie → [i] (vier)."
    }
  ],
  "examples": [
    {
      "de": "Wie schreibt man das? — M-Ü-L-L-E-R.",
      "uz": "Bu qanday yoziladi? — M-Ü-L-L-E-R."
    },
    {
      "de": "Ich heiße Schulz: S-C-H-U-L-Z.",
      "uz": "Mening familiyam Shulz: S-C-H-U-L-Z."
    },
    {
      "de": "Mein Vater wohnt in der Schillerstraße.",
      "uz": "Otam Shiller ko'chasida yashaydi."
    },
    {
      "de": "Drei, vier, neun.",
      "uz": "Uch, to'rt, to'qqiz."
    },
    {
      "de": "Das Wasser ist sehr kalt.",
      "uz": "Suv juda sovuq."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Vater [vater]",
      "right": "Vater [fater]",
      "why": "Nemis tilida v odatda [f] deb o'qiladi. [v] tovushi w harfi bilan yoziladi."
    },
    {
      "wrong": "mein [meyn]",
      "right": "mein [mayn]",
      "why": "ei birikmasi doim [ay] deb o'qiladi."
    },
    {
      "wrong": "Shule",
      "right": "Schule",
      "why": "[sh] tovushi nemis tilida uchta harf bilan yoziladi: sch."
    },
    {
      "wrong": "Strasse [shtrase] ni [strase] deb o'qish",
      "right": "Straße [shtra:se]",
      "why": "So'z boshidagi st [sht] deb o'qiladi."
    }
  ],
