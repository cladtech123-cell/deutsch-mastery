  "grammar": [
    {
      "topic_id": "g-modal-verbs",
      "rule": "möchten — muloyim xohishni bildiradigan modal fe'l. U ot bilan (Akkusativ) yoki gap oxiridagi infinitiv bilan ishlatiladi.",
      "when": "Restoran, kafe, do'konda biror narsa so'raganda, buyurtma berganda, muloyim xohish bildirganda.",
      "structure": "Ega + möchte + Akkusativ: Ich möchte einen Salat.\nEga + möchte + ... + infinitiv (oxirida): Wir möchten jetzt bestellen.",
      "examples": [
        {
          "de": "Ich möchte einen Kaffee, bitte.",
          "uz": "Menga bitta qahva, iltimos."
        },
        {
          "de": "Was möchten Sie essen?",
          "uz": "Nima yeyishni xohlaysiz?"
        },
        {
          "de": "Mein Sohn möchte eine Suppe.",
          "uz": "O'g'lim sho'rva xohlaydi."
        },
        {
          "de": "Wir möchten bezahlen.",
          "uz": "Biz to'lamoqchimiz."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Ich möchte bestellen einen Salat.",
          "right": "Ich möchte einen Salat bestellen.",
          "why": "Ikkinchi fe'l (infinitiv) doim gap oxiriga o'tadi."
        },
        {
          "wrong": "Er möchtet einen Tee.",
          "right": "Er möchte einen Tee.",
          "why": "er/sie/es bilan ham \"möchte\" — oxiriga -t qo'shilmaydi."
        },
        {
          "wrong": "Ich möchte ein Kaffee.",
          "right": "Ich möchte einen Kaffee.",
          "why": "Kaffee — der. möchten dan keyin Akkusativ: einen Kaffee."
        }
      ],
      "check": [
