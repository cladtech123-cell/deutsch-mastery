      "rows": [
        [
          "können",
          "qila olmoq (qobiliyat, imkoniyat)",
          "Ich kann schwimmen."
        ],
        [
          "müssen",
          "majbur bo'lmoq, kerak",
          "Ich muss arbeiten."
        ],
        [
          "wollen",
          "xohlamoq (qat'iy)",
          "Ich will Arzt werden."
        ],
        [
          "möchten",
          "xohlardim (muloyim)",
          "Ich möchte einen Tee."
        ],
        [
          "dürfen",
          "ruxsat bo'lmoq",
          "Hier darf man parken."
        ],
        [
          "sollen",
          "kerak (boshqaning maslahati/topshirig'i)",
          "Ich soll viel trinken."
        ]
      ]
    },
    {
      "type": "p",
      "text": "ich va er/sie/es shakllari bir xil va qo'shimchasiz: ich kann, er kann."
    },
    {
      "type": "tip",
      "text": "nicht müssen = shart emas. nicht dürfen = mumkin emas. Du musst nicht kommen (kelishing shart emas) ≠ Du darfst nicht kommen (kelishing mumkin emas)."
    }
  ],
  "examples": [
    {
      "de": "Ich kann gut schwimmen.",
      "uz": "Men yaxshi suza olaman."
    },
    {
      "de": "Kannst du mir helfen?",
      "uz": "Menga yordam bera olasanmi?"
    },
    {
      "de": "Wir müssen morgen früh aufstehen.",
      "uz": "Ertaga erta turishimiz kerak."
    },
    {
      "de": "Ich möchte einen Tee, bitte.",
      "uz": "Bitta choy, iltimos."
    },
    {
      "de": "Hier darf man nicht parken.",
      "uz": "Bu yerda mashina qo'yish mumkin emas."
    },
    {
      "de": "Der Arzt sagt, ich soll viel Wasser trinken.",
      "uz": "Shifokor ko'p suv ichishim kerakligini aytyapti."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Ich kann spreche Deutsch.",
      "right": "Ich kann Deutsch sprechen.",
      "why": "Modal fe'ldan keyin asosiy fe'l infinitivda va gap oxirida."
    },
    {
      "wrong": "Er kannt schwimmen.",
      "right": "Er kann schwimmen.",
      "why": "er shaklida qo'shimcha yo'q: er kann."
    },
    {
      "wrong": "Ich will einen Kaffee. (kafeda)",
      "right": "Ich möchte einen Kaffee.",
      "why": "will qo'pol eshitiladi; buyurtmada möchte ishlating."
    },
    {
      "wrong": "Du musst hier nicht rauchen. (taqiq ma'nosida)",
      "right": "Du darfst hier nicht rauchen.",
      "why": "Taqiq — nicht dürfen. nicht müssen — \"shart emas\"."
    }
  ],
