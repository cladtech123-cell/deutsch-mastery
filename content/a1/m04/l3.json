  "situation": {
    "title": "Hamkasb bilan suhbat",
    "context_uz": "Ishxonada hamkasbingiz Herr Becker telefonidagi suratni ko'rsatyapti. Siz rasmiy (Sie) gaplashasiz.",
    "lines": [
      {
        "speaker": "Herr Becker",
        "de": "Schauen Sie, das ist meine Familie.",
        "uz": "Qarang, bu mening oilam."
      },
      {
        "speaker": "Siz",
        "de": "Oh, schön! Ist das Ihre Frau?",
        "uz": "Voy, ajoyib! Bu rafiqangizmi?"
      },
      {
        "speaker": "Herr Becker",
        "de": "Ja, das ist meine Frau Sabine. Und das sind unsere Enkelkinder.",
        "uz": "Ha, bu rafiqam Sabine. Bular esa nevaralarimiz."
      },
      {
        "speaker": "Siz",
        "de": "Wie alt sind Ihre Enkelkinder?",
        "uz": "Nevaralaringiz necha yoshda?"
      },
      {
        "speaker": "Herr Becker",
        "de": "Drei und sechs. Und Sie? Haben Sie Familie?",
        "uz": "Uch va olti yoshda. Siz-chi? Oilangiz bormi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, meine Familie wohnt in Usbekistan.",
        "uz": "Ha, oilam O'zbekistonda yashaydi."
      }
    ],
    "task_uz": "Herr Beckerga o'z oilangiz haqida 3–4 gap bilan javob bering (mein/meine, unser/unsere). Keyin unga yana bitta savol bering (Ihr/Ihre bilan)."
  },
