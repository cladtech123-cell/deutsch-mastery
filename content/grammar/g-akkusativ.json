  "rule": "Akkusativ — to'ldiruvchi kelishigi (Wen? Was? — kimni? nimani?). Faqat erkak jinsidagi artikl o'zgaradi: der → den, ein → einen.",
  "when": "haben, kaufen, essen, trinken, sehen, brauchen, suchen, nehmen, möchten, es gibt fe'llaridan keyin va für, ohne, durch, gegen, um predloglaridan keyin.",
  "structure": "Ega + fe'l + Akkusativ: Ich kaufe den Tisch / einen Tisch.",
  "explanation": [
    {
      "type": "table",
      "headers": [
        "Jins",
        "Nominativ",
        "Akkusativ"
      ],
      "rows": [
        [
          "erkak",
          "der / ein / kein / mein",
          "den / einen / keinen / meinen"
        ],
        [
          "ayol",
          "die / eine",
          "die / eine"
        ],
        [
          "o'rta",
          "das / ein",
          "das / ein"
        ],
        [
          "ko'plik",
          "die / —",
          "die / —"
        ]
      ]
    },
    {
      "type": "p",
      "text": "O'zbek tilida tushum kelishigi \"-ni\" bilan, lekin ko'pincha qo'shilmaydi: \"Men olma yeyman\". Nemis tilida erkak jinsidagi ot baribir Akkusativda: Ich esse einen Apfel."
    },
    {
      "type": "table",
      "headers": [
        "Fe'l / predlog",
        "Misol"
      ],
      "rows": [
        [
          "haben",
          "Ich habe einen Bruder."
        ],
        [
          "möchten",
          "Ich möchte einen Tee."
        ],
        [
          "es gibt",
          "Es gibt einen Park."
        ],
        [
          "brauchen",
          "Ich brauche einen Stift."
        ],
        [
          "für",
          "Das ist für meinen Vater."
        ],
        [
          "ohne",
          "Kaffee ohne Zucker, bitte."
        ]
      ]
    },
    {
      "type": "tip",
      "text": "Savol bering: Wer? (kim?) — ega, Nominativ; Wen? Was? (kimni? nimani?) — Akkusativ."
    }
  ],
  "examples": [
    {
      "de": "Ich habe einen Bruder.",
      "uz": "Mening bitta akam bor."
    },
    {
      "de": "Wir kaufen den Tisch.",
      "uz": "Biz stolni sotib olamiz."
    },
    {
      "de": "Möchtest du einen Tee?",
      "uz": "Choy ichasanmi?"
    },
    {
      "de": "Ich brauche eine Tasche.",
      "uz": "Menga sumka kerak."
    },
    {
      "de": "Das Geschenk ist für meinen Vater.",
      "uz": "Sovg'a otam uchun."
    },
    {
      "de": "In der Nähe gibt es einen Park.",
      "uz": "Yaqinda bog' bor."
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Ich habe ein Bruder.",
      "right": "Ich habe einen Bruder.",
      "why": "haben dan keyin Akkusativ; der Bruder — erkak jinsi → einen."
    },
    {
      "wrong": "Ich kaufe der Tisch.",
      "right": "Ich kaufe den Tisch.",
      "why": "Akkusativda der → den."
    },
    {
      "wrong": "Ich möchte einen Cola.",
      "right": "Ich möchte eine Cola.",
      "why": "-en faqat erkak jinsiga qo'shiladi; die Cola — ayol jinsi, o'zgarmaydi."
    },
    {
      "wrong": "für mein Vater",
      "right": "für meinen Vater",
      "why": "für dan keyin Akkusativ."
    }
  ],
