  "situation": {
    "title": "Yangi hamkasb bilan tanaffusda",
    "context_uz": "Ishxonada tanaffus. Yangi hamkasbingiz Lena siz bilan gaplashyapti.",
    "lines": [
      {
        "speaker": "Lena",
        "de": "Trinkst du Tee oder Wasser?",
        "uz": "Choy ichasanmi yoki suvmi?"
      },
      {
        "speaker": "Siz",
        "de": "Tee, bitte. Ich trinke viel Tee.",
        "uz": "Choy, iltimos. Men ko'p choy ichaman."
      },
      {
        "speaker": "Lena",
        "de": "Was machst du gern am Wochenende?",
        "uz": "Dam olish kunlari nima qilishni yoqtirasan?"
      },
      {
        "speaker": "Siz",
        "de": "Ich lese gern und ich höre oft Musik. Und du?",
        "uz": "Kitob o'qishni yoqtiraman va tez-tez musiqa tinglayman. Sen-chi?"
      },
      {
        "speaker": "Lena",
        "de": "Ich koche gern. Ich habe viele Kochbücher!",
        "uz": "Men ovqat pishirishni yoqtiraman. Ko'p oshxona kitoblarim bor!"
      }
    ],
    "task_uz": "Lenaning savollariga o'zingiz haqingizda javob bering va unga 2 ta savol bering (Hast du ...? Was machst du gern?)."
  },
