  "grammar": [
    {
      "topic_id": "g-possessive",
      "rule": "Shikoyatda egalik so'zi tana a'zosining jinsiga moslashadi: mein (der/das), meine (die va ko'plik). wehtun fe'li esa egaga moslashadi: bitta a'zo — tut weh, ko'plik — tun weh.",
      "when": "Qayeringiz og'riyotganini aytganda (shifokorda, dorixonada, ishda).",
      "structure": "mein/dein/sein + der/das-a'zo + tut weh: Mein Kopf tut weh.\nmeine/deine/seine + ko'plik + tun weh: Meine Augen tun weh.\nSavol: Tut dein Bauch weh?",
      "examples": [
        {
          "de": "Mein Kopf tut weh.",
          "uz": "Boshim og'riyapti."
        },
        {
          "de": "Meine Augen tun weh.",
          "uz": "Ko'zlarim og'riyapti."
        },
        {
          "de": "Tut dein Bauch weh?",
          "uz": "Qorning og'riyaptimi?"
        },
        {
          "de": "Sein Rücken tut weh.",
          "uz": "Uning beli og'riyapti."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Meine Kopf tut weh.",
          "right": "Mein Kopf tut weh.",
          "why": "der Kopf — erkak jinsi: mein (-e yo'q)."
        },
        {
          "wrong": "Meine Augen tut weh.",
          "right": "Meine Augen tun weh.",
          "why": "Augen — ko'plik, shuning uchun fe'l ham ko'plikda: tun."
        },
        {
          "wrong": "Ich habe Kopf weh.",
          "right": "Ich habe Kopfschmerzen. / Mein Kopf tut weh.",
          "why": "O'zbekcha iborani so'zma-so'z ko'chirmang."
        }
      ],
      "check": [
        "a1-m12-l1-e04",
        "a1-m12-l1-e05",
        "a1-m12-l1-e06",
        "a1-m12-l1-e09"
      ]
    }
  ],
  "listening": {
    "title": "Timur kasal",
    "lines": [
      {
        "speaker": "Mutter",
