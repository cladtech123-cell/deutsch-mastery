          "hättet"
        ],
        [
          "sie / Sie",
          "könnten",
          "würden",
          "hätten"
        ]
      ]
    },
    {
      "type": "p",
      "text": "Rasmiy email: \"Sehr geehrte Frau ... / Sehr geehrter Herr ...\" bilan boshlanadi, \"Mit freundlichen Grüßen\" bilan tugaydi."
    },
    {
      "type": "tip",
      "text": "\"Geben Sie mir ...!\" buyruqqa o'xshaydi. \"Könnten Sie mir bitte ... geben?\" ancha yoqimli eshitiladi."
    }
  ],
  "examples": [
    {
      "de": "Könnten Sie mir bitte helfen?",
      "uz": "Menga yordam bera olasizmi, iltimos?"
    },
    {
      "de": "Ich hätte gern einen Termin beim Arzt.",
      "uz": "Shifokorga yozilmoqchi edim."
    },
    {
      "de": "Würden Sie bitte langsamer sprechen?",
      "uz": "Iltimos, sekinroq gapira olasizmi?"
    },
    {
      "de": "Ich würde gern am Freitag kommen.",
      "uz": "Juma kuni kelmoqchi edim."
    },
    {
      "de": "Darf ich hier sitzen?",
      "uz": "Shu yerga o'tirsam maylimi?"
    },
    {
      "de": "Könnten wir den Termin verschieben?",
      "uz": "Uchrashuvni boshqa vaqtga ko'chira olamizmi?"
    }
  ],
  "common_mistakes": [
    {
      "wrong": "Ich will ein Kilo Äpfel.",
      "right": "Ich hätte gern ein Kilo Äpfel.",
      "why": "\"will\" do'konda qo'pol eshitiladi."
    },
    {
      "wrong": "Könnten Sie helfen mir?",
      "right": "Könnten Sie mir helfen?",
      "why": "Infinitiv (helfen) gap oxirida."
    },
    {
      "wrong": "Ich hatte gern einen Tee.",
      "right": "Ich hätte gern einen Tee.",
      "why": "hatte — o'tgan zamon, hätte (umlaut bilan) — muloyim shakl."
    },
    {
      "wrong": "Ich würde gern einen Kaffee.",
      "right": "Ich hätte gern einen Kaffee. / Ich würde gern einen Kaffee trinken.",
      "why": "würde dan keyin infinitiv kerak."
    }
  ],
