  "writing_task": {
    "id": "w-a1-m05",
    "title": "Mening ishim va kunim",
    "task_uz": "Yangi nemis do'stingizga o'zingiz haqingizda yozing: kasbingiz (yoki o'qishingiz), qayerda ishlashingiz, kuningiz qanday o'tishi (zuerst, dann) va bo'sh vaqtda nima qilishni yoqtirishingiz (gern).",
    "required_words": [
      "gern",
      "dann"
    ],
    "min_words": 30,
    "max_words": 80,
    "criteria": [
      "Kasb artiklsiz va jinsga mos aytilgan (Ich bin Lehrerin).",
      "Kamida 3 ta har xil fe'l to'g'ri tuslangan.",
      "Kamida 2 gap vaqt so'zi bilan boshlangan va fe'l ikkinchi o'rinda (Dann lese ich ...).",
      "\"gern\" to'g'ri o'rinda ishlatilgan.",
      "und/aber/oder bilan bog'langan gap bor."
    ],
    "sample_answer": "Hallo Lena! Ich bin Lehrerin von Beruf. Ich arbeite in einer Schule in Taschkent. Zuerst trinke ich Tee, dann fahre ich zur Arbeit. Ich arbeite viel, aber am Abend habe ich Zeit. Dann lese ich gern oder ich höre Musik. Ich koche nicht gern. Viele Grüße, Dilnoza"
  }
