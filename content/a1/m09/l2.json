  "grammar": [
    {
      "topic_id": "g-akkusativ",
      "rule": "\"es gibt\" — \"... bor\". Undan keyin ot Akkusativda turadi: erkak jinsi einen/keinen; die va das o'zgarmaydi. Savol: Gibt es ...?",
      "when": "Xona, uy, shahar yoki boshqa joyda nima borligi yoki yo'qligini aytganda.",
      "structure": "(Joy +) gibt es + einen/eine/ein + ot: Im Zimmer gibt es einen Schrank.\nEs gibt + keinen/keine/kein + ot: Es gibt keinen Herd.\nSavol: Gibt es eine Waschmaschine?",
      "examples": [
        {
          "de": "In der Küche gibt es einen Kühlschrank.",
          "uz": "Oshxonada muzlatgich bor."
        },
        {
          "de": "Gibt es im Bad eine Waschmaschine?",
          "uz": "Hammomda kir yuvish mashinasi bormi?"
        },
        {
          "de": "Im Wohnzimmer gibt es kein Sofa.",
          "uz": "Mehmonxonada divan yo'q."
        },
        {
          "de": "Es gibt zwei Fenster.",
          "uz": "Ikkita deraza bor."
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Es gibt ein Tisch.",
          "right": "Es gibt einen Tisch.",
          "why": "es gibt dan keyin Akkusativ: der Tisch → einen Tisch."
        },
        {
          "wrong": "Es geben drei Stühle.",
          "right": "Es gibt drei Stühle.",
          "why": "\"es gibt\" har doim birlikda, ko'plik ot bilan ham."
        },
        {
          "wrong": "Im Zimmer es gibt ein Bett.",
          "right": "Im Zimmer gibt es ein Bett.",
          "why": "Gap joy bilan boshlansa, fe'l (gibt) 2-o'rinda qoladi, \"es\" undan keyin keladi."
        }
      ],
      "check": [
        "a1-m09-l2-e03",
