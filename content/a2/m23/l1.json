  "grammar": [
    {
      "topic_id": "g-polite-requests",
      "rule": "Muloyim iltimos uchun Konjunktiv II shakllari ishlatiladi: könnten (Könnten Sie ...?), würden (Würden Sie ...?), hätte gern (Ich hätte gern ...). Ular \"kann / will\" dan yumshoqroq eshitiladi. Infinitiv gap oxirida turadi.",
      "when": "Rasmiy joylarda (pochta, bank, idora), notanish odamga va iltimos qilganda.",
      "structure": "Könnten / Würden + Sie + (bitte) + ... + infinitiv?   Ich hätte gern + Akkusativ.",
      "examples": [
        {
          "de": "Könnten Sie mir bitte helfen?",
          "uz": "Menga yordam bera olarmidingiz?"
        },
        {
          "de": "Würden Sie das Formular bitte unterschreiben?",
          "uz": "Iltimos, blankaga imzo chekib bersangiz?"
        },
        {
          "de": "Ich hätte gern zehn Briefmarken.",
          "uz": "O'nta pochta markasi olmoqchi edim."
        },
        {
          "de": "Könnten Sie das bitte langsamer sagen?",
          "uz": "Buni sekinroq ayta olarmidingiz?"
        }
      ],
      "common_mistakes": [
        {
          "wrong": "Konnten Sie mir helfen?",
          "right": "Könnten Sie mir helfen?",
          "why": "konnten (umlautsiz) — o'tgan zamon (qila oldingizmi). Muloyim iltimos — könnten."
        },
        {
          "wrong": "Ich habe gern zehn Briefmarken.",
          "right": "Ich hätte gern zehn Briefmarken.",
          "why": "\"habe gern\" — yoqtiraman degani. Muloyim istak — hätte gern."
        },
        {
          "wrong": "Könnten Sie bitte unterschreiben das Formular?",
          "right": "Könnten Sie bitte das Formular unterschreiben?",
          "why": "Infinitiv (unterschreiben) gap oxirida."
        }
      ],
      "check": [
        "a2-m23-l1-e03",
        "a2-m23-l1-e04",
        "a2-m23-l1-e05",
        "a2-m23-l1-e09",
        "a2-m23-l1-e11"
      ]
    }
  ],
  "listening": {
    "title": "Pochtada",
    "lines": [
      {
        "speaker": "Mitarbeiterin",
        "de": "Der Nächste, bitte! Was kann ich für Sie tun?",
        "uz": "Keyingisi, marhamat! Siz uchun nima qila olaman?"
      },
      {
        "speaker": "Rustam",
        "de": "Guten Tag. Ich möchte dieses Paket nach Usbekistan schicken. Was kostet das?",
        "uz": "Assalomu alaykum. Bu posilkani O'zbekistonga jo'natmoqchiman. Qancha turadi?"
      },
      {
        "speaker": "Mitarbeiterin",
        "de": "Das Paket wiegt drei Kilo. Das kostet 42 Euro.",
        "uz": "Posilka uch kilo. Bu 42 yevro turadi."
      },
      {
        "speaker": "Rustam",
        "de": "Gut. Und ich hätte gern noch fünf Briefmarken für Briefe in Deutschland.",
        "uz": "Yaxshi. Yana Germaniya ichidagi xatlar uchun beshta marka olmoqchi edim."
      },
      {
        "speaker": "Mitarbeiterin",
        "de": "Gern. Würden Sie bitte noch hier den Absender eintragen und unterschreiben?",
        "uz": "Marhamat. Iltimos, shu yerga jo'natuvchini yozib, imzo chekib bersangiz?"
      },
      {
        "speaker": "Rustam",
        "de": "Natürlich. Könnten Sie mir bitte auch eine Quittung geben?",
        "uz": "Albatta. Menga kvitansiya ham bera olarmidingiz?"
      },
      {
        "speaker": "Mitarbeiterin",
        "de": "Selbstverständlich. Hier, bitte.",
        "uz": "Albatta. Mana, marhamat."
      }
    ],
    "questions": [
      "a2-m23-l1-e06",
      "a2-m23-l1-e07"
    ]
  },
  "situation": {
    "title": "Kimyoviy tozalashda",
    "context_uz": "Siz kimyoviy tozalashga (Reinigung) kostyumingizni olib keldingiz. U shanba kungi to'ygacha tayyor bo'lishi kerak.",
    "lines": [
      {
        "speaker": "Mitarbeiter",
        "de": "Guten Morgen! Was darf es sein?",
        "uz": "Xayrli tong! Nima xizmat?"
      },
      {
        "speaker": "Siz",
        "de": "Guten Morgen. Könnten Sie diesen Anzug bis Freitag reinigen? Ich habe am Samstag eine Hochzeit.",
        "uz": "Xayrli tong. Shu kostyumni jumagacha tozalab bera olarmidingiz? Shanba kuni to'yim bor."
      },
      {
        "speaker": "Mitarbeiter",
        "de": "Bis Freitagmorgen ist es schwierig. Würde Ihnen Freitagnachmittag passen?",
        "uz": "Juma ertalabgacha qiyin. Juma kuni tushdan keyin to'g'ri kelarmidi?"
      },
      {
        "speaker": "Siz",
        "de": "Ja, das passt. Wie lange haben Sie am Freitag geöffnet?",
        "uz": "Ha, to'g'ri keladi. Juma kuni soat nechagacha ochiqsiz?"
      },
      {
        "speaker": "Mitarbeiter",
        "de": "Bis 18 Uhr. Das kostet 14 Euro.",
        "uz": "Soat 18 gacha. Bu 14 yevro turadi."
      },
      {
        "speaker": "Siz",
        "de": "Prima. Würden Sie mir bitte einen Abholschein geben?",
        "uz": "Zo'r. Iltimos, olib ketish uchun chipta berib yuborasizmi?"
      },
      {
        "speaker": "Mitarbeiter",
        "de": "Hier, bitte. Bis Freitag!",
        "uz": "Mana, marhamat. Jumagacha!"
      }
    ],
    "task_uz": "Rollarda o'qing. Keyin boshqa xizmat uchun (pochtada posilka jo'natish yoki bankda pul o'tkazish) 4–5 ta muloyim iltimos tuzing: Könnten Sie ...? Würden Sie ...? Ich hätte gern ..."
  },
